        db 002h,083h,0ffh,000h,074h,02fh,047h,0e8h,0d4h,005h,083h,0f9h,000h,075h,026h,0beh
        db 020h,002h,046h,08ah,02ch,046h,08bh,014h,0e8h,0d3h,005h,083h,0fbh,0ffh,074h,00fh
        db 0b1h,006h,0d3h,0e3h,08bh,0d3h,0b1h,002h,0ffh,01eh,078h,001h,0e9h,006h,000h,0bah
        db 091h,00ah,0e8h,05eh,004h,0bah,0bdh,00ah,0e8h,058h,004h,0b1h,002h,0bah,0ffh,0ffh
