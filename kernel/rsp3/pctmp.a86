;*****************************************************************************
;
;	PCTMP - PC-MODE terminal message processor; source reconstruction.
;	Concurrent CP/M-86 3.1, project PC-MODE personality.
;
;*****************************************************************************

; Native ASM86 PCTMP. All maintained fixes and extensions are mandatory.
	dseg
	org	0
	include	pcdata.lib
	cseg
	org	0
code_origin:
;******************************************************************************
; PCTMP - PC-MODE terminal message processor, Concurrent CP/M-86 3.1
;
; Reconstructed from Concurrent CP/M-86 3.1 PCTMP, with maintained fixes.
; Build through this module's native ASM86 -> H86 -> GENCMD rules.
; Loader checks, console fixes, shell extensions, help and search are always on.
; pcdata.lib declares the per-console DATA layout.
;
; Residency model:
;   GENCCPM allocates one 0AF0h-byte DATA group per virtual console, followed
;   by one shared CODE group. INIT writes the SYSDAT segment into the RSP link
;   word at DATA:0000. DATA:0004 identifies the console instance.
;   Interrupt handlers use the running PD's console to locate that DATA group.
;   Consequently, resizing DATA requires changing the selection code as well.
;******************************************************************************

; Per-instance DATA fields used by decoded routines.
rsp_sysdat_segment		equ	offset rsp_system_link		; startup link replaced by kernel INIT
rsp_console_instance		equ	offset rsp_console_slot		; zero-based instance set by GENCCPM
service_entry_segment		equ	offset service_pointer_image+2		; segment half of private service far pointer
console_data_bytes		equ	offset instance_data_end

; EXE loader state, in this instance's DATA group. The first 128-byte
; header record is read into exe_header and subsequently reused for fixups.
program_fcb			equ	offset command_fcb_image
fcb_random_record		equ	0021h		; 24-bit CP/M random record number
loader_memory_base		equ	offset allocation_image		; BDOS 55 allocation descriptor, segment
loader_memory_size		equ	offset allocation_image+2		; allocated paragraphs returned by BDOS 55
child_psp_segment		equ	offset child_segments_image+2		; allocation base + 1Bh private paragraphs
child_memory_size		equ	offset child_segments_image+4		; allocation size minus those private paragraphs
exe_header			equ	offset record_buffer_image
exe_relocation_count		equ	exe_header+6
exe_header_paragraphs		equ	exe_header+8
exe_initial_ss			equ	exe_header+0eh
exe_initial_sp			equ	exe_header+10h
exe_initial_ip			equ	exe_header+14h
exe_initial_cs			equ	exe_header+16h
dos_saved_ax			equ	offset dos_result_image		; return AX in private INT 21h frame
child_stack_offset		equ	offset child_entry_image
child_stack_segment		equ	offset child_entry_image+2
child_entry_segment		equ	offset child_entry_image+4
child_entry_offset		equ	offset child_entry_image+6
child_is_com			equ	offset console_state_image+6
exe_records_left		equ	offset exe_transfer_image
exe_dma_segment			equ	offset exe_transfer_image+2
exe_image_paragraphs		equ	offset exe_transfer_image+4

exe_relocation_offset		equ	exe_header+18h
exe_load_segment		equ	offset exe_transfer_image+6
exe_next_record			equ	offset exe_record_image		; low word followed by high byte
exe_relocation_cursor		equ	offset relocation_cursor_image		; byte offset into current header record


command_buffer			equ	offset command_capacity_image
command_length			equ	offset command_count_image
command_text			equ	offset command_text_image
command_buffer_end		equ	offset command_sent_image-1
bios_keyboard_pending		equ	offset keyboard_pending_image
command_sent			equ	offset command_sent_image

; Stable SYSDAT/PD fields. DS must select SYSDAT before using sd_* fields.
sd_supervisor_segment		equ	0040h
sd_system_disk			equ	004bh
sd_running_process		equ	0068h
sd_banner_offset		equ	0078h
pd_console_number		equ	0020h

; Shared CODE variables initialized by PC-MODE startup.


; Saved INT 10h register-frame slots and packet ABI, selected per console.
pd_uda_segment			equ	010h
bios_frame_ax			equ	offset dos_frame_image+16
bios_frame_bx			equ	offset dos_frame_image+14
bios_frame_bh			equ	offset dos_frame_image+15
bios_frame_cx			equ	offset dos_frame_image+12
bios_frame_dx			equ	offset dos_frame_image+8
bios_packet_ax			equ	offset bios_register_packet_image
bios_packet_bx			equ	offset bios_register_packet_image+2
bios_packet_cx			equ	offset bios_register_packet_image+4
bios_packet_dx			equ	offset bios_register_packet_image+6
bios_packet_console		equ	offset bios_console_image

dos_output_column		equ	offset console_state_image+1
dos_output_suppressed		equ	offset console_state_image+2
dos_printer_echo		equ	offset console_state_image+3
dos_line_origin			equ	offset console_state_image+4
dos_scan_pending		equ	offset console_state_image

dos_console_number		equ	offset runtime_flags_image+2
dos_list_number			equ	offset runtime_flags_image+3

service_caller_ds		equ	offset service_ds_image
service_memory_paragraphs	equ	offset memory_setting_image
service_flags			equ	offset private_service_flags_image

dos_dta_offset			equ	offset dos_dma_image
dos_dta_segment			equ	offset dos_dma_image+2
dos_saved_es			equ	offset dos_frame_image+4

dos_vectors_active		equ	offset runtime_flags_image
dos_file_slots			equ	offset private_fcb_slots_image


critical_context		equ	offset critical_stacks_image+8

; Decoded interrupt-frame and direct-BIOS packet fields.
dos_entry_ax			equ	offset dos_frame_image
dos_caller_ds			equ	offset dos_frame_image+10
dos_nested_console		equ	offset dos_nested_image
dos_nested_stack		equ	offset critical_stacks_image+6
printer_bios_function		equ	offset printer_state_image+2
printer_bios_character		equ	offset printer_state_image+3
printer_bios_device		equ	offset printer_state_image+5
dos_saved_function		equ	offset dos_frame_image+17
raw_disk_operation		equ	offset raw_disk_packet_image
raw_disk_drive			equ	offset raw_disk_packet_image+1
raw_disk_count			equ	offset raw_disk_packet_image+2
raw_disk_head			equ	offset raw_disk_packet_image+3
raw_disk_sector			equ	offset raw_disk_packet_image+4
raw_disk_cylinder		equ	offset raw_disk_packet_image+5
raw_disk_buffer			equ	offset raw_disk_packet_image+6
raw_disk_segment		equ	offset raw_disk_packet_image+8


saved_command_text		equ	offset saved_command_image
command_tail_pointer		equ	offset command_tail_image
service_entry			equ	offset service_pointer_image

original_search_explicit	equ	offset search_explicit_image
original_search_drive_number	equ	offset search_explicit_image+2
original_search_types_left	equ	offset search_count_image
original_search_user_zero	equ	offset load_user_zero_image

dos_extended_fcb		equ	offset fcb_attribute_image
dos_fcb_attribute		equ	offset fcb_attribute_image+1
dos_fcb_offset			equ	offset application_fcb_image
dos_fcb_segment			equ	offset application_fcb_image+2
dos_fcb_slot			equ	offset slot_pointer_image

critical_private_ss		equ	offset critical_stacks_image+4
critical_child_ss		equ	offset critical_stacks_image
critical_child_sp		equ	offset critical_stacks_image+2

native_clock_pointer		equ	offset clock_pointer_image
native_dma_offset		equ	offset native_dma_image
native_dma_segment		equ	offset native_dma_image+2
dos_current_drive		equ	offset drive_state_image
dos_working_drive		equ	offset drive_state_image+1
dos_device_id			equ	offset console_state_image+5

cached_fcb_slot			equ	offset cache_fcb_image
record_cache_dirty		equ	offset cache_user_dirty_image+1
record_cache_valid		equ	offset cache_result_image
directory_timestamp_mode	equ	offset runtime_flags_image+1

record_cache_result		equ	offset cache_result_image+1
record_cache_user		equ	offset cache_user_dirty_image
record_cache_number		equ	offset cache_record_image
record_cache_buffer		equ	offset cache_pointer_image

loader_user_zero		equ	offset load_flags_image
loader_compatibility_flags	equ	offset load_flags_image+1
loader_saved_user		equ	offset load_flags_image+2
loader_command_text		equ	offset launch_command_pointer_image

directory_dos_attributes	equ	offset fcb_attribute_image+2

dos_saved_si			equ	offset dos_frame_image+6
dos_saved_di			equ	offset dos_frame_image+2
parse_status			equ	offset parse_flags_image
parse_drive_present		equ	offset parse_flags_image+1
parse_name_present		equ	offset parse_flags_image+2
parse_type_present		equ	offset parse_flags_image+3

transfer_advance_random		equ	offset transfer_advance_image
transfer_requested_records	equ	offset transfer_records_image
transfer_buffer_offset		equ	offset transfer_dma_image
transfer_whole_records		equ	offset transfer_span_image
transfer_record_span		equ	offset transfer_span_image+2
transfer_first_byte		equ	offset transfer_boundaries_image
transfer_first_record		equ	offset transfer_boundaries_image+4
transfer_last_byte		equ	offset transfer_boundaries_image+8
transfer_start_offset		equ	offset transfer_size_image+2
transfer_start_high		equ	offset transfer_size_image+4
transfer_has_partial		equ	offset drive_state_image+2
transfer_bytes_done		equ	offset transfer_done_image
console_record_position		equ	offset console_record_cursor_image
console_record_pending		equ	offset console_record_flag_image
console_record_length		equ	offset console_record_count_image



; Private buffer and pointer offsets derived from pcdata.lib.
batch_prefix_offset		equ	offset batch_prefix_image
batch_prefix_offset_4		equ	offset batch_prefix_image+4
command_text_offset_1		equ	offset command_text_image+1
parser_packet_offset		equ	offset parser_packet_image
load_packet_offset		equ	offset load_packet_image
load_packet_offset_2		equ	offset load_packet_image+2
load_packet_offset_4		equ	offset load_packet_image+4
load_packet_offset_6		equ	offset load_packet_image+6
queue_prefix_offset		equ	offset queue_prefix_image
command_fcb_offset_1		equ	offset command_fcb_image+1
command_fcb_offset_9		equ	offset command_fcb_image+9
command_fcb_offset_10		equ	offset command_fcb_image+10
command_fcb_offset_11		equ	offset command_fcb_image+11
command_fcb_offset_16		equ	offset command_fcb_image+16
batch_pending_offset		equ	offset batch_pending_image
shell_delimiter_pointer		equ	offset shell_delimiter_pointer_image
shell_scan_limits_offset	equ	offset shell_scan_limits_image
shell_delimiter_offset		equ	offset shell_delimiter_image
search_packet_direction		equ	offset search_packet_direction_image
shell_extensions_offset		equ	offset shell_extensions_image
shell_extensions_offset_2	equ	offset shell_extensions_image+2
shell_extensions_offset_3	equ	offset shell_extensions_image+3
shell_extensions_offset_6	equ	offset shell_extensions_image+6
shell_extensions_offset_9	equ	offset shell_extensions_image+9
dos_launch_pending_offset	equ	offset dos_launch_pending_image
decimal_started_offset		equ	offset decimal_started_image
dos_delimiters_offset		equ	offset dos_delimiters_image
parse_fcb_offset		equ	offset parse_fcb_image
parse_fcb_offset_1		equ	offset parse_fcb_image+1
parse_fcb_offset_9		equ	offset parse_fcb_image+9
transfer_boundaries_offset_2	equ	offset transfer_boundaries_image+2
transfer_boundaries_offset_6	equ	offset transfer_boundaries_image+6
transfer_boundaries_offset_10	equ	offset transfer_boundaries_image+10
transfer_boundaries_offset_12	equ	offset transfer_boundaries_image+12
transfer_size_offset		equ	offset transfer_size_image
transfer_size_offset_6		equ	offset transfer_size_image+6
transfer_size_offset_8		equ	offset transfer_size_image+8
transfer_overflow_offset	equ	offset transfer_overflow_image
cache_record_offset_1		equ	offset cache_record_image+1
cache_record_offset_2		equ	offset cache_record_image+2
transfer_dma_offset_2		equ	offset transfer_dma_image+2
child_segments_offset		equ	offset child_segments_image
child_segments_offset_6		equ	offset child_segments_image+6
dos_frame_offset_13		equ	offset dos_frame_image+13
record_buffer_offset_4		equ	offset record_buffer_image+4
record_buffer_offset_8		equ	offset record_buffer_image+8
record_buffer_offset_10		equ	offset record_buffer_image+10
cache_pointer_offset_2		equ	offset cache_pointer_image+2
default_fcb_pointer_offset_2	equ	offset default_fcb_pointer_image+2
slot_pointer_offset_2		equ	offset slot_pointer_image+2
clock_pointer_offset_2		equ	offset clock_pointer_image+2
month_days_offset		equ	offset month_days_image
month_days_offset_1		equ	offset month_days_image+1
month_starts_offset		equ	offset month_starts_image
console_record_capacity_offset	equ	offset console_record_capacity_image
console_record_text_offset	equ	offset console_record_text_image
launch_command_count_offset	equ	offset launch_command_count_image
directory_state_offset		equ	offset directory_state_image
active_vectors_offset		equ	offset active_vectors_image
original_vectors_offset		equ	offset original_vectors_image
attach_packet_offset		equ	offset attach_packet_image
private_service_word_offset	equ	offset private_service_word_image
metadata_fcb_offset		equ	offset metadata_fcb_image
metadata_fcb_offset_1		equ	offset metadata_fcb_image+1
metadata_fcb_offset_32		equ	offset metadata_fcb_image+32
invalid_dos_message_offset	equ	offset invalid_dos_message_image
printer_busy_message_offset	equ	offset printer_busy_message_image
private_extensions_offset	equ	offset private_extensions_image

; Hardware interrupt vector locations in segment zero.
ivt_bdos_offset			equ	0e0h*4
ivt_bdos_segment		equ	ivt_bdos_offset+2

; Native XIOS header and packed PC-MODE operation selectors.
xios_service_entry		equ	0c03h
xios_console_table		equ	0c14h
xios_list_table			equ	0c16h
xios_disk_table			equ	0c18h
xios_pixel_write		equ	0c1fh
fcb_slot_bytes			equ	40
fcb_slot_count			equ	(offset data_padding_image-offset private_fcb_slots_image)/fcb_slot_bytes
fcb_slots_end			equ	offset data_padding_image

; Two public entry jumps precede the vendor/version identification bytes.
	jmp	process_start
private_service_entry:
	jmp	pcmode_service
; Decoded original region 0006h..0043h.

original_identification:
	db	'COPYRIGHT(C)1983,84,DIGITAL RESEARCH(05/17/84)2004-0000-654321'


;------------------------------------------------------------------------------
; process_start (0044h)
; Entry: CS=shared CODE, DS=this console's DATA, stack supplied by GENCCPM.
; Select this instance's console, the configured system disk and user zero.
; Attach the console before printing the supervisor's generated OS label.
; DS is restored after each access to another segment.
;------------------------------------------------------------------------------
process_start:
	mov	word ptr .service_entry_segment,cs
	mov	dl,byte ptr .rsp_console_instance
	call	console_set
	push	ds
	mov	ds,word ptr .rsp_sysdat_segment
	mov	dl,byte ptr .sd_system_disk
	pop	ds
	call	current_disk_set
	db	032h,0d2h				; xor dl,dl: original register/register encoding
	call	current_user_set
	call	console_attach
	push	ds
	mov	ds,word ptr .rsp_sysdat_segment
	mov	dx,word ptr .sd_banner_offset
	mov	ds,word ptr .sd_supervisor_segment
	call	print_data_string
	pop	ds
	call	initialize_pc_mode

; Original region 0078h..0690h: startup file processing, prompt/command parser,
; built-in commands and external command pre-search.
; The following routines implement command parsing and dispatch.
; Decoded original region 0078h..0170h.

; Detach while trying the per-console startup file. Its FCB extension comes
; from the resident process name. Read one record, require a CR, then echo it.
startup_file:
	call	console_detach
	push	ds
	pop	es
	mov	si,01dh
	mov	di,program_fcb+9
	mov	cx,3
	rep	movsb
	mov	dx,program_fcb
	mov	cl,15
	call	ccpm_call
	cmp	al,0ffh
	je	command_prompt_resume
	mov	dx,command_text
	mov	cl,26
	call	ccpm_call
	mov	dx,program_fcb
	mov	cl,20
	call	ccpm_call
	push	ax
	mov	dx,program_fcb
	mov	cl,16
	call	ccpm_call
	pop	ax
	test	al,al
	jnz	command_prompt_resume
	mov	ax,ds
	mov	es,ax
	mov	al,13
	mov	cx,128
	mov	di,command_text
	repne	scasb
	jne	command_prompt_resume
	inc	di
	mov	byte ptr [di],'$'
	sub	di,command_text
	db	08bh,0c7h				; mov ax,di, original direction encoding
	sub	ax,2
	mov	byte ptr .command_length,al
	mov	dx,offset original_startup_message	; startup announcement, CODE string
	call	print_code_string
	mov	dx,command_text
	call	print_data_string
	jmps	command_line_ready
; Common prompt cleanup: release memory, attach console, reset PC-MODE state.
command_prompt_resume:
	mov	dx,0ffffh
	call	free_all_memory
	call	console_attach
	mov	cl,0
	callf	dword ptr .service_entry
	cmp	byte ptr .dos_launch_pending_offset,0ffh			; DOS-launch flag, cleared when returning to the prompt
	jne	command_prompt_spacing
	mov	byte ptr .dos_launch_pending_offset,0
command_prompt_spacing:
	cmp	byte ptr .command_sent,0
	je	command_prompt_user
	mov	byte ptr .command_sent,0
	call	print_code_newline
command_prompt_user:
	mov	dl,13
	call	print_console_character
	call	current_user_get
	mov	byte ptr .023h,bl			; resident process current user
	test	bl,bl
	jz	command_prompt_drive
	mov	dl,bl
	call	print_small_decimal
command_prompt_drive:
	call	current_disk_get
	mov	byte ptr .022h,bl			; resident process current drive
	mov	dl,'A'
	add	dl,bl
	call	print_console_character
	mov	dx,offset original_msg_prompt		; prompt delimiter, CODE string
	call	print_code_string
	call	read_command_line
command_line_ready:
	mov	dl,10
	call	print_console_character
command_normalize:
	lea	bx,.command_text
	cmp	byte ptr .command_length,0
	je	command_line_empty
	db	08bh,0fbh				; mov di,bx, original direction encoding
	dec	di
	call	skip_command_separators
	db	08bh,0dfh				; mov bx,di, original direction encoding
	cmp	byte ptr [bx],0
	je	command_line_empty
	lea	ax,.command_text
	db	03bh,0c3h				; cmp ax,bx, original direction encoding
	je	command_line_comment
	push	ds
	pop	es
	xor	ch,ch
	mov	cl,byte ptr .command_length
	db	08bh,0f8h				; mov di,ax, original direction encoding
	db	08bh,0f3h				; mov si,bx, original direction encoding
	cld
	rep	movsb
	db	08bh,0d8h				; mov bx,ax, original direction encoding
command_line_comment:
	cmp	byte ptr [bx],';'
	je	command_line_empty

; Intercept compact/spaced drive commands before the recovered direct select.
	jmp	shell_drive_command
	nop
	nop
	nop
	nop
; Decoded original region 0178h..01A7h.

; Historical bare-drive selection, retained behind the supported drive hook.
; Validate A..P, then change the default drive and return to the prompt.
original_drive_command:
	cmp	byte ptr 1[bx],':'
	jne	command_parse_entry
	mov	dl,[bx]
	and	dl,05fh
	sub	dl,'A'
	cmp	dl,0
	jc	original_drive_invalid
	cmp	dl,15
	ja	original_drive_invalid
	call	current_disk_set
	jmp	command_line_empty
original_drive_invalid:
	mov	dx,offset original_msg_error_prefix	; original command-error prefix
	call	print_code_string
	mov	dx,offset original_msg_drive_error	; original invalid-drive message
	call	print_code_string
	call	print_code_newline
command_line_empty:
	jmp	command_prompt_resume

command_parse_entry:
; Help must intercept '?' before BDOS 152 interprets it as a wildcard.
	jmp	shell_help_command
; Decoded original region 01ABh..0207h.


; Terminate and preserve the command text, then parse its FCB through BDOS 152.
; Explicit drives bypass built-ins. Keep parser tail pointer for built-in operands.
command_parse_tail:
	mov	al,.command_length
	mov	ah,00h
	db	003h,0d8h				; add bx,ax (original encoding)
	mov	byte ptr [bx],00h
	mov	cx,040h
	mov	si,command_text
	mov	di,saved_command_text
	push	ds
	pop	es
	rep	movsw
	mov	si,program_fcb
	mov	di,saved_command_text
	call	parse_command_filename
	jcxz	command_parse_ok
	db	02bh,0dbh				; sub bx,bx (original encoding)
	mov	bl,.command_length
	add	bx,saved_command_text
	mov	byte ptr [bx],024h
	jmp	command_error_entry
command_parse_ok:
	mov	.command_tail_pointer,bx
	cmp	bx,00h
	jnz	command_mark_end
	mov	bl,.command_length
	add	bx,saved_command_text
command_mark_end:
	mov	byte ptr [bx],024h
	inc	bx
	cmp	byte ptr .program_fcb,00h
	jz	command_builtin_entry
	jmp	external_command_entry

; Compare nine FCB bytes with a CS command name; return comparison flags.
match_original_builtin:
	mov	si,program_fcb
	inc	si
	push	cs
	pop	es
	mov	cx,09h
	repe	cmpsb
	ret
; The original unqualified-built-in dispatch starts with MOV DI,0BA0h.
; Qualified commands already bypass this point.
command_builtin_entry:
	jmp	shell_extensions
; Decoded original region 020Bh..04C0h.


; USER: parse 0..15, set the native user, then display the effective user.
original_user_dispatch:
	call	match_original_builtin
	jnz	original_memory_dispatch
	mov	si,program_fcb
	mov	di,.command_tail_pointer
	cmp	di,00h
	jz	user_show
	inc	di
	call	parse_command_filename
	cmp	cx,00h
	jnz	user_show
	mov	si,program_fcb
	inc	si
	mov	dx,[si]
	mov	ch,030h
	call	parse_three_digits
	cmp	bl,0fh
	ja	user_invalid
	mov	dl,bl
	call	current_user_set
	jmp	user_show
user_invalid:
	mov	dx,offset original_msg_user_invalid
	call	print_code_string
user_show:
	mov	dx,offset original_msg_user_value
	call	print_code_string
	call	current_user_get
	mov	dl,bl
	call	print_small_decimal
	;call	print_code_newline
	;mov	dx,offset original_msg_user_note
	;call	print_code_string
	jmp	command_prompt_resume

; MEM: parse decimal KiB, convert to paragraphs and use private service 2.
; A query passes DX=FFFFh, then formats the returned paragraph count in KiB.
original_memory_dispatch:
	mov	di,offset original_name_memory
	call	match_original_builtin
	jnz	original_ndp_dispatch
	mov	si,program_fcb
	mov	di,.command_tail_pointer
	cmp	di,00h
	jz	memory_show
	inc	di
	call	parse_command_filename
	cmp	cx,00h
	jnz	memory_show
	mov	si,program_fcb
	inc	si
	mov	ch,[si]
	inc	si
	mov	dx,[si]
	call	parse_three_digits
	cmp	bx,0ffffh
	jz	memory_invalid
	mov	cl,06h
	shl	bx,cl
	db	08bh,0d3h				; mov dx,bx (original encoding)
	mov	cl,02h
	callf	dword ptr .service_entry
	jmp	memory_show
memory_invalid:
	mov	dx,offset original_msg_memory_invalid
	call	print_code_string
memory_show:
	mov	dx,offset original_msg_memory_value
	call	print_code_string
	mov	cl,02h
	mov	dx,0ffffh
	callf	dword ptr .service_entry
	mov	cl,06h
	shr	ax,cl
	call	print_unsigned_decimal
	mov	dl,04bh
	call	print_console_character
	call	print_code_newline
	jmp	command_prompt_resume

; 8087: private service 3 queries/sets coprocessor state; ON requires hardware.
original_ndp_dispatch:
	mov	di,offset original_name_ndp
	call	match_original_builtin
	jz	ndp_argument
	jmp	original_del_dispatch
ndp_argument:
	mov	si,program_fcb
	mov	di,.command_tail_pointer
	cmp	di,00h
	jz	ndp_show
	call	skip_command_separators
	call	parse_command_filename
	cmp	cx,00h
	jnz	ndp_show
	mov	si,command_fcb_offset_1
	mov	di,offset original_off
	mov	cx,02h
	call	compare_code_words
	jnz	ndp_try_on
	mov	cl,03h
	xor	dl,dl
	callf	dword ptr .service_entry
	jmps	ndp_show
ndp_try_on:
	mov	si,program_fcb
	inc	si
	mov	di,offset original_on
	mov	cx,02h
	call	compare_code_words
	jnz	ndp_invalid
	push	es
	mov	es,word ptr .rsp_sysdat_segment
	mov	bx,08ch
	db	026h					; ES override; original addressing
	cmp	word ptr [bx],0ffffh
	pop	es
	jnz	ndp_enable
	mov	dx,offset original_msg_ndp_absent
	call	print_code_string
	jmps	ndp_show
ndp_enable:
	mov	cl,03h
	mov	dl,01h
	callf	dword ptr .service_entry
	jmps	ndp_show
ndp_invalid:
	mov	dx,offset original_msg_ndp_invalid
	call	print_code_string
ndp_show:
	mov	dx,offset original_msg_ndp_value
	call	print_code_string
	mov	cl,03h
	mov	dl,0ffh
	callf	dword ptr .service_entry
	or	al,al
	jz	ndp_show_off
	call	print_on
	jmps	ndp_show_done
ndp_show_off:
	call	print_off
ndp_show_done:
	call	print_code_newline
	jmp	command_prompt_resume

; DEL rewrites the command to ERASE.EXE and reparses it.
original_del_dispatch:
	mov	di,offset original_name_del
	call	match_original_builtin
	jnz	original_rename_dispatch
	cmp	byte ptr .command_length,121
	ja	command_expansion_error
	push	es
	push	ds
	push	ds
	pop	es
	xor	cx,cx
	mov	cl,.command_length
	mov	si,offset command_text
	add	si,cx
	mov	di,si
	add	di,6
	sub	cx,3
	inc	cx
	std
	rep	movsb
	add	byte ptr .command_length,6
	cld
	push	cs
	pop	ds
	mov	si,offset original_erase_command
	mov	di,command_text
	mov	cx,0ah
	rep	movsb
	pop	ds
	pop	es
	jmp	command_normalize

command_expansion_error:
	mov	cx,62
	jmp	shell_command_error

; RENAME inserts .EXE into the command and reparses it.
original_rename_dispatch:
	mov	di,offset original_name_rename
	call	match_original_builtin
	jnz	original_rem_dispatch
	cmp	byte ptr .command_length,126
	ja	command_expansion_error
	push	es
	push	ds
	push	ds
	pop	es
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	al,.command_length
	inc	byte ptr .command_length
	mov	si,command_text
	db	003h,0f0h				; add si,ax (original encoding)
	db	08bh,0feh				; mov di,si (original encoding)
	inc	di
	db	08bh,0c8h				; mov cx,ax (original encoding)
	sub	cx,05h
	std
	rep	movsb
	cld
	mov	word ptr [si],04558h
	dec	si
	dec	si
	mov	word ptr [si],0452eh
	pop	ds
	pop	es
	jmp	command_normalize

; REM and SYS return directly to the prompt in this recovered shell.
original_rem_dispatch:
	mov	di,offset original_name_rem
	call	match_original_builtin
	jnz	original_sys_dispatch
	jmp	command_prompt_resume
original_sys_dispatch:
	mov	di,offset original_name_sys
	call	match_original_builtin
	jnz	original_pause_dispatch
	jmp	command_prompt_resume

; PAUSE displays a prompt and reads a character using direct console DL=FDh.
original_pause_dispatch:
	mov	di,offset original_name_pause
	call	match_original_builtin
	jnz	original_suspend_dispatch
	mov	dx,offset original_msg_pause
	call	print_code_string
	call	console_poll
	call	print_code_newline
	jmp	command_prompt_resume

; SUSPEND: parse ON/OFF and query/update private service 4.
original_suspend_dispatch:
	mov	di,offset original_name_suspend
	call	match_original_builtin
	jnz	original_printer_dispatch
	mov	si,program_fcb
	mov	di,.command_tail_pointer
	cmp	di,00h
	jz	suspend_show
	call	skip_command_separators
	call	parse_command_filename
	cmp	cx,00h
	jnz	suspend_show
	mov	si,command_fcb_offset_1
	mov	di,offset original_off
	mov	cx,02h
	call	compare_code_words
	jnz	suspend_try_on
	mov	cl,04h
	xor	dl,dl
	callf	dword ptr .service_entry
	jmps	suspend_show
suspend_try_on:
	mov	si,program_fcb
	inc	si
	mov	di,offset original_on
	mov	cx,02h
	call	compare_code_words
	jnz	suspend_invalid
	mov	cl,04h
	mov	dl,01h
	callf	dword ptr .service_entry
	jmps	suspend_show
suspend_invalid:
	mov	dx,offset original_msg_suspend_invalid
	call	print_code_string
suspend_show:
	mov	dx,offset original_msg_suspend_value
	call	print_code_string
	mov	cl,04h
	mov	dl,0ffh
	callf	dword ptr .service_entry
	or	al,al
	jz	suspend_show_off
	call	print_on
	jmps	suspend_show_done
suspend_show_off:
	call	print_off
suspend_show_done:
	call	print_code_newline
	jmp	command_prompt_resume

; PRINTER: parse a decimal device number; BDOS 160 sets it, 164 queries it.
original_printer_dispatch:
	mov	di,offset original_name_printer
	call	match_original_builtin
	jnz	external_command_entry
	mov	si,program_fcb
	mov	di,.command_tail_pointer
	cmp	di,00h
	jz	printer_number_show
	inc	di
	call	parse_command_filename
	cmp	cx,00h
	jnz	printer_number_show
	mov	si,program_fcb
	inc	si
	mov	dx,[si]
	mov	ch,030h
	call	parse_three_digits
	cmp	bl,0ffh
	jz	printer_number_invalid
	mov	dl,bl
	call	list_device_set
	jcxz	printer_number_show
printer_number_invalid:
	mov	dx,offset original_msg_printer_invalid
	call	print_code_string
printer_number_show:
	mov	dx,offset original_msg_printer_value
	call	print_code_string
	call	list_device_get
	mov	dl,bl
	call	print_small_decimal
	call	print_code_newline
	jmp	command_prompt_resume

; Small shared ON/OFF display helpers.
print_on:
	mov	dl,04fh
	call	print_console_character
	mov	dl,04eh
	call	print_console_character
	ret
print_off:
	mov	dl,04fh
	call	print_console_character
	mov	dl,046h
	call	print_console_character
	mov	dl,046h
	call	print_console_character
	ret
external_command_entry:
; Route external commands through the configured search order.
	jmp	search_command
	nop
	nop
	nop
	nop
; Decoded historical search and dispatch, 04C8h..0690h.


; Historical external search, bypassed by the supported SETDEF-aware search.
; Explicit drives suppress fallback; otherwise try the system disk and user 0.
; BDOS 45 temporarily selects return-on-error mode during file probes.
original_search_start:
	mov	byte ptr .original_search_explicit,0ffh
	cmp	byte ptr .program_fcb,00h
	jnz	original_search_drive
	mov	byte ptr .original_search_explicit,00h
original_search_drive:
	call	current_disk_get
	inc	al
	mov	.original_search_drive_number,al
	call	original_check_extension
	or	al,al
	jnz	original_search_open
	cmp	byte ptr .original_search_explicit,0ffh
	jz	original_search_settings
	mov	cl,087h
	mov	dx,queue_prefix_offset
	call	ccpm_call
	inc	al
	jz	original_search_settings
	mov	byte ptr .original_search_explicit,0ffh
	jmp	prepare_cli_command

; Fetch the twelve-byte private search settings, then try CMD/COM/EXE/BAT.
original_search_settings:
	mov	cl,06h
	mov	dx,search_packet_direction
	callf	dword ptr .service_entry
	mov	byte ptr .original_search_types_left,04h
	mov	cl,02dh
	mov	dl,0feh
	call	ccpm_call
	mov	byte ptr .original_search_user_zero,00h
original_search_next:
	call	original_next_extension
original_search_open:
	mov	dx,program_fcb
	call	open_command_file
	inc	al
	jz	original_search_failed
	jmp	original_search_found
original_search_failed:
	or	ah,ah
	jnz	original_search_error
	cmp	byte ptr .original_search_explicit,0ffh
	jz	original_search_retry

; No explicit drive: probe the system disk from SYSDAT +4Bh.
	push	es
	mov	es,word ptr .rsp_sysdat_segment
	mov	al,es:.04bh
	pop	es
	inc	al
	mov	.program_fcb,al
	mov	dx,program_fcb
	call	open_command_file
	inc	al
	jz	original_search_restore_drive

; Require SYS attribute (extension byte 2, bit 7) for system-disk fallback.
; If absent, close and retry user 0; restore the caller user on every path.
	mov	al,.command_fcb_offset_10
	test	al,080h
	jnz	original_search_selected
	mov	dx,program_fcb
	call	close_command_file
	call	current_user_get
	push	ax
	mov	dl,00h
	call	current_user_set
	mov	dx,program_fcb
	call	open_command_file
	inc	al
	jz	original_search_restore_user
	test	byte ptr .command_fcb_offset_10,080h
	jz	original_search_close_user_zero

; Remember user-zero origin for the subsequent loader.
	pop	dx
	call	current_user_set
	mov	byte ptr .original_search_user_zero,0ffh
	jmps	original_search_selected
original_search_close_user_zero:
	mov	dx,program_fcb
	call	close_command_file
original_search_restore_user:
	pop	dx
	push	ax
	call	current_user_set
	pop	ax
	jmp	original_search_restore_drive
original_search_selected:
	mov	al,.program_fcb
	mov	.original_search_drive_number,al
	jmps	original_search_found
original_search_restore_drive:
	mov	byte ptr .program_fcb,00h
original_search_retry:
	or	ah,ah
	jnz	original_search_error
	dec	byte ptr .original_search_types_left
	jz	original_search_error
	jmp	original_search_next
original_search_error:
	mov	cl,02dh
	xor	dl,dl
	call	ccpm_call
	mov	byte ptr .original_search_explicit,0ffh
	mov	cx,01eh
	jmp	command_error_entry

; Restore normal error mode and route CMD to native CLI, BAT through BATCH.
original_search_found:
	mov	cl,02dh
	xor	dl,dl
	call	ccpm_call
original_dispatch_type:
	mov	bx,command_fcb_offset_11
	mov	al,[bx]
	and	al,07fh
	cmp	al,044h
	jnz	original_search_not_cmd
	mov	byte ptr .original_search_explicit,0ffh
	jmp	prepare_cli_command
original_search_not_cmd:
	mov	bx,command_fcb_offset_9
	mov	al,[bx]
	and	al,07fh
	cmp	al,042h
	jnz	original_search_dos
	jmp	prepare_chain_command

; Build the private load packet: far FCB, far command tail and option byte.
; Submit service 1; report nonzero BX as a command error.
original_search_dos:
	mov	byte ptr .command_length,00h
	mov	dx,command_length
	mov	byte ptr .command_sent,0ffh
	mov	byte ptr .dos_launch_pending_offset,0ffh
	mov	byte ptr .batch_pending_offset,00h
	mov	word ptr .load_packet_offset,0220h
	mov	word ptr .load_packet_offset_2,ds
	mov	.load_packet_offset_4,dx
	mov	word ptr .load_packet_offset_6,ds
	mov	dx,load_packet_offset
	mov	cl,01h
	callf	dword ptr .service_entry
	cmp	bx,00h
	jz	original_search_done
	jmp	command_error_entry
original_search_done:
	jmp	command_prompt_resume

; Validate an explicit extension against the four three-byte settings.
; Blank returns AL=0. A match returns its first character; invalid discards
; the return address and branches to command error 60.
original_check_extension:
	mov	bx,command_fcb_offset_9
	cmp	byte ptr [bx],020h
	jnz	original_extension_present
	mov	al,00h
	ret
original_extension_present:
	mov	cx,04h
	add	bx,02h
	mov	si,shell_extensions_offset_2
original_extension_scan:
	mov	al,[bx]
	cmp	al,[si]
	jz	original_extension_suffix
	add	si,03h
	loop	original_extension_scan
	jmp	original_extension_invalid
original_extension_suffix:
	dec	si
	dec	bx
	mov	al,[bx]
	cmp	al,[si]
	jnz	original_extension_invalid
	dec	si
	dec	bx
	mov	al,[bx]
	cmp	al,[si]
	jnz	original_extension_invalid
	ret
original_extension_invalid:
	pop	ax
	mov	byte ptr .original_search_explicit,0ffh
	mov	cx,03ch
	jmp	command_error_entry

; Copy the next historical extension into the FCB; remaining count selects it.
original_next_extension:
	mov	di,command_fcb_offset_9
	cmp	byte ptr .original_search_types_left,04h
	jnz	original_extension_not_cmd
	mov	si,shell_extensions_offset
	jmps	original_extension_copy
original_extension_not_cmd:
	cmp	byte ptr .original_search_types_left,03h
	jnz	original_extension_not_com
	mov	si,shell_extensions_offset_3
	jmps	original_extension_copy
original_extension_not_com:
	cmp	byte ptr .original_search_types_left,02h
	jnz	original_extension_bat
	mov	si,shell_extensions_offset_6
	jmps	original_extension_copy
original_extension_bat:
	mov	si,shell_extensions_offset_9
original_extension_copy:
	mov	cl,03h
	rep	movsb
	ret

;------------------------------------------------------------------------------
; read_command_line (0691h), called by the prompt loop at 0133h.
; DS selects this PCTMP instance. BDOS 10 supplies the kernel line editor,
; including editing/recall extensions in our source-built chario.cio.
; The buffer has maximum length at 0181h, returned length at 0182h and text
; at 0183h. Clear the unused tail through 0206h for subsequent parsing.
; ES remains equal to DS. No separate PCTMP keystroke editor is used here.
; DATA:02C7h is also tested by the CLI error path; its broader role is pending.
;------------------------------------------------------------------------------
read_command_line:
	push	ds
	pop	es
	mov	byte ptr .batch_pending_offset,0
	mov	byte ptr .command_buffer,80h
	mov	cl,10
	mov	dx,command_buffer
	call	ccpm_call
	db	032h,0ffh				; xor bh,bh, original encoding
	mov	bl,byte ptr .command_length
	add	bx,command_text
	db	08bh,0fbh				; mov di,bx, original encoding
	mov	cx,command_buffer_end
	db	02bh,0cbh				; sub cx,bx, original encoding
	db	032h,0c0h				; xor al,al, original encoding
	rep	stosb
	ret

; Decoded 06BBh..07B3h: native file/console helpers and CLI preparation.

; Set DMA offset and segment to DS:DX through BDOS 26/51; preserve DX.
set_command_dma:
	mov	cl,01ah
	push	dx
	call	ccpm_call
	mov	cl,033h
	mov	dx,ds
	call	ccpm_call
	pop	dx
	ret

; Close DS:DX FCB through BDOS 16, preserving BX.
close_command_file:
	push	bx
	mov	cl,010h
	call	ccpm_call
	pop	bx
	ret

; Set the FCB filename F6 flag (bit 7 at +6), then open; preserve BX.
open_command_file:
	push	bx
	db	08bh,0dah				; mov bx,dx (original encoding)
	add	bx,06h
	or	byte ptr [bx],080h
	mov	cl,0fh
	call	ccpm_call
	pop	bx
	ret

; Scan ES:DI (DATA:02D3h) for AL, bounded by DATA:02D8h; preserve BX/CX/DI.
scan_command_character:
	push	di
	push	cx
	push	bx
	mov	ch,00h
	mov	cl,.shell_scan_limits_offset
	db	08bh,0d9h				; mov bx,cx (original encoding)
	mov	di,.shell_delimiter_pointer
	repne	scasb
	pop	bx
	pop	cx
	pop	di
	ret

; Compare DS:[BX] against the parser delimiter byte at DATA:02E0h.
compare_command_delimiter:
	mov	al,[bx]
	cmp	al,.shell_delimiter_offset
	ret

; Print CS:DX dollar-terminated text through the DS-string wrapper; preserve DS.
print_code_string:
	push	ds
	mov	ax,cs
	mov	ds,ax
	call	print_data_string
	pop	ds
	ret

; Print DL through native BDOS 2.
print_console_character:
	mov	cl,02h
	jmp	ccpm_call

; Divide DX:AX by decimal place CX; suppress leading zeroes using DATA:02EFh.
; Return remainder in AX, DX=0. Used only by print_unsigned_decimal.
print_decimal_place:
	div	cx
	push	dx
	cmp	byte ptr .decimal_started_offset,0ffh
	jz	print_nonzero_place
	db	00bh,0c0h				; or ax,ax (original encoding)
	jz	decimal_place_remainder
print_nonzero_place:
	mov	byte ptr .decimal_started_offset,0ffh
	mov	dl,al
	add	dl,030h
	call	print_console_character
decimal_place_remainder:
	pop	ax
	db	033h,0d2h				; xor dx,dx (original encoding)
	ret

; Print unsigned AX (0..65535), including zero, using 10000/1000/100/10 divisors.
; Modifies AX/CX/DX and DATA:02EFh.
print_unsigned_decimal:
	mov	byte ptr .decimal_started_offset,00h
	db	033h,0d2h				; xor dx,dx (original encoding)
	mov	cx,02710h
	call	print_decimal_place
	mov	cx,03e8h
	call	print_decimal_place
	mov	cx,064h
	call	print_decimal_place
	mov	cx,0ah
	call	print_decimal_place
	mov	dl,al
	add	dl,030h
	call	print_console_character
	ret

; Print DS:DX dollar-terminated text through native BDOS 9.
print_data_string:
	mov	cl,09h
	jmp	ccpm_call

; Prepare CH command prefix; when needed shift text back two bytes and add drive.
; Uses the existing per-console command buffer and CLI control block.
prepare_chain_command:
	mov	byte ptr .batch_prefix_offset_4,043h
	mov	byte ptr .command_buffer,048h
	mov	byte ptr .command_length,020h
	cmp	byte ptr .original_search_explicit,00h
	jnz	chain_command_ready
	push	ds
	pop	es
	mov	cx,084h
	mov	di,command_buffer_end
	db	08bh,0f7h				; mov si,di (original encoding)
	dec	si
	dec	si
	std
	rep	movsb
	cld
	mov	al,.original_search_drive_number
	add	al,040h
	mov	.command_text,al
	mov	byte ptr .command_text_offset_1,03ah
chain_command_ready:
	lea	dx,.batch_prefix_offset
	mov	byte ptr .batch_pending_offset,0ffh
	jmps	submit_native_command

; Release all process memory before submitting the native CLI control block.
prepare_cli_command:
	mov	dx,0ffffh
	call	free_all_memory
	mov	byte ptr .batch_prefix_offset_4,00h
	lea	dx,.batch_prefix_offset_4
	cmp	byte ptr .original_search_explicit,00h
	jz	submit_native_command
	inc	dx
	inc	dx
	mov	byte ptr .command_length,00h

;------------------------------------------------------------------------------
; submit_native_command (07B4h), shared by the CLI launch setup paths.
; DS:DX already addresses their CLI control block. Mark a command sent so
; the next prompt adds a newline, then use supervisor CLI function 150.
; A zero BX result branches to the original success path at 07D5h;
; errors continue at 07C3h. Native lookup therefore reaches our supervisor's
; SETDEF policy after PCTMP has already found a candidate file. Its earlier
; fixed CMD/COM/EXE/BAT pre-search can prevent reaching CLI at all, as the
; bare SUB regression demonstrates. DOS lookup also needs separate review.
;------------------------------------------------------------------------------
submit_native_command:
	mov	byte ptr .command_sent,0ffh
	mov	cl,150
	call	ccpm_call
	cmp	bx,0
	je	native_cli_success
; Decoded original region 07C3h..07DCh.

; Map a failed BATCH launch to error 61; otherwise retain the native error.
native_cli_error:
	cmp	byte ptr .batch_pending_offset,0ffh
	jne	command_error_entry
	mov	byte ptr .batch_pending_offset,0
	mov	cx,61
	jmp	command_error_entry
native_cli_success:
	mov	byte ptr .original_search_explicit,0ffh
	jmp	command_prompt_resume

command_error_entry:
; Replace the common error dispatcher, preserving the original entry address.
	jmp	shell_command_error
; Decoded 07E0h..0900h: errors, parser helpers and native BDOS wrappers.

; Scan four-byte (error number, message offset) records in CS; FFFFh is the default.
find_command_error:
	add	si,04h
	db	02eh					; CS override; avoid ASM86 forced disp16
	cmp	word ptr [si],0ffffh
	jz	command_error_found
	db	02eh					; CS override
	cmp	cx,[si]
	jnz	find_command_error
command_error_found:
	db	02eh					; CS override
	mov	dx,2[si]
	or	dx,dx
	jnz	print_command_error
	mov	byte ptr .command_sent,dl
	jmp	command_prompt_resume
print_command_error:
; Preserve the error number across BDOS output for the numeric fallback.
; Two shorter instructions above pay for PUSH/POP without moving the tail.
	push	cx
	push	dx
	call	print_code_newline
	mov	dx,offset error_prefix
	call	print_code_string
	pop	dx
	pop	ax
	call	error_print_message
	call	print_code_newline
	mov	dx,offset original_msg_command_prefix
	call	print_code_string
	mov	dx,saved_command_text
	call	print_data_string
	call	print_code_newline
	jmp	command_prompt_resume

; DI initially precedes the input. Skip spaces, tabs and equals signs; return DI on token.
skip_command_separators:
	inc	di
	cmp	byte ptr [di],020h
	jz	skip_command_separators
	cmp	byte ptr [di],09h
	jz	skip_command_separators
	cmp	byte ptr [di],03dh
	jz	skip_command_separators
	ret

; Copy CX words within shared CODE, preserving DS/ES. SI/DI advance; caller owns DF.
copy_code_words:
	mov	ax,cs
	push	ds
	push	es
	mov	ds,ax
	mov	es,ax
	rep	movsw
	pop	es
	pop	ds
	ret

; Compare DS:SI with CS:DI for CX words. Preserve ES; return comparison flags.
compare_code_words:
	push	es
	mov	ax,cs
	mov	es,ax
	repe	cmpsw
	pop	es
	ret

; BDOS 152: store source DI and destination SI in the per-console parse packet.
parse_command_filename:
	mov	cx,098h
	mov	bx,parser_packet_offset
	mov	[bx],di
	mov	02h[bx],si
	mov	dx,bx
	jmp	ccpm_call

; Parse CH:DL:DH as hundreds:tens:units; leading spaces in DH/DL shift digits.
; Return BX=value or FFFFh; preserve CX/DX, destroy AX/SI.
parse_three_digits:
	push	cx
	push	dx
	cmp	dh,020h
	jnz	validate_three_digits
	mov	dh,dl
	mov	dl,ch
	mov	ch,030h
	cmp	dh,020h
	jnz	validate_three_digits
	mov	dh,dl
	mov	dl,ch
validate_three_digits:
	cmp	dh,030h
	jc	invalid_three_digits
	cmp	dh,039h
	ja	invalid_three_digits
	cmp	dl,030h
	jc	invalid_three_digits
	cmp	dl,039h
	ja	invalid_three_digits
	cmp	ch,030h
	jc	invalid_three_digits
	cmp	ch,039h
	ja	invalid_three_digits
	sub	dh,030h
	sub	dl,030h
	sub	ch,030h
	mov	ax,00h
	mov	al,dl
	push	dx
	mov	cl,0ah
	mul	cl
	mov	si,ax
	mov	cl,064h
	mov	al,ch
	mul	cl
	add	ax,si
	pop	dx
	mov	dl,dh
	mov	dh,00h
	add	ax,dx
	mov	bx,ax
	jmps	three_digits_done
invalid_three_digits:
	mov	bx,0ffffh
three_digits_done:
	pop	dx
	pop	cx
	ret

; Print DL in range 0..19 (one optional leading 1); not a general decimal formatter.
print_small_decimal:
	cmp	dl,0ah
	jc	print_decimal_units
	push	dx
	mov	dl,031h
	call	print_console_character
	pop	dx
	sub	dl,0ah
print_decimal_units:
	add	dl,030h
	jmp	print_console_character

; BDOS wrappers share ccpm_call. Arguments/results follow the selected native service.
current_user_get:
	mov	dl,0ffh
current_user_set:
	mov	cl,020h
	jmp	ccpm_call
print_code_newline:
	mov	dx,offset original_msg_newline
	jmp	print_code_string
console_poll:
	mov	dl,0fdh
	mov	cl,06h
	jmps	ccpm_call
console_set:
	mov	cl,094h
	jmps	ccpm_call
current_disk_set:
	mov	cl,0eh
	jmps	ccpm_call
current_disk_get:
	mov	cl,019h
	jmps	ccpm_call
list_device_set:
	mov	cl,0a0h
	jmps	ccpm_call
list_device_get:
	mov	cl,0a4h
	jmps	ccpm_call
console_attach:
	mov	cl,092h
	jmps	ccpm_call
console_detach:
	mov	cl,093h
	jmps	ccpm_call
free_all_memory:
	mov	cl,027h

;------------------------------------------------------------------------------
; ccpm_call (0901h)
; Thin gateway used by the command processor. CL selects the BDOS function;
; arguments and results follow that function's CP/M-86 convention.
; No register preservation is added here beyond what the OS supplies.
;------------------------------------------------------------------------------
ccpm_call:
	int	0e0h
	ret

; Original region 0904h..0CBEh: strings/tables and PC-MODE initialization code.
; In particular, 0C5Bh records SYSDAT and waits for console zero to establish
; the shared base DATA segment before the other console instances continue.

; Original command-error table: pairs of error number and CODE message offset.
; Error 31 has no message; four FFFFh entries preserve the original default slots.
original_error_table:
	dw	31,0
	dw	3,offset original_msg_memory_error
	dw	12,offset original_msg_process_error
	dw	24,offset original_msg_filespec_error
	dw	23,offset original_msg_filespec_error
	dw	38,offset original_msg_filespec_error
	dw	25,offset original_msg_filespec_error
	dw	28,offset original_msg_load_error
	dw	29,offset original_msg_load_error
	dw	30,offset original_msg_missing_command
	dw	15,offset original_msg_queue_error
	dw	40,offset original_msg_abort_error
	dw	19,offset original_msg_console_error
	dw	20,offset original_msg_console_error
	dw	21,offset original_msg_console_error
	dw	32,offset original_msg_console_error
	dw	36,offset original_msg_console_error
	dw	60,offset original_msg_type_error
	dw	61,offset original_msg_batch_error
	dw	0ffffh,offset original_msg_load_error
	dw	0ffffh,offset original_msg_load_error
	dw	0ffffh,offset original_msg_load_error
	dw	0ffffh,offset original_msg_load_error
original_msg_prompt:
	db	'>$'
original_msg_newline:
	db	13,10,'$'
original_msg_error_prefix:
	db	'CP/M Error: $'
original_msg_memory_error:
	db	'Not Enough Memory$'
original_msg_process_error:
	db	'PD Table Full$'
original_msg_filespec_error:
	db	'Bad File Spec$'
original_msg_load_error:
	db	'Load Error$'
original_msg_missing_command:
	db	'Can',39,'t Find Command$'
original_msg_queue_error:
	db	'RSP Command Que Full$'
original_msg_abort_error:
	db	'CLI Abort$'
original_msg_drive_error:
	db	'Invalid Drive$'
original_msg_console_error:
	db	'Can',39,'t Assign Console$'
original_msg_type_error:
	db	'Bad Filetype$'
original_msg_batch_error:
	db	'Can',39,'t Find BATCH.CMD$'
original_msg_command_prefix:
	db	'Command = $'
original_msg_user_invalid:
	db	13,10,'Invalid User Number, IGNORED',13,10,'$'
original_msg_user_value:
	db	13,10,'User Number = $'
original_msg_user_note:
	db	13,10,'Note:  User numbers only apply to CP/M media.',13,10,'$'
original_msg_memory_invalid:
	db	13,10,'Invalid Memory Allocation Size, IGNORED',13,10,'$'
original_msg_memory_value:
	db	13,10,'Memory Allocation Size = $'
original_msg_printer_invalid:
	db	13,10,'Invalid Printer Number, IGNORED',13,10,'$'
original_msg_printer_value:
	db	13,10,'Printer Number = $'
original_msg_ndp_absent:
	db	13,10,'8087 not installed',13,10,'$'
original_msg_ndp_invalid:
	db	13,10,'Invalid 8087 State, IGNORED',13,10,'$'
original_msg_ndp_value:
	db	13,10,'8087 = $'
original_msg_suspend_invalid:
	db	13,10,'Invalid Suspend State, IGNORED',13,10,'$'
original_msg_suspend_value:
	db	13,10,'Suspend = $'
original_msg_pause:
	db	'Strike a key when ready . . .$'

; Built-in names are nine-byte FCB comparison keys (name plus first type byte).
original_name_user:
	db	'USER     '
original_name_memory:
	db	'MEM      '
original_name_printer:
	db	'PRINTER  '
original_name_ndp:
	db	'8087     '
original_name_suspend:
	db	'SUSPEND  '
original_name_rem:
	db	'REM      '
original_name_sys:
	db	'SYS      '
original_name_pause:
	db	'PAUSE    '
original_name_del:
	db	'DEL      '
original_name_rename:
	db	'RENAME   '
original_erase_command:
	db	'ERASE.EXE'
original_command_separator:
	db	' '
original_on:
	db	'ON  '
original_off:
	db	'OFF '
original_startup_message:
	db	'Start up command: $'
original_identity_separator:
	db	0
original_service_identification:
	db	'COPYRIGHT(C)1984,DIGITAL RESEARCH(05/17/84)2004-0000-654321'

; Bind private/shared state to SYSDAT and this console. Console zero publishes
; the first DATA segment and the far jump to INT 21h; other consoles wait.
; Save the original INT E0h vector for the private BDOS gateway.
initialize_pc_mode:
	mov	es,word ptr .rsp_sysdat_segment
	mov	word ptr .clock_pointer_offset_2,es
	mov	cs:word ptr shared_sysdat_segment,es
	mov	ax,ds
	mov	word ptr .cache_pointer_offset_2,ax			; private far-pointer segment components
	mov	word ptr .slot_pointer_offset_2,ax
	mov	word ptr .default_fcb_pointer_offset_2,ax
	mov	si,es:word ptr .sd_running_process
	db	026h					; ES override, original disp8
	mov	bl,pd_console_number[si]
	mov	byte ptr .dos_console_number,bl
	or	bl,bl
	jnz	initialize_bdos_vector
	mov	cs:word ptr shared_first_data_segment,ax
	mov	ax,cs
	mov	cs:word ptr shared_dos_target+2,ax
	mov	ax,offset dos_dispatch_entry
	mov	cs:word ptr shared_dos_target,ax
initialize_bdos_vector:
	push	ds
	mov	ax,0
	mov	ds,ax
	mov	ax,word ptr .ivt_bdos_offset
	mov	cs:word ptr shared_bdos_vector,ax
	mov	ax,word ptr .ivt_bdos_segment
	mov	cs:word ptr shared_bdos_vector+2,ax
	pop	ds
initialize_wait_console_zero:
	cmp	cs:word ptr shared_first_data_segment,0
	jne	initialize_cleanup
	mov	cl,141
	mov	dx,30
	call	loader_bdos_call
	jmps	initialize_wait_console_zero
initialize_cleanup:
	jmp	service_cleanup


; Original region 0CBFh..105Eh: private service dispatch, cleanup, header read,
; memory allocation and EXE load placement.
; The entry at CODE:0003 jumps here. Do not confuse it with INT 21h dispatch.
pcmode_service:

; Private far-call entry, selected by CL; not the DOS interrupt dispatcher.
; Preserve caller FLAGS/ES/DS; return AX copied to BX. Save caller DS for packets.
; The supported build rejects selectors beyond the eight-word service table.
	pushf
	push	es
	push	ds
	push	ds
	call	select_console_data
	pop	word ptr .service_caller_ds
	mov	ax,ds
	mov	es,ax
	mov	bl,cl
	xor	bh,bh
	shl	bx,1
	mov	ax,0ffffh
	cmp	cl,(offset service_table_end-offset service_table)/2
	jnc	service_return
	call	cs:word ptr service_table[bx]
service_return:
	db	08bh,0d8h				; mov bx,ax, original direction encoding
	pop	ds
	pop	es
	popf
	retf
service_table:
	dw	offset service_cleanup
	dw	offset service_load
	dw	offset service_memory
	dw	offset service_ndp
	dw	offset service_suspend
	dw	offset service_word_setting
	dw	offset service_copy_settings
	dw	offset service_command_names
service_table_end:


; Copy caller FCB and command tail into private DATA, then load/execute.
; DS:DX packet: far FCB pointer, far tail pointer, one launch option byte.
service_load:
	push	ds
	mov	ds,word ptr .service_caller_ds
	db	08bh,0f2h				; mov si,dx, original direction encoding
	lodsw
	db	08bh,0d8h				; mov bx,ax, original direction encoding
	lodsw
	db	08bh,0d0h				; mov dx,ax, original direction encoding
	lodsw
	push	ax
	lodsw
	push	ax
	lodsb
	mov	es:byte ptr .loader_user_zero,al
	mov	di,program_fcb
	mov	cx,18
	db	08bh,0f3h				; mov si,bx, original direction encoding
	mov	ds,dx
	rep	movsw
	pop	ds
	pop	si
	mov	di,command_length
	mov	cx,67
	rep	movsw
	pop	ds
	mov	dx,command_length
	jmp	service_execute
; DX=FFFFh queries memory paragraphs; other values replace the setting.
service_memory:
	cmp	dx,0ffffh
	jne	service_memory_set
	mov	ax,word ptr .service_memory_paragraphs
	ret
service_memory_set:
	mov	word ptr .service_memory_paragraphs,dx
	ret
; DL=FFh queries a flag as AX=00FFh/0000h; DL=0 clears, other values set.
service_ndp:
	cmp	dl,0ffh
	jne	service_ndp_set
	mov	ax,0ffh
	mov	bl,byte ptr .service_flags
	and	bl,2
	jnz	service_ndp_return
	db	033h,0c0h				; xor ax,ax, original direction encoding
service_ndp_return:
	ret
service_ndp_set:
	or	dl,dl
	jnz	service_ndp_on
	and	byte ptr .service_flags,0fdh
	ret
service_ndp_on:
	or	byte ptr .service_flags,2
	ret
service_suspend:
	cmp	dl,0ffh
	jne	service_suspend_set
	mov	ax,0ffh
	mov	bl,byte ptr .service_flags
	and	bl,1
	jnz	service_suspend_return
	db	033h,0c0h				; xor ax,ax, original direction encoding
service_suspend_return:
	ret
service_suspend_set:
	or	dl,dl
	jnz	service_suspend_on
	and	byte ptr .service_flags,0feh
	ret
service_suspend_on:
	or	byte ptr .service_flags,1
	ret
; Service 5 word at DATA:06A6h; DX=FFFFh queries, otherwise sets.
; Launch sets FFFEh; exit clears it. No further interpretation is assumed.
service_word_setting:
	cmp	dx,0ffffh
	jne	service_word_set
	mov	ax,word ptr .private_service_word_offset
	ret
service_word_set:
	mov	word ptr .private_service_word_offset,dx
	ret
; Caller packet byte selects direction for twelve setting bytes at DATA:071Eh.
; Nonzero copies out; zero copies in. Return AX=0.
service_copy_settings:
	mov	es,word ptr .service_caller_ds
	db	08bh,0dah				; mov bx,dx, original direction encoding
	db	026h					; ES override; retain original instruction addressing
	test	byte ptr [bx],0ffh
	jz	service_settings_in
	lea	di,1[bx]
	mov	si,private_extensions_offset
	jmps	service_settings_copy
service_settings_in:
	lea	si,1[bx]
	mov	di,private_extensions_offset
	push	ds
	push	es
	pop	ds
	pop	es
service_settings_copy:
	mov	cx,6
	rep	movsw
	db	033h,0c0h				; xor ax,ax, original direction encoding
	ret
service_command_names:
	mov	dx,offset dos_command_names		; original DOS command-name table
	ret


; Release the DOS allocation and restore saved vectors when a session was active.
; Clear 24 private FCB slots (40 bytes each), then mark every slot unused.
; Reset per-launch console/file flags without changing the DATA layout.
service_cleanup:
	mov	ax,word ptr .loader_memory_size
	db	00bh,0c0h				; or ax,ax, original direction encoding
	jz	cleanup_vectors
	mov	dx,loader_memory_base
	mov	cl,57
	call	loader_bdos_call
	mov	word ptr .loader_memory_size,0
cleanup_vectors:
	cmp	byte ptr .dos_vectors_active,0ffh
	jne	cleanup_file_slots
	cld
	db	033h,0c9h				; xor cx,cx, original direction encoding
	mov	es,cx
	mov	di,040h					; original vector region begins at INT 10h
	mov	si,original_vectors_offset				; saved vector region, 47 words
	mov	cx,47
	rep	movsw
	mov	ax,020h
	call	xios_gateway
	mov	byte ptr .dos_vectors_active,0
cleanup_file_slots:
	push	ds
	pop	es
	mov	di,dos_file_slots
	mov	cx,fcb_slot_count*fcb_slot_bytes/2
	db	033h,0c0h				; xor ax,ax, original direction encoding
	cld
	rep	stosw
	mov	di,dos_file_slots
	mov	cx,fcb_slot_count
cleanup_mark_unused:
	mov	byte ptr [di],0ffh
	add	di,fcb_slot_bytes
	loop	cleanup_mark_unused
	mov	byte ptr .console_record_pending,0			; buffered console record pending/cursor
	mov	word ptr .console_record_position,0
	mov	byte ptr .record_cache_result,0			; file cache result/dirty/valid flags
	mov	byte ptr .record_cache_dirty,0
	mov	byte ptr .record_cache_valid,0
	mov	byte ptr .dos_printer_echo,0
	mov	byte ptr .dos_nested_console,0
	mov	word ptr .bios_keyboard_pending,0
	db	033h,0c0h				; xor ax,ax, original direction encoding
	ret


; Optional launch banner controlled by SYSDAT +4Fh: BCD time, drive/name/type,
; then foreground/background suffix. Preserve ES.
print_launch_banner:
	push	es
	mov	es,cs:word ptr shared_sysdat_segment
	test	es:byte ptr .04fh,0ffh
	jz	launch_banner_return
	les	si,dword ptr .native_clock_pointer
	inc	si
	inc	si
	call	launch_banner_bcd
	mov	dl,03ah
	call	launch_banner_character
	call	launch_banner_bcd
	mov	dl,03ah
	call	launch_banner_character
	call	launch_banner_bcd
	mov	dl,020h
	call	launch_banner_character
	mov	si,program_fcb
	lodsb
	or	al,al
	jnz	launch_banner_drive
	mov	al,.dos_current_drive
	inc	al
launch_banner_drive:
	add	al,040h
	mov	dl,al
	call	launch_banner_character
	mov	dl,03ah
	call	launch_banner_character
	mov	cx,08h
	call	launch_banner_name
	db	003h,0f1h				; add si,cx (original encoding)
	mov	dl,02eh
	call	launch_banner_character
	mov	cx,03h
	call	launch_banner_name
	mov	di,program_fcb
	mov	si,offset dos_launch_suffix
	mov	cx,013h
	test	byte ptr 08h[di],080h
	jnz	launch_banner_suffix
	cmp	byte ptr .loader_user_zero,0ffh
	jz	launch_banner_suffix
	sub	cx,09h
	add	si,09h
launch_banner_suffix:
	db	02eh					; CS override for LODSB
	lodsb
	mov	dl,al
	call	launch_banner_character
	loop	launch_banner_suffix
launch_banner_return:
	pop	es
	ret
launch_banner_name:
	lodsb
	and	al,07fh
	cmp	al,020h
	jz	launch_banner_name_end
	mov	dl,al
	call	launch_banner_character
	loop	launch_banner_name
	ret
launch_banner_name_end:
	dec	cx
	ret

; Output DL via native console, then poll direct console; preserve CX.
launch_banner_character:
	push	cx
	mov	cl,02h
	call	loader_bdos_call
	mov	cl,06h
	mov	dl,0ffh
	call	loader_bdos_call
	pop	cx
	ret

; Print the packed BCD byte at ES:SI as two decimal digits; advance SI.
launch_banner_bcd:
	db	026h					; ES override for LODSB
	lodsb
	push	ax
	mov	cl,04h
	shr	al,cl
	add	al,030h
	mov	dl,al
	call	launch_banner_character
	pop	ax
	and	al,0fh
	add	al,030h
	mov	dl,al
	call	launch_banner_character
	ret

; Load/execute service: save command-text pointer, current drive and user,
; derive compatibility flags from FCB attributes, optionally select user zero.
; COM takes the flat loader; other accepted types take the EXE header path.
service_execute:
	mov	ax,ds
	mov	es,ax
	inc	dx
	mov	.loader_command_text,dx
	mov	cl,019h
	call	loader_bdos_call
	mov	.dos_current_drive,al
	mov	.dos_working_drive,al
	call	print_launch_banner
	mov	si,program_fcb
	mov	byte ptr .loader_compatibility_flags,00h
	test	byte ptr 01h[si],080h
	jz	load_attribute_two
	or	byte ptr .loader_compatibility_flags,080h
load_attribute_two:
	test	byte ptr 02h[si],080h
	jz	load_attribute_three
	or	byte ptr .loader_compatibility_flags,040h
load_attribute_three:
	test	byte ptr 03h[si],080h
	jz	load_attribute_four
	or	byte ptr .loader_compatibility_flags,020h
load_attribute_four:
	test	byte ptr 04h[si],080h
	jz	load_save_user
	or	byte ptr .loader_compatibility_flags,070h
load_save_user:
	cmp	byte ptr .loader_user_zero,0ffh
	mov	cl,020h
	mov	dl,0ffh
	call	loader_bdos_call
	mov	.loader_saved_user,al
	cmp	byte ptr .loader_user_zero,0ffh
	jnz	load_select_format
	xor	dl,dl
	mov	cl,020h
	call	loader_bdos_call
load_select_format:
	mov	al,.command_fcb_offset_9
	and	al,07fh
	cmp	al,043h
	jnz	load_exe_header
	jmp	load_com_file
load_exe_header:
	push	ds
	pop	es
	mov	dx,exe_header
	call	set_loader_dma
	mov	dl,01h
	call	set_multi_record_count
	mov	si,program_fcb
	db	08bh,0d6h				; mov dx,si (original encoding)
	mov	word ptr 021h[si],00h
	mov	byte ptr 023h[si],00h
	mov	cl,021h
	call	loader_bdos_call
	or	al,al
	jz	exe_header_checked_entry

; Header read failed: report native load error 29 and restore caller user.
loader_read_error:
	mov	cx,01dh
	jmp	loader_failure
exe_header_checked_entry:
; After the first header read, validate before size arithmetic/allocation.
; Replace exactly the original four-byte MOV BX,[0457h]; the out-of-line
; guard executes that instruction on success.
	jmp	validate_exe_file
	nop
; Decoded original length arithmetic, 0F91h..0FA2h.


; Historical EXE length calculation, after the supported header guard.
exe_size_arithmetic:
	and	bx,01ffh
	mov	ax,.record_buffer_offset_4
	or	bx,bx
	jz	exe_page_paragraphs
	dec	ax
exe_page_paragraphs:
	mov	cl,05h
	shl	ax,cl
	dec	cl
	add	bx,15					; ceil(last-page bytes / 16), not nearest

	shr	bx,cl
	db	003h,0c3h				; add ax,bx (original encoding)
	sub	ax,.record_buffer_offset_8
	mov	.exe_image_paragraphs,ax
	add	ax,02bh
	add	ax,.record_buffer_offset_10
	db	08bh,0d8h				; mov bx,ax (original encoding)
	mov	si,command_fcb_offset_1
	mov	di,offset dos_command_names

; Match the eleven fixed DOS command-name slots. Other programs request at
; least the configured MEM allocation, before native BDOS 55 allocation.
exe_special_name:
	push	di
	push	si
	mov	cx,04h
exe_special_character:
	lodsw
	and	ax,07f7fh
	db	02eh					; CS override; original addressing
	cmp	[di],ax
	jnz	exe_special_compared
	inc	di
	inc	di
	loop	exe_special_character
exe_special_compared:
	pop	si
	pop	di
	or	cx,cx
	db	08bh,0c3h				; mov ax,bx (original encoding)
	jz	exe_allocate_memory
	add	di,08h
	cmp	di,offset dos_command_names_end
	jnz	exe_special_name
	cmp	ax,.service_memory_paragraphs
	jnc	exe_allocate_memory
	mov	ax,.service_memory_paragraphs

; Temporarily raise SYSDAT memory ceiling for allocation, then restore it.
exe_allocate_memory:
	push	es
	mov	es,cs:word ptr shared_sysdat_segment
	push	es:word ptr .04ch
	cmp	es:.04ch,ax
	jnc	exe_allocate_request
	mov	es:.04ch,ax
	add	es:word ptr .04ch,0600h
exe_allocate_request:
	mov	.loader_memory_size,ax
	mov	cl,037h
	mov	dx,loader_memory_base
	call	loader_bdos_call
	pop	es:word ptr .04ch
	pop	es
	or	al,al
	jz	exe_memory_allocated
	mov	cx,03h
	jmp	loader_failure

exe_memory_allocated:
; Successful BDOS 55 allocation (1024h). Its descriptor contains the actual
; base and size, not merely the EXE minimum request. Reserve 1Bh paragraphs
; for private loader state, followed by the 10h-paragraph PSP. MAXALLOC=FFFFh
; leaves the image immediately after that PSP. Otherwise the recovered policy
; positions the image near the allocation's upper end, subject to MAXALLOC.
; Initial-stack validation must use this final placement and actual extent;
; checking SS:SP against image bytes alone would reject legitimate BSS stacks.
	mov	ax,word ptr .loader_memory_size
	sub	ax,1bh
	mov	word ptr .child_memory_size,ax
	mov	ax,word ptr .loader_memory_base
	add	ax,1bh
	mov	word ptr .child_psp_segment,ax
	add	ax,10h
	mov	word ptr .exe_load_segment,ax
	cmp	word ptr .exe_header+0ch,-1
	je	prepare_exe_entry
	mov	ax,word ptr .child_psp_segment
	add	ax,word ptr .child_memory_size
	sub	ax,word ptr .exe_image_paragraphs
	mov	word ptr .exe_load_segment,ax
	sub	ax,word ptr .exe_header+0ch
	jc	prepare_exe_entry
	sub	ax,10h
	jc	prepare_exe_entry
	mov	word ptr .exe_load_segment,ax

;------------------------------------------------------------------------------
; prepare_exe_entry (105Fh)
; Memory allocation and load placement have selected exe_load_segment.
; Rebase MZ CS/SS, retain header IP/SP, and build the child's PSP. The common
; launch path consumes these four child_* fields after image relocation.
;------------------------------------------------------------------------------
prepare_exe_entry:
	call	validate_exe_stack
	nop
	nop
	nop
	nop
	mov	word ptr .child_stack_segment,ax
	mov	ax,word ptr .exe_initial_sp
	mov	word ptr .child_stack_offset,ax
	mov	ax,word ptr .exe_initial_cs
	add	ax,word ptr .exe_load_segment
	mov	word ptr .child_entry_segment,ax
	mov	ax,word ptr .exe_initial_ip
	mov	word ptr .child_entry_offset,ax
	mov	byte ptr .child_is_com,0
	call	construct_psp
	db	033h,0d2h				; xor dx,dx: DMA begins at offset zero
	mov	cl,26
	call	loader_bdos_call
	mov	ax,word ptr .exe_load_segment
	mov	word ptr .exe_dma_segment,ax
	mov	ax,word ptr .exe_image_paragraphs
	add	ax,7					; retain original accumulator encoding
	mov	cl,3
	shr	ax,cl					; round paragraphs to 128-byte records
	mov	word ptr .exe_records_left,ax

; The original calculation discards a partial 512-byte header page. The
; experimental path selects bulk record reads or a header-tail copy reader.
	jmp	load_exe_header_tail			; choose record-aligned or byte-shifting path
exe_aligned_record_index:
	mov	cl,3
	shr	ax,cl					; header paragraphs / 8 = CP/M records
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	mov	word ptr .exe_next_record,ax
	mov	byte ptr .exe_next_record+2,0
	mov	dx,128
	call	set_multi_record_count
read_exe_image_chunk:
	mov	cl,51					; DMA segment; offset remains zero
	mov	dx,word ptr .exe_dma_segment
	call	loader_bdos_call
	mov	ax,400h					; 16 KiB in paragraphs
	mov	di,128					; 16 KiB in CP/M records
	cmp	word ptr .exe_records_left,di
	jae	read_exe_image_records
	mov	di,word ptr .exe_records_left
	db	08bh,0d7h				; mov dx,di: final shorter multi-read
	call	set_multi_record_count
	db	08bh,0c7h				; mov ax,di
	shl	ax,1
	shl	ax,1
	shl	ax,1					; records to paragraphs
read_exe_image_records:
	mov	dx,program_fcb
	db	08bh,0f2h				; mov si,dx
	add	word ptr .exe_dma_segment,ax
	mov	ax,word ptr .exe_next_record
	mov	word ptr fcb_random_record[si],ax
	mov	al,byte ptr .exe_next_record+2
	mov	byte ptr fcb_random_record+2[si],al
	add	word ptr .exe_next_record,di
	adc	byte ptr .exe_next_record+2,0
	mov	cl,33					; random read with current multi-count
	call	loader_bdos_call
	db	00ah,0c0h				; or al,al
	jz	exe_image_chunk_done
	cmp	al,1					; EOF is accepted by the original loader
	jz	exe_image_chunk_done
	mov	cx,1dh
	jmp	loader_failure
exe_image_chunk_done:
	sub	word ptr .exe_records_left,di
	jnz	read_exe_image_chunk


;------------------------------------------------------------------------------
; relocate_exe (111Eh)
; Image loading is complete. DS selects PCTMP DATA; exe_load_segment is the
; actual load base in paragraphs. exe_header still holds file record zero.
; Each MZ relocation is an offset:segment pair relative to the image base.
; Resolve that pair and add the load base to the target WORD, not its address.
; The relocation helper validates both
; target bytes before rebasing. See pcguard.lib for its error-stack contract.
; The original reader assumes the initial table offset is in record zero and
; entries fit the record layout. The checked pass handles arbitrary byte starts
; and entries split across file records.
;------------------------------------------------------------------------------
relocate_exe:
	jmp	relocate_exe_checked
	nop
	nop
	nop
	mov	word ptr .exe_next_record,1
	mov	byte ptr .exe_next_record+2,0
	mov	ax,word ptr .exe_relocation_offset
	mov	word ptr .exe_relocation_cursor,ax
	mov	cx,word ptr .exe_relocation_count
	jcxz	exe_relocations_done
exe_relocation_loop:
	push	cx
	call	read_exe_relocation
	pop	cx
	call	validate_exe_relocation
	nop
	nop
	nop
	mov	es,ax					; ES:SI now addresses the loaded target
	mov	ax,word ptr .exe_load_segment
	add	es:word ptr [si],ax
	loop	exe_relocation_loop
exe_relocations_done:
	jmp	prepare_dos_execution

;------------------------------------------------------------------------------
; read_exe_relocation (1153h)
; Return ES:SI = relative segment:offset from the next relocation entry.
; Advance the cursor by four bytes; at the record boundary refill the header
; scratch buffer through CP/M random read. Preserve the just-fetched pair
; across refill. The enclosing loop saves CX because BDOS uses CL.
; Refill happens immediately, even when the fetched entry was the last one.
; A failed refill jumps to the common loader error path; it does not return.
;------------------------------------------------------------------------------
read_exe_relocation:
	mov	bx,word ptr .exe_relocation_cursor
	les	si,dword ptr exe_header[bx]
	add	bx,4
	cmp	bx,128
	jae	refill_exe_relocations
	mov	word ptr .exe_relocation_cursor,bx
	ret
refill_exe_relocations:
	push	es
	push	si
	mov	word ptr .exe_relocation_cursor,0
	push	ds
	pop	es
	mov	dx,exe_header
	call	set_loader_dma
	mov	dx,program_fcb
	db	08bh,0f2h				; mov si,dx: original encoding
	mov	ax,word ptr .exe_next_record
	mov	word ptr fcb_random_record[si],ax
	mov	al,byte ptr .exe_next_record+2
	mov	byte ptr fcb_random_record+2[si],al
	add	word ptr .exe_next_record,1
	adc	byte ptr .exe_next_record+2,0
	mov	cl,33					; CP/M random record read
	call	loader_bdos_call
	pop	si
	pop	es
	db	00ah,0c0h				; or al,al: original encoding
	jz	exe_relocation_ready
	jmp	loader_read_error
exe_relocation_ready:
	ret

; Original region 11A3h..147Bh: COM load path and shared launch/PSP construction.


; COM loader: allocate configured memory, reserve 1Bh paragraphs for native
; UDA/PD state, and start at PSP:0100h with a bounded initial stack.
load_com_file:
	mov	byte ptr .child_is_com,0ffh
	mov	ax,.service_memory_paragraphs
	mov	.loader_memory_size,ax
	push	es
	mov	es,cs:word ptr shared_sysdat_segment
	push	es:word ptr .04ch
	cmp	es:.04ch,ax
	jnc	com_allocate_request
	mov	es:.04ch,ax
	add	es:word ptr .04ch,0600h
com_allocate_request:
	mov	cl,037h
	mov	dx,loader_memory_base
	call	loader_bdos_call
	pop	es:word ptr .04ch
	pop	es
	or	al,al
	jz	com_memory_allocated
	mov	cx,03h
	jmp	loader_failure
com_memory_allocated:
	cmp	word ptr .loader_memory_size,02ch
	jnc	com_memory_valid
	mov	cx,3
	jmp	loader_failure
com_memory_valid:
	mov	ax,.loader_memory_size
	sub	ax,01bh
	mov	.child_memory_size,ax
	mov	ax,.loader_memory_base
	add	ax,01bh
	mov	.child_psp_segment,ax
	mov	.child_entry_segment,ax
	mov	word ptr .child_entry_offset,0100h
	mov	.child_stack_segment,ax
	call	child_segment_bytes
	mov	.child_stack_offset,ax
	call	construct_psp
	sub	es:word ptr .06h,0100h
	add	es:word ptr .08h,010h
	mov	dx,es
	mov	cl,033h
	call	loader_bdos_call
	mov	word ptr .child_segments_offset_6,0100h
	mov	di,program_fcb
	mov	byte ptr 020h[di],00h
	mov	dl,080h
	call	set_multi_record_count
	mov	di,04000h

; Read COM sequentially in 128-record (16 KiB) chunks. Check each complete
; chunk against the PSP call-area limit; accept native EOF result 1.
com_next_chunk:
	mov	ax,.child_segments_offset_6
	db	003h,0c7h				; add ax,di (original encoding)
	jc	com_chunk_too_large
	cmp	ax,es:.06h
	jna	com_read_chunk
com_chunk_too_large:
	mov	cx,03h
	jmp	loader_failure
com_read_chunk:
	mov	dx,.child_segments_offset_6
	mov	cl,01ah
	call	loader_bdos_call
	add	.child_segments_offset_6,di
	mov	dx,program_fcb
	mov	cl,014h
	call	loader_bdos_call
	or	al,al
	jz	com_next_chunk
	push	ax
	mov	dl,01h
	call	set_multi_record_count
	pop	ax
	cmp	al,01h
	jz	prepare_dos_execution
	mov	cx,01dh
	jmp	loader_failure

; Common loaded-image continuation: release native file locks (39), construct
; the child launch frame and initialize PSP tail and default FCBs.
prepare_dos_execution:
	mov	cl,027h
	mov	dx,0ffffh
	call	loader_bdos_call
	call	build_child_launch_frame
	mov	es,word ptr .child_psp_segment
	mov	al,020h
	mov	di,05dh
	mov	cx,0bh
	push	cx
	rep	stosb
	pop	cx
	mov	di,06dh
	rep	stosb
	mov	ax,ds
	mov	es,ax
	mov	si,.loader_command_text
	mov	cx,080h
	db	033h,0c0h				; xor ax,ax (original encoding)
	db	08bh,0feh				; mov di,si (original encoding)
	repne	scasb
	mov	ax,080h
	db	02bh,0c1h				; sub ax,cx (original encoding)
	db	08bh,0c8h				; mov cx,ax (original encoding)
	dec	cx
	mov	.launch_command_count_offset,cl
	or	cl,cl
	jz	launch_build_process
	push	cx
	mov	di,metadata_fcb_offset
	mov	al,01h
	call	parse_dos_fcb
	pop	cx
	cmp	byte ptr [si],00h
	jz	launch_build_process
	db	08bh,0c6h				; mov ax,si (original encoding)
	sub	ax,.loader_command_text
	sub	cl,al
	jz	launch_build_process
	mov	es,word ptr .child_psp_segment
	mov	di,080h
	db	026h					; ES override; original addressing
	mov	[di],cl
	push	si
	inc	di
	rep	movsb
	db	026h					; ES override; original addressing
	mov	byte ptr [di],0dh
	mov	al,01h
	pop	si
	mov	di,05ch
	call	parse_dos_fcb
	cmp	byte ptr [si],00h
	jz	launch_build_process
	mov	al,01h
	mov	di,06ch
	call	parse_dos_fcb

; Prepare native child process state, inherit console attributes, set DOS DTA,
; snapshot interrupt vectors and enable the XIOS PC-MODE service.
launch_build_process:
	mov	word ptr .private_service_word_offset,0fffeh
	db	033h,0c9h				; xor cx,cx (original encoding)
	db	08bh,0d1h				; mov dx,cx (original encoding)
	mov	cl,.dos_console_number
	mov	ax,02ch
	mul	cl
	push	es
	mov	si,xios_console_table
	mov	es,cs:word ptr shared_sysdat_segment
	db	026h					; ES override; original addressing
	mov	si,[si]
	db	003h,0f0h				; add si,ax (original encoding)
	db	026h					; ES override; original addressing
	test	word ptr 0eh[si],0200h
	jz	launch_set_dma
	mov	byte ptr .dos_printer_echo,0ffh
	db	026h					; ES override; original addressing
	mov	al,08h[si]
	mov	.dos_list_number,al
launch_set_dma:
	mov	es,word ptr .child_psp_segment
	mov	dx,080h
	call	dos_fn_set_dta
	pop	es
	push	ds
	pop	es
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	ds,ax
	mov	si,040h
	mov	di,original_vectors_offset
	mov	cx,02fh
	rep	movsw
	push	es
	pop	ds
	mov	byte ptr .dos_vectors_active,0ffh
	mov	cx,01h
	mov	ax,020h
	call	xios_gateway
	push	ds
	mov	ds,word ptr .loader_memory_base
	mov	cl,090h
	mov	dx,batch_prefix_offset_4
	call	loader_bdos_call
	pop	ds
	or	ax,ax
	jnz	loader_failure
	mov	cl,095h
	mov	dx,attach_packet_offset
	call	loader_bdos_call
	jmps	loader_restore_user

; Return AX=BX=FFFFh with error CX, restoring user through result-preserving BDOS.
loader_failure:
	mov	ax,0ffffh
	db	08bh,0d8h				; mov bx,ax (original encoding)
loader_restore_user:
	push	cx
	mov	dl,.loader_saved_user
	mov	cl,020h
	call	bdos_preserve_results
	pop	cx
	ret

; Build native UDA/PD ahead of the DOS PSP. Clear 02B0h bytes, install stack
; and segment state, inherit list/console/user settings and copy process name.
construct_psp:
	mov	ax,.loader_memory_base
	mov	es,ax
	add	ax,018h
	mov	.child_segments_offset,ax
	db	033h,0c0h				; xor ax,ax (original encoding)
	db	08bh,0f8h				; mov di,ax (original encoding)
	mov	cx,0158h
	rep	stosw
	mov	ax,.rsp_sysdat_segment
	mov	es:.020h,ax
	mov	ax,es
	add	ax,01bh
	mov	es:.054h,ax
	mov	es:.052h,ax
	mov	ax,.child_stack_segment
	mov	es:.056h,ax
	mov	es:word ptr .02h,080h
	mov	ax,cs
	mov	es:.050h,ax
	mov	ax,.child_stack_offset
	sub	ax,0ah
	cmp	byte ptr .child_is_com,0ffh
	jnz	psp_stack_ready
	dec	ax
	dec	ax
psp_stack_ready:
	mov	es:.034h,ax
	mov	es:word ptr .0100h,03ffh
	mov	es,word ptr .child_segments_offset
	mov	es:byte ptr .05h,0c8h
	test	byte ptr .service_flags,01h
	jz	psp_set_process_flags
	mov	es:word ptr .026h,01h
psp_set_process_flags:
	mov	es:word ptr .06h,02040h
	test	byte ptr .service_flags,02h
	jz	psp_inherit_console
	or	es:word ptr .06h,08000h
psp_inherit_console:
	push	ds
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	si,.068h
	mov	al,024h[si]
	mov	es:.024h,al
	mov	al,020h[si]
	mov	es:.020h,al
	mov	cx,012h[si]
	pop	ds
	mov	.attach_packet_offset,al
	mov	ch,.loader_saved_user
	mov	es:.012h,cx
	mov	al,.loader_compatibility_flags
	mov	es:.018h,al
	db	033h,0ffh				; xor di,di (original encoding)
	mov	si,command_fcb_offset_1
	mov	cx,04h
psp_copy_process_name:
	lodsw
	and	ax,07f7fh
	db	026h					; ES override; original addressing
	mov	08h[di],ax
	mov	attach_packet_offset+4[di],ax
	inc	di
	inc	di
	loop	psp_copy_process_name

; Build DOS PSP: INT 20h entry, allocation end, far-call stub and INT 22h/23h/24h.
	mov	es,word ptr .child_psp_segment
	db	033h,0ffh				; xor di,di (original encoding)
	mov	ax,020cdh
	stosw
	mov	ax,.loader_memory_size
	add	ax,.loader_memory_base
	stosw
	mov	ah,09ah
	stosw
	call	child_segment_bytes
	stosw
	call	call_trampoline_segment
	stosw
	mov	ax,offset dos_return_handler
	stosw
	mov	ax,cs
	stosw
	mov	ax,offset dos_ctrl_c_handler
	stosw
	mov	ax,cs
	stosw
	mov	ax,offset dos_error_handler
	stosw
	mov	ax,cs
	stosw
	ret

;------------------------------------------------------------------------------
; build_child_launch_frame (147Ch)
; The EXE guard validates these five WORD destinations before this code runs.
; COM adds a zero return address first, for RET-to-PSP termination. SI arithmetic
; deliberately wraps at 16 bits: SP=0 builds the frame at the segment's top.
; Final frame: PCTMP launch IP:CS, FLAGS, child IP:CS. The launch continuation
; eventually consumes it and leaves the application's specified initial SP.
;------------------------------------------------------------------------------
build_child_launch_frame:
	push	es
	mov	es,word ptr .child_stack_segment
	mov	si,word ptr .child_stack_offset
	cmp	byte ptr .child_is_com,0ffh
	jne	child_frame_exe
	dec	si
	dec	si
	mov	es:word ptr [si],0
child_frame_exe:
	dec	si
	dec	si
	mov	ax,word ptr .child_entry_segment
	mov	es:word ptr [si],ax
	dec	si
	dec	si
	mov	ax,word ptr .child_entry_offset
	mov	es:word ptr [si],ax
	dec	si
	dec	si
	mov	es:word ptr [si],200h			; enable interrupts on child entry
	dec	si
	dec	si
	mov	ax,cs
	mov	es:word ptr [si],ax
	dec	si
	dec	si
	mov	ax,offset child_launch_entry		; recovered PCTMP launch continuation
	mov	es:word ptr [si],ax
	pop	es
	ret

; Original region 14BBh..15A6h: child entry, interrupt installation and dispatch.
child_launch_entry:

; Finish child-entry setup. AX=SYSDAT, CX=0, ES=child segment on entry.
; Install PD user-dispatch callback and UDA error mode, then intercept INT E0h
; and the fourteen DOS/BIOS vectors. Restore child ES and clear entry registers.
install_child_vectors:
	mov	bx,es
	mov	es,ax
	mov	si,es:word ptr .sd_running_process
	pushf
	cli
	db	026h					; ES override; retain original instruction addressing
	mov	word ptr 02ah[si],cs
	db	026h					; ES override; retain original instruction addressing
	mov	word ptr 028h[si],offset swap_child_vectors
	db	026h					; ES override; retain original instruction addressing
	mov	es,word ptr pd_uda_segment[si]
	mov	es:byte ptr .010h,0ffh
	popf
	mov	es,cx
	mov	cx,es:word ptr .ivt_bdos_offset
	mov	cs:word ptr shared_previous_dispatch,cx
	mov	cx,es:word ptr .ivt_bdos_segment
	mov	cs:word ptr shared_previous_dispatch+2,cx
	mov	cx,offset child_native_dispatch
	mov	es:word ptr .ivt_bdos_offset,cx
	mov	es:word ptr .ivt_bdos_segment,cs
	mov	si,offset interrupt_vectors
	mov	cx,(offset interrupt_vectors_end-offset interrupt_vectors)/3
install_child_vector:
	db	02eh					; CS override for LODSB
	lodsb
	xor	ah,ah
	shl	ax,1
	shl	ax,1
	xchg	ax,di
	db	02eh					; CS override for MOVSW
	movsw
	db	026h					; ES override; retain original instruction addressing
	mov	word ptr [di],cs
	loop	install_child_vector
	mov	es,bx
	db	033h,0c0h				; xor ax,ax, original direction encoding
	db	08bh,0d8h				; mov bx,ax, original direction encoding
	db	08bh,0c8h				; mov cx,ax, original direction encoding
	db	08bh,0f0h				; mov si,ax, original direction encoding
	db	08bh,0f8h				; mov di,ax, original direction encoding
	retf
; Return the segment adjustment to address the paragraph-aligned CALL stub.
; AX is the caller offset adjustment on entry; DX/CX/BX are scratch.
call_trampoline_segment:
	mov	dx,cs
	mov	bx,offset dos_call_trampoline
	mov	cl,4
	shr	bx,cl
	shr	ax,cl
	db	003h,0dah				; add bx,dx, original direction encoding
	db	02bh,0d8h				; sub bx,ax, original direction encoding
	xchg	ax,bx
	ret
; DOS INT 22h return path: restore vectors, then terminate the native process.
dos_return_handler:
	call	select_console_data
	mov	word ptr .private_service_word_offset,0
child_cleanup_return:
	call	cleanup_vectors
	mov	cl,143
	mov	dl,0ffh
	jmp	loader_bdos_call
child_cleanup_entry:
	call	select_console_data
	jmps	child_cleanup_return
set_multi_record_count:
	mov	cl,44
	jmp	loader_bdos_call
; Convert allocated paragraphs to a bounded byte count for the child segment.
child_segment_bytes:
	mov	ax,word ptr .child_memory_size
; Alternate entry: AH=26h supplies its new PSP allocation size in AX.
limit_segment_bytes:
	cmp	ax,01000h
	jc	child_small_segment
	mov	ax,0fff0h
	ret
child_small_segment:
	mov	cl,4
	shl	ax,cl
	ret
; Scheduler user-dispatch callback: AX=0 saves the active vector region;
; AX!=0 restores this console's saved region. Copy 47 words starting INT 10h.
swap_child_vectors:
	push	ds
	call	select_console_data
	push	es
	push	cx
	mov	cx,47
	db	00bh,0c0h				; or ax,ax, original direction encoding
	jnz	restore_child_vectors
	mov	si,040h
	mov	di,active_vectors_offset
	mov	ax,ds
	mov	es,ax
	db	033h,0c0h				; xor ax,ax, original direction encoding
	mov	ds,ax
	jmps	copy_child_vectors
restore_child_vectors:
	mov	si,active_vectors_offset
	mov	di,040h
	db	033h,0c0h				; xor ax,ax, original direction encoding
	mov	es,ax
copy_child_vectors:
	rep	movsw
	pop	cx
	pop	es
	pop	ds
	retf
; Intercept native termination to clear the private word setting, then chain.
child_native_dispatch:
	cmp	cl,0
	je	child_native_terminate
	jmpf	cs:dword ptr shared_previous_dispatch
child_native_terminate:
	push	ds
	call	select_console_data
	mov	word ptr .private_service_word_offset,0
	pop	ds
	jmpf	cs:dword ptr shared_previous_dispatch


;------------------------------------------------------------------------------
; select_console_data (15A7h)
; Used on intercepted interrupts, where the caller's DS belongs to a DOS app.
; Result: DS=this console's PCTMP DATA; AX, DX and BX preserved; DF cleared.
; Flags are not preserved. The running PD comes from SYSDAT:0068h.
;
; The DATA stride is an embedded ABI constraint, not a guessed buffer size.
; Four shifts convert 0AF0h bytes to paragraphs; console zero's DATA segment
; is then added. Shared CODE state is addressed explicitly with CS overrides.
;------------------------------------------------------------------------------
select_console_data:
	cld
	push	ax
	push	dx
	push	bx
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	bx,word ptr .sd_running_process
	mov	bl,byte ptr pd_console_number[bx]
	db	032h,0ffh				; xor bh,bh: original register/register encoding
	mov	ax,console_data_bytes
	shr	ax,1
	shr	ax,1
	shr	ax,1
	shr	ax,1
	mul	bx
	add	ax,cs:word ptr shared_first_data_segment
	mov	ds,ax
	pop	bx
	pop	dx
	pop	ax
	ret


;------------------------------------------------------------------------------
; xios_gateway (15D1h): AL=function, BL=BIOS operation when AL=31.
; Select kernel DS and the running process UDA in ES. For packet operations
; preserve CX:DX; simple calls get DL=current PD console. AX/BX/CX are results.
; XIOS itself exchanges AX/BX on entry; its return also copies AX into BX.
;------------------------------------------------------------------------------
xios_gateway:
	push	dx
	push	si
	push	es
	push	ds
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	si,word ptr .sd_running_process
	mov	es,word ptr pd_uda_segment[si]
	cmp	al,01fh
	jnz	xios_supply_console
	cmp	bl,06h
	jz	xios_call_entry
	cmp	bl,07h
	jz	xios_call_entry
	cmp	bl,09h
	jz	xios_call_entry
	cmp	bl,0ah
	jz	xios_call_entry
	cmp	bl,0bh
	jz	xios_call_entry
	cmp	bl,0ch
	jz	xios_call_entry
	cmp	bl,0dh
	jz	xios_call_entry
xios_supply_console:
	mov	dl,byte ptr pd_console_number[si]
xios_call_entry:
	callf	cs:dword ptr shared_xios_entry
	pop	ds
	pop	es
	pop	si
	pop	dx
	ret

; Original region 1615h..1637h: XIOS console-output wrapper.
; Decoded original region 1615h..1637h.

; Echo CL to the assigned native list device through the XIOS gateway.
; Preserve AX/DX/SI/ES/DS; caller preserves CX when needed.
dos_echo_to_printer:
	push	ax
	push	dx
	push	si
	push	es
	push	ds
	mov	ax,4
	mov	dl,byte ptr .dos_list_number
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	si,word ptr .sd_running_process
	mov	es,word ptr pd_uda_segment[si]
	callf	cs:dword ptr shared_xios_entry
	pop	ds
	pop	es
	pop	si
	pop	dx
	pop	ax
	ret


;------------------------------------------------------------------------------
; INT 10h: save application DS/SI, select this console DATA, switch to private
; SS:SP, then save AX/BX/CX/DS/DX/BP/ES/DI at DATA:0439h down to 042Bh.
; Changing a result requires writing that saved frame before the shared exit.
; This is the original reconstruction. No new BIOS functionality is enabled.
;------------------------------------------------------------------------------
bios_video_handler:
	sti
	push	ds
	push	si
	call	select_console_data
	cli
	mov	word ptr .child_stack_segment,ss
	mov	word ptr .child_stack_offset,sp
	mov	si,ds
	mov	ss,si
	mov	sp,bios_frame_ax+2
	sti
	push	ax
	push	bx
	push	cx
	push	ds
	push	dx
	push	bp
	push	es
	push	di
	db	00ah,0e4h				; or ah,ah: original encoding
	jnz	bios_video_try_cursor_shape
	cmp	al,07h
	jz	bios_mode_text_number
	cmp	al,04h
	jnc	bios_mode_graphics_number

;------------------------------------------------------------------------------
; Native text modes are BIOS mode +2; native graphics modes use a high nibble.
;------------------------------------------------------------------------------
bios_mode_text_number:
	inc	al
	inc	al
	db	08ah,0c8h				; mov cl,al: original encoding
	jmps	bios_mode_set
bios_mode_graphics_number:
	dec	al
	dec	al
	shl	al,1
	shl	al,1
	shl	al,1
	shl	al,1
	db	08ah,0c8h				; mov cl,al: original encoding
bios_mode_set:
	mov	ax,01eh
	db	032h,0edh				; xor ch,ch: original encoding
	call	xios_gateway
	jmp	bios_video_restore_frame
bios_video_try_cursor_shape:
	cmp	ah,01h
	jnz	bios_video_try_cursor_set
	mov	al,01fh
	mov	bl,01h
	call	xios_gateway
	jmp	bios_video_restore_frame
bios_video_try_cursor_set:
	cmp	ah,02h
	jnz	bios_video_try_cursor_get
	db	08bh,0cah				; mov cx,dx: original encoding
	mov	al,01fh
	mov	bl,02h
	call	xios_gateway
	jmp	bios_video_restore_frame

;------------------------------------------------------------------------------
; Cursor query copies XIOS AX into the saved DOS DX, and returns CX=0.
; The recovered handler does not supply the cursor shape in CX.
;------------------------------------------------------------------------------
bios_video_try_cursor_get:
	cmp	ah,03h
	jnz	bios_video_try_page
	mov	al,01fh
	mov	bl,03h
	call	xios_gateway
	mov	word ptr .bios_frame_dx,ax
	db	033h,0c9h				; xor cx,cx: original encoding
	mov	word ptr .bios_frame_cx,cx
	jmp	bios_video_restore_frame

;------------------------------------------------------------------------------
; AH=04/05 have no implemented branch. Preserve the original caller registers.
;------------------------------------------------------------------------------
bios_video_try_page:
	cmp	ah,05h
	jnc	bios_video_try_scroll_up
	jmp	bios_video_restore_frame
bios_video_try_scroll_up:
	cmp	ah,06h
	jnz	bios_video_try_scroll_down
	mov	si,061fh
	mov	bl,00h
	jmps	bios_video_packet
bios_video_try_scroll_down:
	cmp	ah,07h
	jnz	bios_video_try_read_cell
	mov	si,071fh
	mov	bl,00h

;------------------------------------------------------------------------------
; Build the nine-byte XIOS packet in console-private DATA. AH is cleared:
; AX carries color/count, BX page/attribute/palette, CX/DX coordinates.
; SI holds packed BIOS operation:XIOS function. Gateway returns AX, but this
; shared path does not copy it into bios_frame_ax before restoring the caller.
; In particular the AH=0Dh pixel-read result is discarded in the recovered code.
;------------------------------------------------------------------------------
bios_video_packet:
	db	032h,0e4h				; xor ah,ah: original encoding
	mov	word ptr .bios_packet_ax,ax
	mov	word ptr .bios_packet_bx,bx
	mov	word ptr .bios_packet_cx,cx
	mov	word ptr .bios_packet_dx,dx
	push	ds
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	bx,word ptr .sd_running_process
	mov	al,byte ptr pd_console_number[bx]
	pop	ds
	mov	byte ptr .bios_packet_console,al
	db	08bh,0c6h				; mov ax,si: original encoding
	db	08ah,0dch				; mov bl,ah: original encoding
	mov	cx,ds
	mov	dx,bios_packet_ax
	call	bios_video_packet_result
	jmp	bios_video_restore_frame

;------------------------------------------------------------------------------
; Character readback explicitly updates saved AX; unlike generic packet return.
;------------------------------------------------------------------------------
bios_video_try_read_cell:
	cmp	ah,08h
	jnz	bios_video_try_write_cell
	mov	al,01fh
	mov	bl,08h
	call	xios_gateway
	mov	word ptr .bios_frame_ax,ax
	jmp	bios_video_restore_frame
bios_video_try_write_cell:
	cmp	ah,09h
	jnz	bios_video_try_write_character
	mov	si,091fh
	mov	bh,00h
	jmps	bios_video_packet
bios_video_try_write_character:
	cmp	ah,0ah
	jnz	bios_video_try_palette
	mov	si,0a1fh
	mov	bh,00h
	jmps	bios_video_packet
bios_video_try_palette:
	cmp	ah,0bh
	jnz	bios_video_try_pixel_write
	mov	si,0b1fh
	jmps	bios_video_packet
bios_video_try_pixel_write:
	cmp	ah,0ch
	jnz	bios_video_try_pixel_read
	mov	si,xios_pixel_write				; XIOS pixel-write protocol selector
	jmps	bios_video_packet

;------------------------------------------------------------------------------
; Original AH=0Dh routes to XIOS 31/13, whose CGA helper returns a pixel color.
; The shared packet path restores original AX, so this branch cannot return
; that color through AL. Fixing/adding readback requires both sides reviewed.
;------------------------------------------------------------------------------
bios_video_try_pixel_read:
	cmp	ah,0dh
	jnz	bios_video_try_teletype
	mov	si,0d1fh
	jmps	bios_video_packet
bios_video_try_teletype:
	cmp	ah,0eh
	jnz	bios_video_try_mode_query
	db	08ah,0c8h				; mov cl,al: original encoding
	mov	al,01fh
	mov	bl,0eh
	call	xios_gateway
	jmp	bios_video_restore_frame

;------------------------------------------------------------------------------
; Mode query uses native XIOS 30, translates its numbering and writes saved AX.
; Saved BH=0: the supported view exposes one BIOS video page.
;------------------------------------------------------------------------------
bios_video_try_mode_query:
	cmp	ah,0fh
	jnz	bios_video_restore_frame
	mov	al,01eh
	mov	ch,01h
	call	xios_gateway
	db	032h,0ffh				; xor bh,bh: original encoding
	cmp	al,010h
	jc	bios_mode_query_text_number
	shr	al,1
	shr	al,1
	shr	al,1
	shr	al,1
	add	al,04h
bios_mode_query_text_number:
	dec	al
	dec	al
	mov	word ptr .bios_frame_ax,ax
	mov	byte ptr .bios_frame_bh,00h

;------------------------------------------------------------------------------
; Restore the complete private frame, then switch back to the application
; stack with interrupts disabled. The original INT frame is consumed by IRET.
;------------------------------------------------------------------------------
bios_video_restore_frame:
	pop	di
	pop	es
	pop	bp
	pop	dx
	pop	ds
	pop	cx
	pop	bx
	pop	ax
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	si
	pop	ds
	iret

;------------------------------------------------------------------------------
; INT 11h equipment: no AX slot is pushed, so returned XIOS AX survives.
; Other listed registers and DS/application stack are restored before IRET.
; This contrasts with the INT 10h packet result path above.
;------------------------------------------------------------------------------
bios_equipment_handler:
	sti
	push	ds
	call	select_console_data
	cli
	mov	word ptr .child_stack_segment,ss
	mov	word ptr .child_stack_offset,sp
	mov	ax,ds
	mov	ss,ax
	mov	sp,bios_frame_ax+2
	sti
	push	bx
	push	cx
	push	dx
	push	di
	mov	ax,022h
	call	xios_gateway
	pop	di
	pop	dx
	pop	cx
	pop	bx
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	ds
	iret

; Decoded 17CFh..1862h: memory and disk BIOS handlers.
; Original offsets and complete handler bytes preserved.

; INT 12h: return the end of the allocated region in KiB (paragraphs / 64).
; This is the recovered allocation-boundary policy, not a fresh hardware query.
bios_memory_handler:
	push	ds
	push	cx
	call	select_console_data
	mov	ax,word ptr .loader_memory_size
	add	ax,word ptr .loader_memory_base
	mov	cl,6
	shr	ax,cl
	pop	cx
	pop	ds
	iret
; INT 13h: AH=2/3/4 translate to native raw read/write/verify packet operations.
; Other selectors return AX=0, CF clear without performing a disk operation.
bios_disk_handler:
	sti
	push	bx
	push	cx
	push	ds
	push	si
	push	di
	push	bp
	push	dx
	push	es
	call	select_console_data
	cmp	ah,2
	jne	bios_disk_try_write
	mov	ah,0
	jmps	bios_disk_packet
bios_disk_try_write:
	cmp	ah,3
	jne	bios_disk_try_verify
	mov	ah,1
	jmps	bios_disk_packet
bios_disk_try_verify:
	cmp	ah,4
	jne	bios_disk_no_operation
	mov	ah,2
	jmps	bios_disk_packet
bios_disk_no_operation:
	mov	ax,0
	clc
	jmps	bios_disk_return
bios_disk_packet:
	mov	byte ptr .raw_disk_operation,ah		; operation
	mov	byte ptr .raw_disk_drive,dl		; drive
	mov	byte ptr .raw_disk_count,al		; sector count
	mov	byte ptr .raw_disk_head,dh		; head
	dec	cl
	mov	byte ptr .raw_disk_sector,cl		; zero-based sector (no high-cylinder extraction)
	mov	byte ptr .raw_disk_cylinder,ch		; cylinder low byte
	mov	word ptr .raw_disk_buffer,bx		; transfer address
	mov	word ptr .raw_disk_segment,es
	mov	dx,05b7h
	push	ds
	mov	es,word ptr .rsp_sysdat_segment
	mov	si,es:word ptr .sd_running_process
	db	026h					; ES override, retain original disp8 encoding
	mov	ax,10h[si]				; running PD's UDA segment
	mov	es,ax
	mov	es:word ptr .02eh,ds			; packet segment passed through caller UDA
	mov	ds,word ptr .rsp_sysdat_segment
	mov	cl,02fh
	callf	dword ptr .020h				; native BDOS raw-disk entry
	pop	ds
	or	al,al
	jz	bios_disk_return
	stc
bios_disk_return:
	pop	es
	pop	dx
	pop	bp
	pop	di
	pop	si
	pop	ds
	pop	cx
	pop	bx
	retf	2					; discard saved FLAGS, retain live carry result


;------------------------------------------------------------------------------
; INT 16h (1863h..18E7h), recovered keyboard handler.
; Select the running console DATA, then use its private service stack. Return
; AX through the saved frame. RETF 2 discards the caller FLAGS: current ZF from
; the input word test is the AH=01h result. This is not an enhanced BIOS API:
; every selector other than 00h/01h falls through to XIOS 33 shift status.
; Native BDOS 6 returns an input word, not necessarily IBM AH=scan/AL=ASCII.
; The per-console one-word lookahead is consumed exactly once by AH=00h.
;------------------------------------------------------------------------------
bios_keyboard_handler:
	push	ds
	push	bx
	call	select_console_data
	mov	word ptr .child_stack_segment,ss
	mov	word ptr .child_stack_offset,sp
	mov	bx,ds
	mov	ss,bx
	mov	sp,dos_saved_ax
	sti
	push	ax
	push	cx
	push	dx
	push	si
	push	es
	push	di
	db	00ah,0e4h				; or ah,ah, recovered encoding
	jz	bios_keyboard_read
	dec	ah
	jz	bios_keyboard_poll
	mov	ax,33
	pushf
	call	xios_gateway
	popf
	mov	word ptr .bios_frame_ax,ax
	jmps	bios_keyboard_return
bios_keyboard_poll:
	mov	ax,word ptr .bios_keyboard_pending
	db	00bh,0c0h				; or ax,ax, recovered encoding
	jnz	bios_keyboard_result
	mov	word ptr .bios_frame_ax,0
	mov	cl,6
	mov	dl,0ffh					; nonblocking BDOS 6 consumes queue word
	pushf
	call	loader_bdos_call
	popf
	db	00bh,0c0h				; zero means no queued input
	jz	bios_keyboard_return
	mov	word ptr .bios_keyboard_pending,ax
	jmps	bios_keyboard_result
bios_keyboard_read:
	mov	ax,word ptr .bios_keyboard_pending
	mov	word ptr .bios_keyboard_pending,0
	db	00bh,0c0h				; or ax,ax, original direction encoding
	jnz	bios_keyboard_result
	pushf
	call	bios_keyboard_wait
	popf
bios_keyboard_result:
	db	00bh,0c0h				; supply AH=01h ZF without changing AX
	mov	word ptr .bios_frame_ax,ax
bios_keyboard_return:
	pop	di
	pop	es
	pop	si
	pop	dx
	pop	cx
	pop	ax
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	bx
	pop	ds
	sti
	retf	2
bios_keyboard_wait:
	push	cx
	mov	cl,6
	mov	dl,0fdh					; blocking raw BDOS console input
	call	loader_bdos_call
	pop	cx
	ret

; Original region 18E8h..1DAAh: printer and initial DOS handlers.

; INT 17h: use the native assigned list device (DX printer selection is ignored).
; AH=0 polls readiness up to 8000h times then writes through direct BIOS.
; AH=1 detaches the native list device; it does not initialize a PC printer.
; AH=2 reports readiness. Return AH through the saved AX slot.
bios_printer_handler:
	push	ds
	push	bx
	call	select_console_data
	mov	word ptr .child_stack_segment,ss
	mov	word ptr .child_stack_offset,sp
	mov	bx,ds
	mov	ss,bx
	mov	sp,dos_saved_ax
	push	ax
	push	cx
	push	dx
	push	si
	push	es
	push	di
	push	ax
	mov	es,cs:word ptr shared_sysdat_segment
	mov	di,es:word ptr .sd_running_process
	db	026h					; ES override, preserve disp8 addressing
	mov	al,024h[di]				; assigned list device in running PD
	mov	byte ptr .printer_bios_device,al
	mov	cl,161					; conditional list attach
	call	loader_bdos_call
	or	al,al
	pop	ax
	jz	printer_attached
	mov	byte ptr .dos_saved_function,1
	jmps	printer_return
printer_attached:
	or	ah,ah
	jnz	printer_try_detach
	mov	cx,08000h
printer_wait_ready:
	push	cx
	mov	byte ptr .printer_bios_function,15	; direct BIOS list status
	mov	dx,printer_bios_function
	mov	cl,50
	push	ax
	call	loader_bdos_call
	pop	bx
	pop	cx
	test	ah,080h
	jnz	printer_write
	db	08bh,0c3h				; mov ax,bx, original encoding
	loop	printer_wait_ready
	or	ah,1
	mov	byte ptr .dos_saved_function,ah
	jmps	printer_return
printer_write:
	mov	byte ptr .printer_bios_function,5	; direct BIOS list output
	mov	byte ptr .printer_bios_character,bl
	mov	dx,printer_bios_function
	mov	cl,50
	call	loader_bdos_call
	mov	byte ptr .dos_saved_function,010h
	jmps	printer_return
printer_try_detach:
	cmp	ah,1
	jne	printer_try_status
	mov	cl,159					; native list detach
	call	loader_bdos_call
	xor	ah,ah
	mov	byte ptr .dos_saved_function,ah
	jmps	printer_return
printer_try_status:
	cmp	ah,2
	jne	printer_return
	mov	byte ptr .printer_bios_function,15
	mov	dx,printer_bios_function
	mov	cl,50
	call	loader_bdos_call
	test	ah,080h
	jnz	printer_ready
	or	ah,010h
	mov	byte ptr .dos_saved_function,ah
	jmps	printer_return
printer_ready:
	or	ah,090h
	mov	byte ptr .dos_saved_function,ah
printer_return:
	pop	di
	pop	es
	pop	si
	pop	dx
	pop	cx
	pop	ax
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	bx
	pop	ds
	iret


; INT 20h / INT 21h AH=0: caller CS identifies its PSP.
; Restore INT 22h..24h from PSP:000Ah, then replace the interrupt return
; address with restored INT 22h. The scheduler return path performs cleanup.
dos_terminate_entry:
	push	ds
	call	select_console_data
	mov	byte ptr .dos_nested_console,0
	pop	ds
	push	bp
	db	08bh,0ech				; mov bp,sp, original encoding
	push	ds
	push	es
	push	si
	push	di
	push	cx
	db	033h,0f6h				; xor si,si, original encoding
	mov	es,si
	mov	di,088h					; INT 22h vector address
	mov	si,00ah					; saved vectors in PSP
	mov	ds,word ptr 4[bp]			; interrupted CS
	push	di
	cld
	mov	cx,6
	rep	movsw
	pop	di
	db	026h					; ES override, no displacement
	mov	si,[di]
	mov	2[bp],si
	db	026h					; ES override, disp8
	mov	si,2[di]
	mov	4[bp],si
	pop	cx
	pop	di
	pop	si
	pop	es
	pop	ds
	pop	bp
	iret


; The PSP far-call segment calculation requires paragraph alignment.
original_trampoline_prefix:
	org	(offset $+15) and 0fff0h
; Adapt the incoming stack frame, move native function CL to DOS AH, then
; jump to the DOS dispatcher. Console-zero initialization writes the far target.
dos_call_trampoline:
	push	bp
	db	08bh,0ech				; mov bp,sp, original direction encoding
	pushf
	pop	ax
	xchg	ax,6[bp]
	mov	2[bp],ax
	pop	bp
	mov	ah,cl
	db	0eah					; JMP FAR immediate; target initialized at runtime
shared_dos_target		dw	0,0
shared_first_data_segment	dw	0
shared_bdos_vector		dw	0,0
shared_previous_dispatch	dw	0,0
shared_xios_entry		dw	xios_service_entry
shared_sysdat_segment		dw	0		; also the segment half of shared_xios_entry


; INT 21h entry. AH=0 uses the PSP termination convention directly.
; Other calls select this console's DATA and save the caller on its private stack.
dos_dispatch_entry:
	or	ah,ah
	jnz	dos_dispatch_frame
	jmp	dos_terminate_handler
dos_dispatch_frame:
	push	ds
	push	ds
	call	select_console_data
	mov	word ptr .child_stack_segment,ss
	mov	word ptr .child_stack_offset,sp
	add	word ptr .child_stack_offset,2
	pop	word ptr .dos_caller_ds
	mov	word ptr .dos_entry_ax,ax
	mov	ax,ds
	mov	ss,ax
	mov	sp,dos_saved_ax
	mov	ax,word ptr .dos_entry_ax
	cmp	byte ptr .dos_nested_console,0ffh
	jne	dos_dispatch_save
	cmp	ah,0ch
	ja	dos_dispatch_clear_nested
	mov	sp,word ptr .dos_nested_stack
	jmps	dos_dispatch_save
dos_dispatch_clear_nested:
	mov	byte ptr .dos_nested_console,0
dos_dispatch_save:
	mov	ds,word ptr .dos_caller_ds
	sti
	push	ax
	push	bx
	push	cx
	push	ds
	push	dx
	push	si
	push	es
	push	di
	push	bp
	mov	bx,ss
	mov	ds,bx
dos_dispatch_select:
	mov	word ptr .dos_saved_ax,ax
	mov	bl,ah
	db	032h,0ffh				; xor bh,bh, original direction encoding
	shl	bx,1
	cmp	bx,offset dos_function_fallback-offset dos_function_table
	jc	dos_dispatch_call
	mov	bx,offset dos_function_fallback-offset dos_function_table					; all AH>=31h use the same fallback
dos_dispatch_call:
	mov	es,word ptr .dos_caller_ds
	call	cs:word ptr dos_function_table[bx]
	pop	bp
	pop	di
	pop	es
	pop	si
	pop	dx
	pop	cx					; discard saved DS, restored below on caller stack
	pop	cx
	pop	bx
	pop	ax
	mov	ax,word ptr .dos_saved_ax
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	ds
	iret
dos_no_service:
	mov	byte ptr .dos_saved_ax,0
	ret


; Default INT 23h: print a newline and terminate through native cleanup.
dos_ctrl_c_handler:
	call	select_console_data
	mov	cl,13
	call	dos_console_character
	mov	cl,10
	call	dos_console_character
	jmp	child_cleanup_entry
; Native file-service adapter. Save AX error context, issue BDOS, then map
; AL=FFh/AH=1 or 2 failures to the DOS critical-error path. Other results return.
file_bdos_checked:
	mov	word ptr .critical_context,ax
file_bdos_retry:
	push	di
	call	loader_bdos_call
	cmp	al,0ffh
	jne	file_bdos_return
	cmp	ah,1
	je	file_bdos_translate_error
	cmp	ah,2
	jne	file_bdos_return
	push	si
	push	bx
	push	cx
	mov	ah,0
	jmps	file_bdos_error_ready
file_bdos_translate_error:
	push	si
	push	bx
	push	cx
	push	es
	mov	es,cs:word ptr shared_sysdat_segment
	mov	si,es:word ptr .sd_running_process
	db	026h					; ES override; retain original instruction addressing
	mov	es,word ptr pd_uda_segment[si]
	mov	bl,es:byte ptr .067h			; native extended disk error in caller UDA
	pop	es
	mov	si,offset native_dos_error_map
	mov	cx,(offset native_dos_error_map_end-offset native_dos_error_map)/2
file_bdos_find_error:
	db	02eh					; CS override for LODSW
	lodsw
	cmp	bl,al
	je	file_bdos_error_ready
	loop	file_bdos_find_error
file_bdos_error_ready:
	pop	cx
	pop	bx
	pop	si
	mov	al,ah
	xor	ah,ah
	db	08bh,0f8h				; mov di,ax, original direction encoding
	mov	ax,word ptr .critical_context
	jmp	dos_critical_error
file_bdos_return:
	pop	di
	ret
; Pairs: native UDA disk-error byte, DOS critical-error index.
native_dos_error_map:
	db	003h,0
	db	080h,1
	db	020h,2
	db	001h,3
	db	010h,4
	db	040h,6
	db	002h,8
	db	004h,8
	db	008h,12
	db	009h,12
native_dos_error_map_end:


; Invoke application INT 24h on the child stack while retaining the private
; BDOS stack and DOS register frame. AX carries context; DI is the error index.
; Permit nested DOS console calls through the saved private stack.
; AL=2 invokes INT 23h; every other reply retries the original BDOS request.
dos_critical_error:
	push	bp
	push	si
	push	bx
	push	ds
	push	es
	call	select_console_data
	push	word ptr .dos_saved_ax
	cli
	mov	word ptr .critical_private_ss,ss
	mov	.dos_nested_stack,sp
	mov	ss,word ptr .child_stack_segment
	mov	sp,.child_stack_offset
	sti
	mov	bx,.child_stack_segment
	mov	.critical_child_ss,bx
	mov	bx,.child_stack_offset
	mov	.critical_child_sp,bx
	pop	bx
	push	word ptr .dos_saved_es
	push	word ptr .dos_caller_ds
	push	word ptr .dos_entry_ax
	push	word ptr .dos_saved_di
	push	word ptr .dos_saved_si
	push	word ptr .bios_frame_dx
	push	word ptr .bios_frame_cx
	push	word ptr .bios_frame_bx
	push	word ptr .bios_frame_ax
	mov	byte ptr .dos_nested_console,0ffh
	int	byte ptr 024h
	call	select_console_data
	mov	byte ptr .dos_nested_console,00h
	pop	word ptr .bios_frame_ax
	pop	word ptr .bios_frame_bx
	pop	word ptr .bios_frame_cx
	pop	word ptr .bios_frame_dx
	pop	word ptr .dos_saved_si
	pop	word ptr .dos_saved_di
	pop	word ptr .dos_entry_ax
	pop	word ptr .dos_caller_ds
	mov	bx,.critical_child_ss
	mov	.child_stack_segment,bx
	mov	bx,.critical_child_sp
	mov	.child_stack_offset,bx
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,.child_stack_offset
	pop	bx
	push	word ptr .dos_caller_ds
	mov	ss,word ptr .critical_private_ss
	mov	sp,.dos_nested_stack
	sti
	pop	word ptr .dos_saved_ax
	pop	es
	pop	ds
	pop	bx
	pop	si
	pop	bp
	cmp	al,02h
	jz	critical_abort
	pop	di
	jmp	file_bdos_retry
critical_abort:
	int	byte ptr 023h
	jmp	dos_dispatch_entry

; Default INT 24h handler: display the indexed error and optional drive context.
; Prompt until A (AL=2, abort) or R (AL=1, retry); return with IRET.
dos_error_handler:
	push	ds
	push	bx
	push	cx
	push	dx
	push	ax
	call	critical_newline
	db	08bh,0dfh				; mov bx,di (original encoding)
	xor	bh,bh
	shl	bx,1
	mov	si,offset critical_message_table
	db	003h,0f3h				; add si,bx (original encoding)
	db	02eh					; CS override; original addressing
	mov	dx,[si]
	push	ds
	mov	ax,cs
	mov	ds,ax
	call	critical_print_string
	pop	ds
	pop	ax
	test	ah,080h
	jz	critical_disk_context
	call	critical_newline
	jmp	critical_prompt
critical_disk_context:
	push	ax
	test	ah,01h
	jnz	critical_write_context
	mov	dx,offset critical_msg_reading
	jmps	critical_print_context
critical_write_context:
	mov	dx,offset critical_msg_writing
critical_print_context:
	push	ds
	mov	ax,cs
	mov	ds,ax
	call	critical_print_string
	mov	dx,offset critical_msg_drive
	call	critical_print_string
	pop	ds
	pop	dx
	add	dl,041h
	mov	ah,02h
	int	byte ptr 021h
	call	critical_newline
critical_prompt:
	mov	dx,offset critical_msg_prompt
	push	ds
	mov	ax,cs
	mov	ds,ax
	call	critical_print_string
	pop	ds
	mov	ah,01h
	int	byte ptr 021h
	cmp	al,060h
	jc	critical_reply
	sub	al,020h
critical_reply:
	mov	dl,al
	cmp	dl,041h
	jnz	critical_try_retry
	mov	al,02h
	jmps	critical_reply_return
critical_try_retry:
	push	dx
	call	critical_newline
	pop	dx
	cmp	dl,052h
	jnz	critical_prompt
	mov	al,01h
critical_reply_return:
	pop	dx
	pop	cx
	pop	bx
	pop	ds
	iret

; DOS-based output helpers used by the nested critical-error handler.
critical_newline:
	mov	dl,0dh
	mov	ah,02h
	int	byte ptr 021h
	mov	dl,0ah
	mov	ah,02h
	int	byte ptr 021h
	ret
critical_print_string:
	mov	ah,09h
	int	byte ptr 021h
	ret

; Thirteen DOS critical-error indices, followed by dollar-terminated text.
critical_message_table:
	dw	offset critical_msg_write_protect
	dw	offset critical_msg_io
	dw	offset critical_msg_not_ready
	dw	offset critical_msg_io
	dw	offset critical_msg_data
	dw	offset critical_msg_io
	dw	offset critical_msg_seek
	dw	offset critical_msg_media
	dw	offset critical_msg_sector
	dw	offset critical_msg_io
	dw	offset critical_msg_io
	dw	offset critical_msg_io
	dw	offset critical_msg_io
critical_msg_write_protect	db	'Write protect error$'
critical_msg_not_ready		db	'Not ready error$'
critical_msg_io			db	'I/O error$'
critical_msg_data		db	'Data error$'
critical_msg_seek		db	'Seek error$'
critical_msg_media		db	'Bad media type$'
critical_msg_sector		db	'Sector not found$'
critical_msg_reading		db	' reading$'
critical_msg_writing		db	' writing$'
critical_msg_drive		db	' drive $'
critical_msg_prompt		db	'Abort or Retry? $'


; INT 25h absolute disk read: AL=drive, CX=count, DX=first sector, DS:BX=buffer.
; Build native direct-BIOS operation 3; INT 26h shares this path with operation 4.
; RETF deliberately leaves the interrupt FLAGS word on the caller stack.
dos_disk_read_handler:
	sti
	push	ds
	push	es
	mov	si,ds
	call	select_console_data
	mov	byte ptr .raw_disk_operation,03h
absolute_disk_packet:
	mov	.raw_disk_drive,al
	mov	.raw_disk_count,cx
	mov	.raw_disk_sector,dx
	mov	.raw_disk_buffer,bx
	mov	.raw_disk_segment,si

; Set the current process UDA DMA segment, then call direct BIOS function 47.
; Native nonzero AL becomes carry set; zero AL leaves carry clear.
	mov	dx,05b7h
	push	ds
	mov	es,word ptr .rsp_sysdat_segment
	mov	si,es:.068h
	db	026h					; ES override; original addressing
	mov	ax,010h[si]
	mov	es,ax
	mov	es:word ptr .02eh,ds
	mov	ds,word ptr .rsp_sysdat_segment
	mov	cl,02fh
	callf	dword ptr .020h
	pop	ds
	or	al,al
	jz	absolute_disk_return
	stc
absolute_disk_return:
	pop	es
	pop	ds
	retf

; INT 26h absolute disk write; use the common packet and return path.
dos_disk_write_handler:
	sti
	push	ds
	push	es
	mov	si,ds
	call	select_console_data
	mov	byte ptr .raw_disk_operation,04h
	jmps	absolute_disk_packet

; INT 27h is an IRET stub; it does not reserve resident memory.
dos_resident_handler:
	iret
; INT 21h character services. DS selects console DATA; saved AX supplies AL.
dos_fn_console_input:
	call	dos_read_echo
	mov	byte ptr .dos_saved_ax,al
	ret
dos_fn_console_output:
	mov	cl,dl
	jmp	console_echo_byte
dos_fn_aux_input:
	ret
dos_fn_aux_output:
	ret
dos_fn_printer_output:
	mov	cl,5
	call	loader_bdos_call
	ret
; AH=06h input changes ZF in the caller's saved FLAGS (SS:SP + 6).
; Output bypasses Ctrl-C/echo processing; DL=FFh selects nonblocking input.
dos_fn_direct_console:
	cmp	dl,0ffh
	jne	dos_direct_output
	les	si,dword ptr .child_stack_offset
	db	026h					; ES override; preserve original disp8 encoding
	or	byte ptr 6[si],040h
	call	dos_poll_character
	jz	dos_direct_input_done
	db	026h					; ES override; retain original instruction addressing
	and	byte ptr 6[si],0bfh
	call	raw_console_input
dos_direct_input_done:
	mov	byte ptr .dos_saved_ax,al
	ret
dos_direct_output:
	mov	cl,dl
	jmp	dos_raw_output
dos_fn_raw_input:
	call	raw_console_input
	mov	byte ptr .dos_saved_ax,al
	ret


; DOS AH=08h: read without echo, with Ctrl-C checking. The recovered INT 23h
; instruction runs on PCTMP's private service stack. The extended reader
; restores the user frame before invoking a custom handler, as AH=01h does.
dos_fn_checked_input:
	call	dos_read_checked
	mov	byte ptr .dos_saved_ax,al		; saved DOS return AL
	ret
	nop
	nop
	nop
	nop
	nop
	nop
; Decoded original region 1DB8h..1E03h.

; AH=09h prints from the application's DS, saved by the dispatcher.
dos_fn_print_string:
	db	08bh,0cah				; mov cx,dx, original direction encoding
	push	ds
	mov	ds,word ptr .dos_caller_ds
	call	dos_print_string
	pop	ds
	ret
dos_fn_buffered_input:
	jmp	dos_read_line
dos_fn_console_status:
	call	dos_checked_status
	mov	byte ptr .dos_saved_ax,al
	ret
; Return one DOS input byte. Extended BIOS keys are returned as 00h followed
; by the scan code on the next read. Consume the per-console pending word.
raw_console_input:
	mov	ax,word ptr .bios_keyboard_pending
	db	00bh,0c0h				; or ax,ax, original direction encoding
	jz	dos_input_wait
	cmp	byte ptr .dos_scan_pending,0ffh
	je	dos_input_scan
	or	al,al
	jnz	dos_input_consumed
	mov	byte ptr .dos_scan_pending,0ffh
	ret
dos_input_scan:
	mov	al,ah
dos_input_consumed:
	mov	byte ptr .dos_scan_pending,0
	mov	word ptr .bios_keyboard_pending,0
	ret
dos_input_wait:
	call	bios_keyboard_wait
	or	al,al
	jnz	dos_input_return
	mov	byte ptr .dos_scan_pending,0ffh
	mov	word ptr .bios_keyboard_pending,ax
dos_input_return:
	ret


;------------------------------------------------------------------------------
; dos_read_echo (1E04h), used by INT 21h/AH=01h.
; Read a byte, classify it for echo, then return AL. The recovered original
; omitted Ctrl-C detection here although its AH=08h handler already checks it.
; The extended variant uses the common INT 23h stack-unwind path. BIOS
; reads and DOS raw input (AH=06h/07h) continue using the original raw reader.
;------------------------------------------------------------------------------
dos_read_echo:
	call	dos_read_checked
	call	classify_echo_byte			; classify echoable character; CF=control
	jc	control_echo_return			; shared RET, control byte needs no echo
	push	ax
	db	08ah,0c8h				; mov cl,al: original encoding
	call	console_echo_byte			; console echo helper
	pop	ax
	ret
; Decoded original region 1E14h..207Ch.

; CR, LF, TAB and BS may be echoed. Other controls below space set carry.
classify_echo_byte:
	cmp	al,13
	je	control_echo_return
	cmp	al,10
	je	control_echo_return
	cmp	al,9
	je	control_echo_return
	cmp	al,8
	je	control_echo_return
	cmp	al,020h
control_echo_return:
	ret


; Poll with DOS Ctrl-C and Ctrl-S/Ctrl-Q handling. Preserve an ordinary key
; in the pending word; AL=FFh means available, AL=0 means none/resumed.
dos_checked_status:
	call	dos_poll_character
	jz	dos_status_return
	call	raw_console_input
	cmp	al,3
	jne	dos_status_try_pause
	mov	word ptr .bios_keyboard_pending,0
	jmp	unwind_dos_break
dos_status_try_pause:
	cmp	al,013h
	jne	dos_status_pending
dos_status_paused:
	call	raw_console_input
	cmp	al,3
	jne	dos_status_try_resume
	mov	word ptr .bios_keyboard_pending,0
	jmp	unwind_dos_break
dos_status_try_resume:
	cmp	al,011h
	jne	dos_status_paused
	db	033h,0c0h				; xor ax,ax, original direction encoding
	mov	word ptr .bios_keyboard_pending,0
dos_status_return:
	ret
dos_status_pending:
	mov	word ptr .bios_keyboard_pending,ax
	mov	al,0ffh
	ret
; Output CL unless suppressed, check pause/break, optionally echo to printer.
; Maintain the byte column used for tab expansion and buffered-line redraw.
dos_console_character:
	test	byte ptr .dos_output_suppressed,0ffh
	jnz	dos_count_column
	call	dos_checked_status
	call	dos_raw_output
	test	byte ptr .dos_printer_echo,0ffh
	jz	dos_count_column
	push	cx
	call	dos_echo_to_printer
	pop	cx
dos_count_column:
	mov	al,cl
	cmp	al,07fh
	je	dos_column_return
	inc	byte ptr .dos_output_column
	cmp	al,020h
	jnc	dos_column_return
	dec	byte ptr .dos_output_column
	jz	dos_column_return
	cmp	al,8
	jne	dos_column_try_newline
	dec	byte ptr .dos_output_column
dos_column_return:
	ret
dos_column_try_newline:
	cmp	al,10
	jne	dos_column_done
	mov	byte ptr .dos_output_column,0
dos_column_done:
	ret
; Display control characters as caret notation; ordinary characters and tabs
; continue through the normal echo path.
dos_echo_control:
	mov	al,cl
	call	classify_echo_byte
	jnc	console_echo_byte
	push	ax
	mov	cl,'^'
	call	dos_console_character
	pop	cx
	or	cl,040h
console_echo_byte:
	cmp	cl,9
	jne	dos_console_character
dos_expand_tab:
	mov	cl,' '
	call	dos_console_character
	mov	al,byte ptr .dos_output_column
	and	al,7
	jnz	dos_expand_tab
dos_echo_return:
	ret
; Erase one displayed cell using backspace-space-backspace.
dos_erase_cell:
	call	dos_backspace
	mov	cl,' '
	call	dos_raw_output
dos_backspace:
	mov	cl,8
	jmp	dos_raw_output
; Cancel/restart a displayed line: print #, newline, then indent to its origin.
dos_restart_line:
	mov	cl,'#'
	call	dos_console_character
	call	dos_console_newline
dos_indent_line:
	mov	al,byte ptr .dos_output_column
	cmp	al,byte ptr .dos_line_origin
	jnc	dos_echo_return
	mov	cl,' '
	call	dos_console_character
	jmps	dos_indent_line
dos_console_newline:
	mov	cl,13
	call	dos_console_character
	mov	cl,10
	jmp	dos_console_character
; Print a dollar-terminated string at application DS:CX. Switch to private
; DATA only around console processing; leave CX on the terminator.
dos_print_string:
	db	08bh,0f1h				; mov si,cx, original direction encoding
	lodsb
	cmp	al,'$'
	je	dos_echo_return
	inc	cx
	push	cx
	mov	cl,al
	push	ds
	push	ss
	pop	ds
	call	console_echo_byte
	pop	ds
	pop	cx
	jmps	dos_print_string


; AH=0Ah: edit application ES:DX buffer. CL=max length, CH=current count.
; Save the initial column for erasure/redraw. The private stack retains the
; buffer count-byte address while BX advances through entered characters.
dos_read_line:
	mov	al,.dos_output_column
	mov	.dos_line_origin,al
	mov	bx,.bios_frame_dx
	db	026h					; ES override; retain original addressing
	mov	cl,[bx]
	inc	bx
	push	bx
	mov	ch,00h
dos_line_next_key:
	push	cx
	push	bx
dos_line_read_key:
	call	raw_console_input
	pop	bx
	pop	cx
	cmp	al,0dh
	jnz	dos_line_try_lf
dos_line_accept_jump:
	jmp	dos_line_accept
dos_line_try_lf:
	cmp	al,0ah
	jz	dos_line_accept_jump
	cmp	al,08h
	jnz	dos_line_try_delete
	or	ch,ch
	jz	dos_line_next_key
	dec	ch
	mov	al,.dos_output_column
	mov	.dos_output_suppressed,al
	jmp	dos_line_redraw
dos_line_try_delete:
	cmp	al,07fh
	jnz	dos_line_try_ctrl_e
	or	ch,ch
	jz	dos_line_next_key
	db	026h					; ES override; retain original addressing
	mov	al,[bx]
	dec	ch
	dec	bx
	jmp	dos_line_echo
dos_line_try_ctrl_e:
	cmp	al,05h
	jnz	dos_line_try_ctrl_p
	push	cx
	push	bx
	call	dos_console_newline
	mov	byte ptr .dos_line_origin,00h
dos_line_resume_read:
	jmps	dos_line_read_key
dos_line_try_ctrl_p:
	cmp	al,010h
	jz	dos_line_toggle_printer
	jmp	dos_line_try_ctrl_x

; Ctrl-P toggles native printer echo through SYSDAT console/list descriptors.
; The recovered structure strides are 2Ch (console) and 0Ah (list).
; Preserve these offsets pending comparison with the native CIO layouts.
dos_line_toggle_printer:
	push	cx
	push	bx
	db	033h,0c9h				; xor cx,cx (original encoding)
	db	08bh,0d9h				; mov bx,cx (original encoding)
	push	es
	mov	es,cs:word ptr shared_sysdat_segment
	mov	si,es:.sd_running_process
	db	026h					; ES override; retain original addressing
	mov	bl,024h[si]
	mov	.dos_list_number,bl
	mov	si,xios_list_table
	db	026h					; ES override; retain original addressing
	mov	di,[si]
	dec	si
	dec	si
	db	026h					; ES override; retain original addressing
	mov	si,[si]
	mov	cl,.dos_console_number
	mov	ax,02ch
	mul	cl
	db	003h,0f0h				; add si,ax (original encoding)
	mov	ax,0ah
	mul	bl
	db	003h,0f8h				; add di,ax (original encoding)
	test	byte ptr .dos_printer_echo,0ffh
	jz	dos_line_attach_printer
	db	026h					; ES override; retain original addressing
	mov	word ptr [di],00h
	db	026h					; ES override; retain original addressing
	mov	byte ptr 09h[di],0ffh
	db	026h					; ES override; retain original addressing
	mov	byte ptr 08h[si],0ffh
	db	026h					; ES override; retain original addressing
	and	word ptr 0eh[si],0fdffh
	mov	byte ptr .dos_printer_echo,00h
	jmps	dos_line_printer_done
dos_line_attach_printer:
	db	026h					; ES override; retain original addressing
	cmp	word ptr [di],00h
	jz	dos_line_printer_available
	mov	cx,printer_busy_message_offset
	call	dos_print_string
	jmps	dos_line_printer_done
dos_line_printer_available:
	db	026h					; ES override; retain original addressing
	mov	word ptr [di],0ffffh
	db	026h					; ES override; retain original addressing
	mov	09h[di],cl
	db	026h					; ES override; retain original addressing
	mov	08h[si],bl
	db	026h					; ES override; retain original addressing
	or	word ptr 0eh[si],0200h
	mov	byte ptr .dos_printer_echo,0ffh
dos_line_printer_done:
	pop	es
	pop	bx
	pop	cx
	jmp	dos_line_next_key

; Ctrl-X erases to the input origin; Ctrl-U starts a new line; Ctrl-R redraws.
dos_line_try_ctrl_x:
	cmp	al,018h
	jnz	dos_line_try_ctrl_u
	pop	bx
dos_line_erase_to_origin:
	mov	al,.dos_line_origin
	cmp	al,.dos_output_column
	jnc	dos_line_restart
	dec	byte ptr .dos_output_column
	call	dos_erase_cell
	jmps	dos_line_erase_to_origin
dos_line_try_ctrl_u:
	cmp	al,015h
	jnz	dos_line_try_ctrl_r
	call	dos_restart_line
	pop	bx
dos_line_restart:
	jmp	dos_read_line
dos_line_try_ctrl_r:
	cmp	al,012h
	jnz	dos_line_try_ctrl_c
dos_line_redraw:
	push	cx
	call	dos_restart_line
	pop	cx
	pop	bx
	push	bx
	push	cx
dos_line_replay:
	or	ch,ch
	jz	dos_line_replay_done
	inc	bx
	db	026h					; ES override; retain original addressing
	mov	cl,[bx]
	dec	ch
	push	cx
	push	bx
	call	dos_echo_control
	pop	bx
	pop	cx
	jmp	dos_line_replay
dos_line_replay_done:
	push	bx
	mov	al,.dos_output_suppressed
	or	al,al
	jz	dos_line_replay_resume
	sub	al,.dos_output_column
	mov	.dos_output_suppressed,al
dos_line_erase_excess:
	call	dos_erase_cell
	dec	byte ptr .dos_output_suppressed
	jnz	dos_line_erase_excess
dos_line_replay_resume:
	jmp	dos_line_resume_read
dos_line_try_ctrl_c:
	cmp	al,03h
	jnz	dos_line_store
	mov	ax,ds
	mov	es,ax
	jmp	unwind_dos_break
dos_line_store:
	cmp	ch,cl
	jnc	dos_line_continue
	inc	bx
	db	026h					; ES override; retain original addressing
	mov	[bx],al
	inc	ch
dos_line_echo:
	push	cx
	push	bx
	mov	cl,al
	call	dos_echo_control
	pop	bx
	pop	cx
dos_line_continue:
	jmp	dos_line_next_key

; Append CR after the text and store CH in the caller buffer count byte.
dos_line_accept:
	inc	bx
	db	026h					; ES override; retain original addressing
	mov	byte ptr [bx],0dh
	pop	bx
	db	026h					; ES override; retain original addressing
	mov	[bx],ch
	mov	ax,ds
	mov	es,ax
	mov	cl,0dh
	jmp	dos_console_character

; Ctrl-C unwind (207Dh). Discard the private DOS service stack and restore
; the saved application register frame, SS:SP and DS before calling INT 23h.
; The original terminates even when a custom handler returns. The extended
; variant retries INT 21h with the restored application registers and untouched
; original interrupt frame, matching the DOS 1.x continuation convention.
unwind_dos_break:
	mov	sp,429h					; saved INT 21h register frame in PCTMP DATA
	pop	bp
	pop	di
	pop	es
	pop	si
	pop	dx
	pop	cx
	pop	cx					; discard saved DS slot; restored below
	pop	bx
	pop	ax
	cli
	mov	ss,word ptr .child_stack_segment
	mov	sp,word ptr .child_stack_offset
	pop	ds
	sti
	int	23h
	jmp	dos_dispatch_handler			; retry request if the handler returns


; Return buffered key AX or native direct-console status; ZF indicates empty.
dos_poll_character:
	mov	ax,word ptr .bios_keyboard_pending
	db	00bh,0c0h				; or ax,ax, original direction encoding
	jnz	dos_poll_return
	push	cx
	mov	dl,0feh
	mov	cl,6
	call	loader_bdos_call
	pop	cx
	or	al,al
dos_poll_return:
	ret
; Write CL through native direct console, preserving CX.
dos_raw_output:
	push	cx
	mov	dl,cl
	mov	cl,6
	call	loader_bdos_call
	pop	cx
	ret
; AH=0Ch drains native console input, then accepts only AL=1,6,7,8,0Ah.
; Redispatch without a second interrupt frame by dropping this near return.
dos_fn_flush_input:
	mov	word ptr .bios_keyboard_pending,0
	mov	byte ptr .dos_scan_pending,0
	push	ax
dos_flush_next:
	mov	cl,6
	mov	dl,0ffh
	call	loader_bdos_call
	or	ax,ax
	jnz	dos_flush_next
	pop	ax
	cmp	al,1
	je	dos_flush_dispatch
	cmp	al,6
	je	dos_flush_dispatch
	cmp	al,7
	je	dos_flush_dispatch
	cmp	al,8
	je	dos_flush_dispatch
	cmp	al,0ah
	je	dos_flush_dispatch
	mov	byte ptr .dos_saved_ax,0
	ret
dos_flush_dispatch:
	mov	ah,al
	inc	sp
	inc	sp
	jmp	dos_dispatch_select


; AH=0Dh: flush native buffers (48), reset disks (13), reset DOS DTA to ES:0080h.
dos_fn_disk_reset:
	mov	cl,030h
	mov	ax,03h
	call	file_bdos_checked
	mov	cl,0dh
	call	loader_bdos_call
	mov	dx,080h
	jmp	dos_fn_set_dta

; AH=0Eh: select DL through native BDOS 14, then count nonzero DPH pointers
; in the sixteen-entry XIOS drive table. Return that count in application AL.
dos_fn_select_drive:
	mov	cl,0eh
	mov	ah,04h
	mov	al,dl
	call	file_bdos_checked
	mov	.dos_current_drive,dl
	mov	.dos_working_drive,dl
	mov	es,cs:word ptr shared_sysdat_segment
	mov	si,xios_disk_table
	mov	cx,010h
	xor	bl,bl
count_present_drives:
	db	026h					; ES override for LODSW
	lodsw
	or	ax,ax
	jz	count_next_drive
	inc	bl
count_next_drive:
	loop	count_present_drives
	mov	.dos_saved_ax,bl
	ret

; Match the application FCB name against six eight-character DOS device names.
; Ignore attribute bits and ASCII case; reject a leading question mark.
; Return/save the device identifier in AL (zero means ordinary file).
match_dos_device:
	xor	al,al
	db	08bh,0feh				; mov di,si (original encoding)
	db	026h					; ES override; original addressing
	cmp	byte ptr 01h[si],03fh
	jz	device_name_result
	inc	si
	mov	di,offset dos_device_names
compare_device_name:
	push	di
	push	si
	mov	cx,08h
compare_device_character:
	db	026h					; ES override for LODSB
	lodsb
	and	al,07fh
	cmp	al,061h
	jc	compare_device_uppercase
	cmp	al,07ah
	ja	compare_device_uppercase
	and	al,05fh
compare_device_uppercase:
	db	02eh					; CS override; original addressing
	cmp	[di],al
	jnz	device_name_compared
	inc	di
	loop	compare_device_character
device_name_compared:
	pop	si
	or	cx,cx
	jz	device_name_matched
	pop	di
	add	di,09h
	cmp	di,offset dos_device_names_end
	jnz	compare_device_name
	dec	si
	db	08bh,0feh				; mov di,si (original encoding)
	xor	al,al
	jmps	device_name_result
device_name_matched:
	db	02eh					; CS override; original addressing
	mov	al,[di]
	pop	di
	dec	si
	db	08bh,0feh				; mov di,si (original encoding)
device_name_result:
	mov	.dos_device_id,al
	or	al,al
	ret


; AH=0Fh/16h: open/create DOS FCB. Clear 21 state bytes at +0Ch and set
; record size to 128. Resolve default drive, then detect named devices.
dos_fn_open_fcb:
	mov	byte ptr .dos_saved_ax,00h
	call	select_dos_fcb
	add	di,0ch
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	cx,015h
	rep	stosb
	db	026h					; ES override; original addressing
	mov	word ptr 0eh[si],080h
	call	resolve_default_fcb_drive
	call	match_dos_device
	jz	open_regular_file
	db	026h					; ES override; original addressing
	mov	018h[di],al
	call	file_timestamp_zero
	db	026h					; ES override; original addressing
	mov	014h[di],dx
	db	026h					; ES override; original addressing
	mov	016h[di],cx
	ret

; Create first deletes an existing file. Open reuses a matching private slot
; after closing it, or allocates a new slot. Cache state is invalidated on reuse.
open_regular_file:
	cmp	byte ptr .dos_saved_function,016h
	jnz	open_find_existing_slot
	push	word ptr .bios_frame_ax
	push	word ptr .dos_saved_ax
	call	dos_fn_delete_fcb
	pop	word ptr .dos_saved_ax
	pop	word ptr .bios_frame_ax
; A missing target is allowed, but a failed dirty-cache flush is not.
	cmp	byte ptr .record_cache_dirty,0ffh
	jne	open_create_ready
	cmp	byte ptr .record_cache_result,0
	je	open_create_ready
	mov	byte ptr .dos_saved_ax,0ffh
	ret
open_create_ready:
	jmps	open_allocate_slot
open_find_existing_slot:
	call	find_fcb_slot
	jnz	open_allocate_slot
	mov	bx,.dos_fcb_slot
	cmp	bx,.cached_fcb_slot
	jnz	open_close_existing_slot
	push	bx
	push	di
	push	es
	call	flush_record_cache
	pop	es
	pop	di
	pop	bx
	or	al,al
	jz	open_cache_flushed
	mov	byte ptr .dos_saved_ax,0ffh
	ret
open_cache_flushed:
	mov	byte ptr .record_cache_valid,00h
	mov	byte ptr .record_cache_dirty,00h
open_close_existing_slot:
	db	08bh,0d3h				; mov dx,bx (original encoding)
	push	bx
	mov	cl,010h
	mov	al,[bx]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	pop	bx
	mov	word ptr 0ch[bx],00h
	mov	word ptr 0eh[bx],00h
	jmps	open_issue_request
open_allocate_slot:
	call	allocate_fcb_slot
	jz	open_issue_request
	jmp	open_fcb_failed

; Native open/create share DOS function numbers 0Fh/16h. Save open/create
; mode in private FCB current-record byte, then issue the checked request.
open_issue_request:
	mov	bx,.dos_fcb_slot
	mov	cl,.dos_saved_function
	mov	byte ptr 020h[bx],00h
	mov	ah,05h
	cmp	cl,016h
	jz	open_request_ready
	mov	byte ptr 020h[bx],0ffh
	mov	ah,04h
open_request_ready:
	db	08bh,0d3h				; mov dx,bx (original encoding)
	mov	al,[bx]
	dec	al
	call	file_bdos_checked
	db	08bh,0dah				; mov bx,dx (original encoding)
	cmp	al,0ffh
	jz	open_release_failed_slot
	mov	si,.dos_fcb_slot
	db	08bh,0deh				; mov bx,si (original encoding)
	call	check_device_fcb
	jz	open_collect_metadata
	test	byte ptr 010h[si],02h
	jz	open_collect_metadata
	call	close_native_slot
	jmps	open_release_failed_slot

; Copy the normalized filename to metadata scratch; obtain date/time and size
; and write DOS FCB fields +14h/+16h and +10h/+12h respectively.
open_collect_metadata:
	push	di
	push	es
	mov	ax,ds
	mov	es,ax
	mov	cx,06h
	mov	di,metadata_fcb_offset
	rep	movsw
	pop	es
	pop	di
	db	08bh,0f2h				; mov si,dx (original encoding)
	push	si
	call	native_file_timestamp
	db	026h					; ES override; original addressing
	mov	014h[di],dx
	db	026h					; ES override; original addressing
	mov	016h[di],cx
	pop	si
	db	08bh,0d6h				; mov dx,si (original encoding)
	call	native_file_size_bytes
	mov	byte ptr 020h[si],00h
	db	026h					; ES override; original addressing
	mov	010h[di],ax
	db	026h					; ES override; original addressing
	mov	012h[di],dx
	ret
open_release_failed_slot:
	call	release_fcb_slot
open_fcb_failed:
	mov	byte ptr .dos_saved_ax,0ffh
	ret

; Return native file size in DX:AX bytes. BDOS 35 supplies 128-byte records;
; subtract unused final-record bytes when an exact byte count is recorded.
; Internal device FCBs carry their size directly at +1Ch.
native_file_size_bytes:
	db	08bh,0deh				; mov bx,si (original encoding)
	call	check_device_fcb
	jnz	file_size_device
	mov	cl,023h
	mov	dx,metadata_fcb_offset
	mov	al,.metadata_fcb_offset
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	cmp	al,0ffh
	jz	file_size_failed
	push	si
	db	08bh,0f2h				; mov si,dx (original encoding)
	mov	ax,021h[si]
	mov	dl,023h[si]
	xor	dh,dh
	call	records_to_bytes
	pop	si
	mov	cl,020h[si]
	cmp	byte ptr .dos_saved_function,011h
	jz	file_size_search_tail
	cmp	byte ptr .dos_saved_function,012h
	jnz	file_size_adjust_tail
file_size_search_tail:
	mov	cl,0dh[si]
file_size_adjust_tail:
	or	cl,cl
	jz	file_size_return
	mov	bx,080h
	sub	bl,cl
	db	02bh,0c3h				; sub ax,bx (original encoding)
	sbb	dx,00h
file_size_return:
	ret
file_size_device:
	mov	ax,01ch[si]
	mov	dx,01eh[si]
	ret
file_size_failed:
	mov	al,0ffh
	ret

; Obtain DOS packed timestamp. Query directory mode (101) unless find-next,
; then read file stamps (102): prefer modification, otherwise creation.
; Missing or zero stamps return CX=DX=0; internal device fields bypass BDOS.
native_file_timestamp:
	db	08bh,0deh				; mov bx,si (original encoding)
	call	check_device_fcb
	jnz	file_timestamp_device
	cmp	byte ptr .dos_saved_function,012h
	jz	file_timestamp_read
	mov	dl,.metadata_fcb_offset
	dec	dl
	mov	cl,065h
	mov	al,dl
	mov	ah,04h
	call	file_bdos_checked
	mov	.directory_timestamp_mode,al
file_timestamp_read:
	mov	cl,066h
	mov	dx,metadata_fcb_offset
	db	08bh,0f2h				; mov si,dx (original encoding)
	mov	al,.metadata_fcb_offset
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	or	al,al
	jnz	file_timestamp_zero
	test	byte ptr .directory_timestamp_mode,020h
	jz	file_timestamp_creation
	mov	ax,01ch[si]
	mov	bx,01eh[si]
	jmps	file_timestamp_convert
file_timestamp_creation:
	test	byte ptr .directory_timestamp_mode,010h
	jz	file_timestamp_zero
	mov	ax,018h[si]
	mov	bx,01ah[si]
file_timestamp_convert:
	push	ax
	or	ax,bx
	pop	ax
	jz	file_timestamp_zero
	push	bx
	call	pack_dos_date
	db	08bh,0d0h				; mov dx,ax (original encoding)
	pop	ax
	call	pack_dos_time
	db	08bh,0c8h				; mov cx,ax (original encoding)
	ret
file_timestamp_zero:
	db	033h,0c9h				; xor cx,cx (original encoding)
	db	08bh,0d1h				; mov dx,cx (original encoding)
	ret
file_timestamp_device:
	mov	ax,018h[si]
	db	08bh,0d0h				; mov dx,ax (original encoding)
	mov	ax,016h[si]
	db	08bh,0c8h				; mov cx,ax (original encoding)
	ret

; Pack native day word AX into DOS date AX: year since 1980, month and day.
; Preserve SI/DI; native_days_to_date supplies the calendar conversion.
pack_dos_date:
	push	si
	push	di
	call	native_days_to_date
	pop	di
	sub	cx,07bch
	db	033h,0c0h				; xor ax,ax (original encoding)
	db	08bh,0d8h				; mov bx,ax (original encoding)
	mov	ah,cl
	shl	ax,1
	mov	bl,dh
	mov	cl,05h
	shl	bx,cl
	or	ax,bx
	xor	dh,dh
	or	ax,dx
	pop	si
	ret

; Pack BCD hour/minute word AX into DOS time AX; seconds remain zero.
; Preserve DX; destroy BX/CX as part of BCD conversion.
pack_dos_time:
	push	dx
	push	ax
	call	bcd_to_binary
	mov	ah,al
	xor	al,al
	shl	ah,1
	shl	ah,1
	shl	ah,1
	db	08bh,0d0h				; mov dx,ax (original encoding)
	pop	ax
	mov	al,ah
	call	bcd_to_binary
	xor	ah,ah
	mov	cl,05h
	shl	ax,cl
	or	ax,dx
	pop	dx
	ret

; FCB drive zero selects current native disk; normalize it to one-based form.
resolve_default_fcb_drive:
	db	026h					; ES override; original addressing
	cmp	byte ptr [si],00h
	jnz	fcb_drive_resolved
	mov	cl,019h
	call	loader_bdos_call
	mov	.dos_current_drive,al
	mov	.dos_working_drive,al
	inc	al
	db	026h					; ES override; original addressing
	mov	[si],al
fcb_drive_resolved:
	ret

; AH=10h: close. Named devices and absent private slots return success.
; Flush cached data. Modified files pad a partial 128-byte record with Ctrl-Z,
; close, and store the final byte count through native attributes (30).
dos_fn_close_fcb:
	call	select_dos_fcb
close_resolved_fcb:
	mov	byte ptr .dos_saved_ax,00h
	call	application_fcb_device
	jz	close_find_slot
	jmp	close_fcb_done
close_find_slot:
	call	find_fcb_slot
	jz	close_check_cache
	jmp	close_fcb_done
close_check_cache:
	mov	bx,.dos_fcb_slot
	cmp	bx,.cached_fcb_slot
	jnz	close_check_modified
	push	bx
	push	di
	push	es
	call	flush_record_cache
	pop	es
	pop	di
	pop	bx
	or	al,al
	jz	close_check_modified
	mov	byte ptr .dos_saved_ax,0ffh
	ret
close_check_modified:
	test	byte ptr 0eh[bx],040h
	jz	close_unmodified_file
	db	026h					; ES override; original addressing
	mov	ax,010h[di]
	db	026h					; ES override; original addressing
	mov	dx,012h[di]
	call	bytes_to_records
	or	ch,ch
	jz	close_flush_final_record
	mov	021h[bx],ax
	mov	023h[bx],dl
	push	cx
	push	bx
	call	read_record_cache
	pop	bx
	pop	cx
	or	al,al
	jnz	close_fcb_failed
	mov	byte ptr .record_cache_dirty,0ffh
	mov	al,ch
	xor	ah,ah
	db	08bh,0f8h				; mov di,ax (original encoding)
close_pad_final_record:
	mov	byte ptr exe_header[di],01ah
	inc	di
	cmp	di,080h
	jnz	close_pad_final_record
close_flush_final_record:
	cmp	bx,.cached_fcb_slot
	jnz	close_update_attributes
	push	bx
	push	cx
	call	flush_record_cache
	pop	cx
	pop	bx
	or	al,al
	jz	close_update_attributes
	mov	byte ptr .dos_saved_ax,0ffh
	ret
close_update_attributes:
	push	cx
	call	close_native_slot
	pop	cx
	cmp	al,0ffh
	jz	close_fcb_failed
	or	byte ptr 06h[bx],080h
	mov	020h[bx],ch
	mov	cl,01eh
	mov	al,[bx]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	jmps	close_release_slot
close_fcb_failed:
	mov	byte ptr .dos_saved_ax,0ffh
close_release_slot:
	jmp	release_fcb_slot
close_fcb_done:
	ret
close_unmodified_file:
	call	close_native_slot
	cmp	al,0ffh
	jz	close_fcb_failed
	jmp	release_fcb_slot

; Close private native FCB DS:BX with write-error context; preserve BX.
close_native_slot:
	db	08bh,0d3h				; mov dx,bx (original encoding)
	push	bx
	mov	cl,010h
	mov	al,[bx]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	pop	bx
	ret


; AH=11h/12h: find first/next. Normalize search FCB, restore saved native
; search position for next, filter attributes and build the DOS DTA result.
; Preserve native search state while metadata queries run; restore DTA at exit.
dos_fn_find_first:
	mov	byte ptr .dos_saved_ax,00h
	call	select_dos_fcb
	call	prepare_directory_search
	jnz	find_failed
	cmp	byte ptr .dos_saved_function,012h
	jnz	find_dispatch_device
	call	restore_find_position
find_dispatch_device:
	mov	si,metadata_fcb_offset
	call	match_dos_device
	jnz	find_named_device
	call	search_matching_attributes
	jnz	find_failed
	inc	di
	push	si
	inc	si
	mov	cx,06h
	rep	movsw
	call	build_find_result
	call	save_find_position
	call	save_native_directory_state
	pop	si
	push	si
	call	native_file_timestamp
	db	026h					; ES override; original addressing
	mov	017h[di],cx
	db	026h					; ES override; original addressing
	mov	019h[di],dx
	mov	byte ptr .metadata_fcb_offset_32,00h
	pop	si
	call	native_file_size_bytes
	db	026h					; ES override; original addressing
	mov	01dh[di],ax
	db	026h					; ES override; original addressing
	mov	01fh[di],dx
	call	restore_native_directory_state
	jmps	find_restore_dma

; Named device search succeeds only for find-first, with zero date/time.
find_named_device:
	cmp	byte ptr .dos_saved_function,011h
	jnz	find_failed
	mov	byte ptr .directory_dos_attributes,00h
	call	build_find_result
	call	file_timestamp_zero
	db	026h					; ES override; original addressing
	mov	017h[di],cx
	db	026h					; ES override; original addressing
	mov	019h[di],dx
	jmps	find_restore_dma
find_failed:
	mov	byte ptr .dos_saved_ax,0ffh
find_restore_dma:
	les	dx,dword ptr .dos_dta_offset
	jmp	set_loader_dma

; Build ordinary or extended DOS search result at DTA. Copy twelve name
; bytes without native attribute bits, add DOS attributes, clear result state.
build_find_result:
	les	di,dword ptr .dos_dta_offset
	mov	si,metadata_fcb_offset
	cmp	byte ptr .dos_extended_fcb,0ffh
	jnz	find_copy_name
	mov	ax,0ffh
	stosw
	db	033h,0c0h				; xor ax,ax (original encoding)
	stosw
	stosw
	mov	al,.dos_fcb_attribute
	stosb
find_copy_name:
	push	di
	mov	cx,0ch
find_copy_character:
	lodsb
	and	al,07fh
	stosb
	loop	find_copy_character
	mov	al,.directory_dos_attributes
	stosb
	mov	cx,013h
	db	033h,0c0h				; xor ax,ax (original encoding)
	rep	stosb
	pop	di
	ret

; Normalize application FCB into metadata scratch and resolve default drive.
; Flush/invalidate the record cache; direct native DMA to the directory buffer.
prepare_directory_search:
	mov	ax,es
	mov	bx,ds
	mov	ds,ax
	mov	es,bx
	mov	di,metadata_fcb_offset
	call	copy_normalized_fcb
	mov	ax,es
	mov	ds,ax
	mov	si,metadata_fcb_offset
	call	resolve_default_fcb_drive
	call	flush_record_cache
	mov	al,.record_cache_result
	test	al,0ffh
	jnz	directory_prepare_result
	mov	byte ptr .record_cache_valid,00h
	mov	dx,exe_header
	call	set_loader_dma
	xor	al,al
directory_prepare_result:
	or	al,al
	ret

; Search native entries and translate RO/SYS/archive bits into DOS attributes.
; The original special-entry marker also supplies hidden/subdirectory bits.
; Apply the original attribute filter; volume-label requests take a separate path.
search_matching_attributes:
	db	08bh,0feh				; mov di,si (original encoding)
	test	byte ptr .dos_fcb_attribute,08h
	jz	search_attribute_first
	jmp	search_volume_label
search_attribute_first:
	mov	cl,.dos_saved_function
search_attribute_next:
	call	native_directory_search
	cmp	al,0ffh
	jnz	translate_directory_attributes
	jmp	directory_match_result
translate_directory_attributes:
	mov	byte ptr .directory_dos_attributes,00h
	test	byte ptr 09h[si],080h
	jz	directory_system_attribute
	or	byte ptr .directory_dos_attributes,01h
directory_system_attribute:
	test	byte ptr 0ah[si],080h
	jz	directory_archive_attribute
	or	byte ptr .directory_dos_attributes,04h
directory_archive_attribute:
	test	byte ptr 0bh[si],080h
	jnz	directory_extended_attributes
	or	byte ptr .directory_dos_attributes,020h
directory_extended_attributes:
	mov	ax,010h[si]
	cmp	ah,al
	jnz	directory_filter_attributes
	test	al,080h
	jz	directory_filter_attributes
	test	al,020h
	jz	directory_subdirectory_attribute
	or	byte ptr .directory_dos_attributes,02h
directory_subdirectory_attribute:
	test	al,040h
	jz	directory_filter_attributes
	or	byte ptr .directory_dos_attributes,010h
directory_filter_attributes:
	mov	al,.dos_fcb_attribute
	and	al,016h
	cmp	al,00h
	jz	directory_filter_normal
	mov	ah,.directory_dos_attributes
	and	ah,016h
	cmp	ah,00h
	jz	directory_match
	cmp	ah,al
	jz	directory_match
	jmps	directory_skip_entry
directory_filter_normal:
	test	byte ptr .directory_dos_attributes,01eh
	jz	directory_match
directory_skip_entry:
	mov	cl,012h
	jmp	search_attribute_next
directory_match:
	db	033h,0c0h				; xor ax,ax (original encoding)
directory_match_result:
	or	al,al
	ret

; Volume-label search: select target disk, scan all-user entries for user 20h,
; restore default disk and return attribute 08h on success.
search_volume_label:
	mov	cl,0eh
	mov	dl,[di]
	dec	dl
	mov	.dos_working_drive,dl
	call	loader_bdos_call
	mov	byte ptr [di],03fh
	mov	cl,011h
volume_label_next:
	call	native_directory_search
	cmp	al,0ffh
	jz	volume_label_restore_drive
	mov	cl,012h
	cmp	byte ptr [si],020h
	jnz	volume_label_next
	push	es
	les	bx,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	mov	dl,[bx]
	pop	es
	or	dl,dl
	jnz	volume_label_found
	mov	dl,.dos_current_drive
	inc	dl
volume_label_found:
	mov	[di],dl
	mov	byte ptr .directory_dos_attributes,08h
	db	033h,0c0h				; xor ax,ax (original encoding)
volume_label_restore_drive:
	mov	cl,0eh
	mov	dl,.dos_current_drive
	call	bdos_preserve_results
	or	al,al
	ret

; Issue native search CL with DS:DI FCB; map successful directory index AL
; to its 32-byte entry in the private DMA buffer, returning DS:SI.
native_directory_search:
	db	08bh,0d7h				; mov dx,di (original encoding)
	mov	al,[di]
	dec	al
	cmp	al,03eh
	jnz	directory_issue_bdos
	mov	al,.dos_working_drive
directory_issue_bdos:
	mov	ah,04h
	call	file_bdos_checked
	cmp	al,0ffh
	jz	directory_search_return
	xor	ah,ah
	mov	cl,05h
	shl	ax,cl
	mov	si,exe_header
	db	003h,0f0h				; add si,ax (original encoding)
directory_search_return:
	ret

; Restore native UDA search-position fields from the application FCB.
restore_find_position:
	push	ds
	push	es
	push	si
	push	di
	mov	es,cs:word ptr shared_sysdat_segment
	mov	di,es:.068h
	db	026h					; ES override; original addressing
	mov	di,010h[di]
	mov	es,di
	mov	di,00h
	lds	si,dword ptr .dos_fcb_offset
	mov	al,018h[si]
	db	026h					; ES override; original addressing
	mov	07h[di],al
	mov	ax,019h[si]
	db	026h					; ES override; original addressing
	mov	0ch[di],ax
	mov	ax,01bh[si]
	db	026h					; ES override; original addressing
	mov	0eh[di],ax
	pop	di
	pop	si
	pop	es
	pop	ds
	ret

; Save native UDA search-position fields into the application FCB.
save_find_position:
	push	ds
	push	es
	push	si
	push	di
	les	di,dword ptr .dos_fcb_offset
	mov	ds,cs:word ptr shared_sysdat_segment
	mov	si,.068h
	mov	si,010h[si]
	mov	ds,si
	mov	si,00h
	mov	al,07h[si]
	db	026h					; ES override; original addressing
	mov	018h[di],al
	mov	ax,0ch[si]
	db	026h					; ES override; original addressing
	mov	019h[di],ax
	mov	ax,0eh[si]
	db	026h					; ES override; original addressing
	mov	01bh[di],ax
	pop	di
	pop	si
	pop	es
	pop	ds
	ret

; Save 28 bytes of native UDA directory state while nested metadata calls run.
save_native_directory_state:
	push	di
	push	ds
	push	es
	mov	ax,ds
	mov	es,ax
	mov	ds,word ptr .rsp_sysdat_segment
	mov	bx,.068h
	mov	ax,010h[bx]
	mov	ds,ax
	mov	cx,0eh
	mov	di,directory_state_offset
	mov	si,02h
	rep	movsw
	pop	es
	pop	ds
	pop	di
	ret

; Restore the saved native directory state; preserve DI/ES.
restore_native_directory_state:
	push	di
	push	es
	mov	es,word ptr .rsp_sysdat_segment
	mov	bx,es:.068h
	db	026h					; ES override; original addressing
	mov	ax,010h[bx]
	mov	es,ax
	mov	cx,0eh
	mov	si,directory_state_offset
	mov	di,02h
	rep	movsw
	pop	es
	pop	di
	ret

; AH=13h: reject named devices; search matching files, skip read-only entries,
; delete through native BDOS 19 and release matching private open-file slots.
; Continue the saved search and restore DOS DMA at exit.
dos_fn_delete_fcb:
	call	select_dos_fcb
	call	match_dos_device
	jz	delete_regular_file
	mov	byte ptr .dos_saved_ax,0ffh
	ret
delete_regular_file:
	mov	byte ptr .dos_saved_ax,0ffh
	call	prepare_directory_search
	jnz	delete_restore_dma
	mov	cl,011h
delete_next_entry:
	mov	di,metadata_fcb_offset
	call	native_directory_search
	cmp	al,0ffh
	jz	delete_restore_dma
	test	byte ptr 09h[si],080h
	jnz	delete_continue
	push	si
	call	save_native_directory_state
	pop	si
	mov	al,.metadata_fcb_offset
	mov	[si],al
	mov	cl,013h
	db	08bh,0d6h				; mov dx,si (original encoding)
	mov	al,[si]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	or	al,al
	jnz	delete_restore_dma
	push	word ptr .dos_fcb_offset
	push	word ptr .dos_fcb_segment
	mov	.dos_fcb_offset,si
	mov	word ptr .dos_fcb_segment,ds
	call	find_fcb_slot
	jnz	delete_restore_fcb
	call	release_fcb_slot
delete_restore_fcb:
	pop	word ptr .dos_fcb_segment
	pop	word ptr .dos_fcb_offset
	call	restore_native_directory_state
	mov	byte ptr .dos_saved_ax,00h
delete_continue:
	mov	cl,012h
	jmps	delete_next_entry
delete_restore_dma:
	les	dx,dword ptr .dos_dta_offset
	jmp	set_loader_dma

; AH=14h: save random position, derive it from sequential block/record, read
; one record, advance sequential position only on success, restore random state.
dos_fn_sequential_read:
	call	select_dos_fcb
	db	026h					; ES override; original addressing
	push	word ptr 021h[si]
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	sequential_read_save_32bits
	db	026h					; ES override; original addressing
	push	word ptr 022h[si]
	jmps	sequential_read_one
sequential_read_save_32bits:
	db	026h					; ES override; original addressing
	push	word ptr 023h[si]
sequential_read_one:
	call	dos_fn_set_random
	call	dos_fn_random_read
sequential_advance:
	test	byte ptr .dos_saved_ax,0ffh
	jnz	sequential_restore_random
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	add	byte ptr 020h[si],01h
	db	026h					; ES override; original addressing
	cmp	byte ptr 020h[si],080h
	jc	sequential_restore_random
	db	026h					; ES override; original addressing
	inc	word ptr 0ch[si]
	db	026h					; ES override; original addressing
	mov	byte ptr 020h[si],00h
sequential_restore_random:
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	sequential_restore_32bits
	db	026h					; ES override; original addressing
	pop	word ptr 022h[si]
	jmps	sequential_restore_low
sequential_restore_32bits:
	db	026h					; ES override; original addressing
	pop	word ptr 023h[si]
sequential_restore_low:
	db	026h					; ES override; original addressing
	pop	word ptr 021h[si]
	ret

; AH=15h: same sequential bookkeeping as read, using random write.
dos_fn_sequential_write:
	call	select_dos_fcb
	db	026h					; ES override; original addressing
	push	word ptr 021h[si]
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	sequential_write_save_32bits
	db	026h					; ES override; original addressing
	push	word ptr 022h[si]
	jmps	sequential_write_one
sequential_write_save_32bits:
	db	026h					; ES override; original addressing
	push	word ptr 023h[si]
sequential_write_one:
	call	dos_fn_set_random
	call	dos_fn_random_write
	jmps	sequential_advance

; AH=17h: reject a device target, flush cache, then rename matching sources.
; Substitute source characters for target question marks, reject an existing
; target, close any open source, and issue native rename (23).
dos_fn_rename_fcb:
	call	select_dos_fcb
	add	si,010h
	call	match_dos_device
	or	al,al
	jz	rename_flush
	mov	byte ptr .dos_saved_ax,0ffh
	ret
rename_flush:
	call	flush_record_cache
	test	byte ptr .record_cache_result,0ffh
	jz	rename_prepare
	jmp	rename_failed
rename_prepare:
	mov	byte ptr .record_cache_valid,00h
	mov	ax,ds
	mov	es,ax
	mov	dx,exe_header
	call	set_loader_dma
	mov	byte ptr .dos_saved_ax,0ffh
rename_find_source:
	mov	di,metadata_fcb_offset
	lds	si,dword ptr .dos_fcb_offset
	call	copy_normalized_fcb
	push	es
	pop	ds
	mov	si,metadata_fcb_offset
	call	resolve_default_fcb_drive
	db	08bh,0d6h				; mov dx,si (original encoding)
	mov	cl,011h
	mov	al,[si]
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	cmp	al,0ffh
	jnz	rename_source_found
	jmp	restore_dos_dma
rename_source_found:
	and	ax,03h
	mov	cl,05h
	shl	ax,cl
	add	ax,exe_header
	db	08bh,0f0h				; mov si,ax (original encoding)
	mov	di,program_fcb
	mov	cx,06h
	rep	movsw
	mov	al,.metadata_fcb_offset
	mov	.program_fcb,al
	push	word ptr .dos_fcb_segment
	push	word ptr .dos_fcb_offset
	push	es
	push	ds
	pop	es
	mov	word ptr .dos_fcb_segment,ds
	mov	si,program_fcb
	db	08bh,0feh				; mov di,si (original encoding)
	mov	.dos_fcb_offset,si
	call	close_resolved_fcb
	pop	es
	pop	word ptr .dos_fcb_offset
	pop	word ptr .dos_fcb_segment
	cmp	byte ptr .dos_saved_ax,0ffh
	jne	rename_close_ready
	jmp	rename_failed
rename_close_ready:
	lds	si,dword ptr .bios_frame_dx
	add	si,011h
	mov	di,metadata_fcb_offset_1
	mov	bx,command_fcb_offset_1
	mov	cx,0bh
rename_build_target:
	lodsb
	and	al,07fh
	cmp	al,061h
	jc	rename_target_wildcard
	cmp	al,07ah
	ja	rename_target_wildcard
	and	al,05fh
rename_target_wildcard:
	cmp	al,03fh
	jnz	rename_store_character
	db	026h					; ES override; original addressing
	mov	al,[bx]
rename_store_character:
	stosb
	inc	bx
	loop	rename_build_target
	mov	ax,es
	mov	ds,ax
	mov	dx,metadata_fcb_offset
	mov	cl,011h
	push	dx
	push	bx
	db	08bh,0dah				; mov bx,dx (original encoding)
	mov	al,[bx]
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	pop	bx
	pop	dx
	cmp	al,0ffh
	jz	rename_issue_request
rename_failed:
	mov	byte ptr .dos_saved_ax,0ffh
	jmp	restore_dos_dma
rename_issue_request:
	mov	si,metadata_fcb_offset
	mov	di,command_fcb_offset_16
	mov	cx,06h
	rep	movsw
	mov	dx,program_fcb
	mov	cl,017h
	push	dx
	push	bx
	db	08bh,0dah				; mov bx,dx (original encoding)
	mov	al,[bx]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	pop	bx
	pop	dx
	cmp	al,0ffh
	jnz	rename_continue
	jmp	restore_dos_dma
rename_continue:
	mov	byte ptr .dos_saved_ax,00h
	jmp	rename_find_source


; AH=19h: query native current disk and return it in application AL.
dos_fn_current_drive:
	mov	cl,019h
	call	loader_bdos_call
	mov	.dos_saved_ax,al
	ret

; AH=1Ah: retain the application DTA and set native DMA offset and segment.
dos_fn_set_dta:
	mov	.dos_dta_offset,dx
	mov	word ptr .dos_dta_segment,es
set_loader_dma:
	call	set_native_dma_offset
	mov	dx,es
	mov	.native_dma_segment,dx
	mov	cl,033h
	call	loader_bdos_call
	ret

; Set native DMA offset, retaining it for later file-operation restoration.
set_native_dma_offset:
	mov	.native_dma_offset,dx
	mov	cl,01ah
	call	loader_bdos_call
	ret

; AH=1Bh: read the current drive DPH/DPB through XIOS SYSDAT.
; Return AL=sectors per allocation unit, CX=sector bytes, DX=allocation units,
; BX=0; place the DPH +12h value in the saved caller DS stack slot.
; A leading FFFFh DPB word selects the original alternate disk layout.
dos_fn_allocation_info:
	mov	es,cs:word ptr shared_sysdat_segment
	mov	bl,.dos_current_drive
	xor	bh,bh
	shl	bx,1
	db	026h					; ES override; original addressing
	mov	bx,xios_disk_table[bx]
	db	026h					; ES override; original addressing
	mov	si,08h[bx]
	db	026h					; ES override; original addressing
	mov	ax,012h[bx]
	db	033h,0c9h				; xor cx,cx (original encoding)
	db	08bh,0d1h				; mov dx,cx (original encoding)
	push	ds
	mov	di,.child_stack_offset
	mov	ds,word ptr .child_stack_segment
	mov	[di],ax
	pop	ds
	mov	.bios_frame_bx,cx
	mov	ax,080h
	db	026h					; ES override; original addressing
	cmp	word ptr [si],0ffffh
	jnz	allocation_native_dpb
	db	026h					; ES override; original addressing
	mov	cl,01bh[si]
	shl	ax,cl
	mov	.bios_frame_cx,ax
	db	08bh,0d8h				; mov bx,ax (original encoding)
	db	026h					; ES override; original addressing
	mov	ax,08h[si]
	div	bx
	mov	.dos_saved_ax,al
	db	026h					; ES override; original addressing
	mov	ax,06h[si]
	jmps	allocation_return_count

; Native DPB: sector bytes=128<<PSH, unit bytes=128<<BSH, units=DSM+1.
allocation_native_dpb:
	db	026h					; ES override; original addressing
	mov	cl,0fh[si]
	shl	ax,cl
	mov	.bios_frame_cx,ax
	db	08bh,0d8h				; mov bx,ax (original encoding)
	mov	ax,080h
	db	026h					; ES override; original addressing
	mov	cl,02h[si]
	shl	ax,cl
	div	bx
	mov	.dos_saved_ax,al
	db	026h					; ES override; original addressing
	mov	ax,05h[si]
	inc	ax
allocation_return_count:
	mov	.bios_frame_dx,ax
	ret


; AH=21h: perform one random-record read through the block-transfer core,
; preserving application CX. The zero mode flag suppresses block advancement.
dos_fn_random_read:
	mov	byte ptr .transfer_advance_random,00h
	push	word ptr .bios_frame_cx
	mov	cx,01h
	mov	.bios_frame_cx,cx
	call	block_read_common
	pop	word ptr .bios_frame_cx
	ret

; Read the selected private FCB random record into the shared 128-byte cache.
; Reuse a matching valid cache entry; otherwise flush dirty data before reading.
; Preserve the FCB random record across native I/O, record its owner/user.
read_record_cache:
	cmp	byte ptr .record_cache_valid,0ffh
	jnz	cache_read_native
	call	cache_record_matches
	jnz	cache_replace
	xor	ax,ax
	ret
cache_replace:
	call	flush_record_cache
	mov	al,.record_cache_result
	or	al,al
	jnz	cache_read_result
cache_read_native:
	mov	byte ptr .record_cache_valid,00h
	les	dx,dword ptr .record_cache_buffer
	call	set_loader_dma
	mov	si,.dos_fcb_slot
	db	08bh,0d6h				; mov dx,si (original encoding)
	mov	.cached_fcb_slot,dx
	push	word ptr 021h[si]
	push	word ptr 022h[si]
	mov	cl,021h
	mov	al,[si]
	dec	al
	mov	ah,03h
	call	file_bdos_checked
	pop	word ptr 022h[si]
	pop	word ptr 021h[si]
	les	bx,dword ptr 020h[si]
	mov	.record_cache_number,bh
	mov	word ptr .cache_record_offset_1,es
cache_read_result:
	mov	.record_cache_result,al
	or	al,al
	jz	cache_record_ready
	ret
cache_record_ready:
	mov	byte ptr .record_cache_valid,0ffh
	push	ax
	mov	dl,0ffh
	call	file_user_select
	mov	.record_cache_user,al
	pop	ax
	ret
file_user_select:
	mov	cl,020h
	jmp	loader_bdos_call

; Compare selected FCB pointer and 24-bit random record with cached identity.
; ZF indicates match. AL retains the high record byte on the final comparison.
cache_record_matches:
	mov	si,.dos_fcb_slot
	cmp	si,.cached_fcb_slot
	jz	cache_compare_record_low
	ret
cache_compare_record_low:
	mov	ax,021h[si]
	cmp	ax,.record_cache_number
	jz	cache_compare_record_high
	ret
cache_compare_record_high:
	mov	al,023h[si]
	cmp	al,.cache_record_offset_2
	ret

; Flush dirty cache under its recorded user number, restoring the caller user
; and FCB random record. Clear dirty state only after a successful supported write.
flush_record_cache:
	mov	byte ptr .record_cache_result,00h
	cmp	byte ptr .record_cache_dirty,0ffh
	jz	cache_write_dirty
	xor	ax,ax
	ret
cache_write_dirty:
	mov	dl,0ffh
	call	file_user_select
	push	ax
	mov	dl,.record_cache_user
	call	file_user_select
	les	dx,dword ptr .record_cache_buffer
	call	set_loader_dma
	mov	dx,.cached_fcb_slot
	db	08bh,0f2h				; mov si,dx (original encoding)
	push	word ptr 021h[si]
	push	word ptr 022h[si]
	mov	ax,.record_cache_number
	mov	021h[si],ax
	mov	al,.cache_record_offset_2
	mov	023h[si],al
	mov	cl,022h
	mov	al,[si]
	dec	al
	mov	ah,07h
	call	file_bdos_checked
	pop	word ptr 022h[si]
	pop	word ptr 021h[si]
	pop	dx
	push	ax
	call	file_user_select
	pop	ax
	or	al,al
	jnz	cache_flush_result
	mov	byte ptr .record_cache_dirty,00h
cache_flush_result:
	mov	.record_cache_result,al
	ret

; AH=22h: one random-record write through the block core; preserve application CX.
dos_fn_random_write:
	mov	byte ptr .transfer_advance_random,00h
	push	word ptr .bios_frame_cx
	mov	cx,01h
	mov	.bios_frame_cx,cx
	call	block_write_common
	pop	word ptr .bios_frame_cx
	ret

; AH=23h: compute file size in application-sized records, rounding upward.
; Native search supplies final-record byte count; native BDOS 35 gives records.
; Record size zero uses 128 for division. Store 24 or 32 bits according to
; the FCB record-size field, then restore the application DTA.
dos_fn_file_size:
	mov	byte ptr .dos_saved_ax,00h
	call	select_dos_fcb
	call	match_dos_device
	jz	file_size_find_entry
	db	026h					; ES override; original addressing
	mov	021h[si],ax
	db	026h					; ES override; original addressing
	mov	023h[si],ax
	ret
file_size_find_entry:
	mov	byte ptr .dos_saved_ax,0ffh
	call	prepare_directory_search
	jnz	file_size_restore_dma
	mov	cl,011h
	mov	di,metadata_fcb_offset
	call	native_directory_search
	cmp	al,0ffh
	jz	file_size_restore_dma
	db	033h,0dbh				; xor bx,bx (original encoding)
	mov	bl,0dh[si]
	push	bx
	mov	dx,metadata_fcb_offset
	db	08bh,0f2h				; mov si,dx (original encoding)
	mov	cl,023h
	mov	al,[si]
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	pop	bx
	cmp	al,0ffh
	jz	file_size_restore_dma
	mov	ax,021h[si]
	mov	dl,023h[si]
	xor	dh,dh
	call	records_to_bytes
	or	bl,bl
	jz	file_size_divide_records
	push	ax
	or	ax,dx
	pop	ax
	jz	file_size_divide_records
	sub	ax,080h
	sbb	dx,00h
	db	003h,0c3h				; add ax,bx (original encoding)
	adc	dx,00h
file_size_divide_records:
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	mov	cx,0eh[si]
	or	cx,cx
	jnz	file_size_divisor_ready
	mov	cx,080h
file_size_divisor_ready:
	db	08bh,0dah				; mov bx,dx (original encoding)
	call	divide_record_offset
	or	cx,cx
	jz	file_size_store_records
	add	ax,01h
	adc	dx,00h
file_size_store_records:
	mov	byte ptr .dos_saved_ax,00h
	db	026h					; ES override; original addressing
	mov	021h[si],ax
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	file_size_store_32bits
	db	026h					; ES override; original addressing
	mov	023h[si],dl
	jmps	file_size_restore_dma
file_size_store_32bits:
	db	026h					; ES override; original addressing
	mov	023h[si],dx
file_size_restore_dma:
	les	dx,dword ptr .dos_dta_offset
	jmp	set_loader_dma

; AH=24h: derive random-record position from sequential block*128+record.
; Devices are unchanged; record size >=64 stores a 24-bit result, else 32 bits.
dos_fn_set_random:
	call	select_dos_fcb
	call	application_fcb_device
	jz	set_random_from_sequential
	ret
set_random_from_sequential:
	db	08bh,0f2h				; mov si,dx (original encoding)
	db	026h					; ES override; original addressing
	mov	ax,0ch[si]
	db	033h,0d2h				; xor dx,dx (original encoding)
	call	records_to_bytes
	db	026h					; ES override; original addressing
	mov	cl,020h[si]
	xor	ch,ch
	db	003h,0c1h				; add ax,cx (original encoding)
	adc	dx,00h
	db	026h					; ES override; original addressing
	mov	021h[si],ax
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	set_random_store_32bits
	db	026h					; ES override; original addressing
	mov	023h[si],dl
	ret
set_random_store_32bits:
	db	026h					; ES override; original addressing
	mov	023h[si],dx
	ret

; AH=25h: write vector AL to the interrupt table from application DS:DX.
; Preserve FLAGS around the two-word vector write; DS is restored afterward.
dos_fn_set_vector:
	xor	ah,ah
	shl	ax,1
	shl	ax,1
	db	08bh,0f8h				; mov di,ax (original encoding)
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	es,ax
	push	ds
	lds	ax,dword ptr .bios_frame_dx
	pushf
	cli
	cld
	stosw
	mov	ax,ds
	stosw
	popf
	pop	ds
	ret

; AH=26h: copy the current 256-byte PSP to segment DX, refresh INT 22h/23h
; vectors, and rebuild the far-call fields with the existing loader helpers.
dos_fn_new_psp:
	mov	es,dx
	db	033h,0ffh				; xor di,di (original encoding)
	push	ds
	mov	ds,word ptr .child_psp_segment
	db	033h,0f6h				; xor si,si (original encoding)
	cld
	mov	cx,080h
	rep	movsw
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	ds,ax
	mov	si,088h
	mov	di,0ah
	mov	cx,04h
	rep	movsw
	pop	ds
	sub	dx,.child_psp_segment
	mov	ax,.child_memory_size
	db	02bh,0c2h				; sub ax,dx (original encoding)
	call	limit_segment_bytes
	mov	di,06h
	stosw
	call	call_trampoline_segment
	stosw
	ret

; Return application FCB device tag (+18h) when FC..FF; otherwise AL=0.
; ZF distinguishes an ordinary file from a recognized device tag.
application_fcb_device:
	db	026h					; ES override; original addressing
	mov	al,018h[si]
	cmp	al,0fbh
	ja	application_device_result
	xor	al,al
application_device_result:
	or	al,al
	ret


; AH=27h: random block read. Set advancement mode, save requested record count.
; Zero count returns status 2; record size zero becomes 128.
dos_fn_block_read:
	mov	byte ptr .transfer_advance_random,0ffh
block_read_common:
	mov	.transfer_requested_records,cx
	mov	byte ptr .dos_saved_ax,02h
	or	cx,cx
	jnz	block_read_resolve_fcb
	jmp	block_read_return
block_read_resolve_fcb:
	push	cx
	call	select_dos_fcb
	pop	cx
	mov	byte ptr .dos_saved_ax,00h
	db	026h					; ES override; original addressing
	test	word ptr 0eh[si],0ffffh
	jnz	block_read_check_device
	db	026h					; ES override; original addressing
	mov	word ptr 0eh[si],080h
block_read_check_device:
	call	application_fcb_device
	jnz	block_read_device
	jmp	block_read_find_slot
block_read_device:
	mov	byte ptr .dos_saved_ax,01h
	cmp	al,0ffh
	jz	block_read_console
	jmp	console_record_return

; Console FCB reads: obtain a buffered line, append CR/LF, then supply one
; application record from it. Zero-pad a partial record and report status 3.
block_read_console:
	test	byte ptr .console_record_pending,0ffh
	jnz	console_record_copy
	mov	dx,console_record_capacity_offset
	db	08bh,0fah				; mov di,dx (original encoding)
	push	si
	push	es
	push	ds
	pop	es
	push	word ptr .bios_frame_dx
	mov	.bios_frame_dx,dx
	call	dos_fn_buffered_input
	pop	word ptr .bios_frame_dx
	mov	dl,0ah
	call	dos_fn_console_output
	pop	es
	pop	si
	mov	byte ptr .console_record_pending,0ffh
	db	033h,0dbh				; xor bx,bx (original encoding)
	mov	bl,.console_record_length
	inc	byte ptr .console_record_length
	inc	byte ptr .console_record_length
	mov	byte ptr console_record_text_offset[bx],0dh
	inc	bx
	mov	byte ptr console_record_text_offset[bx],0ah
	mov	word ptr .console_record_position,00h
console_record_copy:
	mov	byte ptr .dos_saved_ax,00h
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	al,.console_record_length
	sub	ax,.console_record_position
	db	026h					; ES override; original addressing
	mov	cx,0eh[si]
	db	08bh,0d1h				; mov dx,cx (original encoding)
	cmp	ax,cx
	jnc	console_copy_available
	db	08bh,0c8h				; mov cx,ax (original encoding)
	mov	byte ptr .dos_saved_ax,03h
console_copy_available:
	les	di,dword ptr .dos_dta_offset
	mov	si,console_record_text_offset
	add	si,.console_record_position
	push	cx
	rep	movsb
	pop	cx
	db	02bh,0d1h				; sub dx,cx (original encoding)
	jz	console_record_advance
	push	cx
	db	08bh,0cah				; mov cx,dx (original encoding)
	db	033h,0c0h				; xor ax,ax (original encoding)
	rep	stosb
	pop	cx
console_record_advance:
	add	.console_record_position,cx
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	al,.console_record_length
	cmp	.console_record_position,ax
	jc	console_record_return
	mov	word ptr .console_record_position,00h
	mov	byte ptr .console_record_pending,00h
console_record_return:
	ret

; Ordinary file read: find/open the private slot, derive byte boundaries,
; read first partial record, whole records and final partial record.
block_read_find_slot:
	call	find_fcb_slot
	cmp	al,0ffh
	jnz	block_read_prepare
	call	open_fcb_on_demand
	or	al,al
	jnz	block_read_error
block_read_prepare:
	call	prepare_random_transfer
	call	read_first_partial_record
	or	al,al
	jz	block_read_middle

; Map transfer failure to DOS statuses: 2 segment boundary, 1 EOF,
; 3 partial application record (zero-filled). Update completed record count.
block_read_error:
	cmp	al,02h
	jnz	block_read_short
	call	update_transfer_position
	mov	byte ptr .dos_saved_ax,02h
block_read_return:
	ret
block_read_short:
	push	word ptr .bios_frame_cx
	call	update_transfer_position
	pop	ax
	sub	ax,.bios_frame_cx
	mov	byte ptr .dos_saved_ax,00h
	jnz	block_read_eof
	ret
block_read_eof:
	mov	byte ptr .dos_saved_ax,01h
	cmp	byte ptr .transfer_has_partial,00h
	jnz	block_read_partial
	ret
block_read_partial:
	mov	byte ptr .dos_saved_ax,03h
	les	di,dword ptr .dos_dta_offset
	add	di,.transfer_bytes_done
	push	ds
	lds	si,dword ptr .dos_fcb_offset
	mov	cx,0eh[si]
	pop	ds
	mov	ax,.transfer_bytes_done
	db	033h,0d2h				; xor dx,dx (original encoding)
	div	cx
	db	02bh,0cah				; sub cx,dx (original encoding)
	xor	al,al
	cld
	rep	stosb
	ret
block_read_middle:
	mov	ax,.transfer_record_span
	dec	ax
	js	block_read_success
	jz	block_read_last
	mov	.transfer_whole_records,ax
	call	read_whole_records
	or	al,al
	jnz	block_read_error
block_read_last:
	call	read_last_partial_record
	or	al,al
	jnz	block_read_error
block_read_success:
	call	update_transfer_position
	mov	byte ptr .dos_saved_ax,00h
	ret

; Compute completed application records from buffer movement, rounding up.
; Advance random position only for block mode; update sequential block/record.
update_transfer_position:
	mov	ax,.transfer_buffer_offset
	sub	ax,.dos_dta_offset
	mov	.transfer_bytes_done,ax
	db	033h,0d2h				; xor dx,dx (original encoding)
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	mov	bx,0eh[si]
	div	bx
	or	dl,dh
	jz	transfer_count_ready
	inc	ax
transfer_count_ready:
	mov	.transfer_has_partial,dl
	mov	.bios_frame_cx,ax
	test	byte ptr .transfer_advance_random,0ffh
	jnz	advance_random_position
	jmps	update_sequential_position
advance_random_position:
	mov	ax,.bios_frame_cx
	les	si,dword ptr .dos_fcb_offset
	cmp	bx,040h
	jc	advance_random_32bits
	db	026h					; ES override; original addressing
	add	021h[si],ax
	db	026h					; ES override; original addressing
	adc	byte ptr 023h[si],00h
	jmps	update_sequential_position
advance_random_32bits:
	db	026h					; ES override; original addressing
	add	021h[si],ax
	db	026h					; ES override; original addressing
	adc	word ptr 023h[si],00h
update_sequential_position:
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	mov	ax,021h[si]
	db	026h					; ES override; original addressing
	mov	dx,023h[si]
	db	026h					; ES override; original addressing
	cmp	word ptr 0eh[si],040h
	jc	sequential_position_convert
	xor	dh,dh
sequential_position_convert:
	call	bytes_to_records
	db	026h					; ES override; original addressing
	mov	0ch[si],ax
	db	026h					; ES override; original addressing
	mov	020h[si],ch
	ret

; Read initial partial CP/M record through cache; copy required bytes to DTA.
; Detect destination offset wrapping and return 2; native read failure returns 1.
read_first_partial_record:
	les	ax,dword ptr .transfer_first_record
	mov	si,.dos_fcb_slot
	mov	021h[si],ax
	mov	ax,es
	mov	023h[si],al
	call	read_record_cache
	or	al,al
	jz	read_first_extent
	mov	al,01h
	ret
read_first_extent:
	mov	si,.transfer_first_byte
	mov	cx,080h
	cmp	word ptr .transfer_record_span,00h
	jnz	read_first_count
	mov	cx,.transfer_last_byte
	inc	cx
read_first_count:
	db	02bh,0ceh				; sub cx,si (original encoding)
	ja	read_first_copy_setup
	mov	ax,0800ch
	jmp	dos_critical_error
read_first_copy_setup:
	les	di,dword ptr .transfer_buffer_offset
	cld
	add	si,exe_header
read_first_copy_byte:
	movsb
	or	di,di
	jnz	read_first_copy_next
	mov	.transfer_buffer_offset,di
	mov	al,02h
	ret
read_first_copy_next:
	loop	read_first_copy_byte
	mov	.transfer_buffer_offset,di
	mov	si,.dos_fcb_slot
	add	word ptr 021h[si],01h
	adc	byte ptr 023h[si],00h
	db	033h,0c0h				; xor ax,ax (original encoding)
	ret

; Read whole 128-byte records directly to DTA in batches of at most 128.
; Limit a batch at the segment boundary, restore multi-record count to one,
; and advance DMA/private FCB by the completed native record count.
read_whole_records:
	les	dx,dword ptr .transfer_buffer_offset
	call	set_loader_dma
	mov	dx,080h
	cmp	word ptr .transfer_whole_records,080h
	jnc	read_whole_limit
	mov	dx,.transfer_whole_records
read_whole_limit:
	sub	.transfer_whole_records,dx
	mov	bx,.transfer_buffer_offset
	db	08bh,0c2h				; mov ax,dx (original encoding)
	mov	cl,07h
	shl	ax,cl
	db	003h,0d8h				; add bx,ax (original encoding)
	jnc	read_whole_request
	mov	byte ptr .dos_saved_ax,02h
	db	033h,0d2h				; xor dx,dx (original encoding)
	sub	dx,.transfer_buffer_offset
	shr	dx,cl
read_whole_request:
	or	dx,dx
	jnz	read_whole_nonzero
	mov	al,2
	ret
read_whole_nonzero:
	call	set_multi_record_count
	push	dx
	mov	dx,.dos_fcb_slot
	db	08bh,0f2h				; mov si,dx (original encoding)
	mov	cl,021h
	mov	al,[si]
	dec	al
	mov	ah,06h
	call	file_bdos_checked
	push	ax
	mov	dl,01h
	call	set_multi_record_count
	pop	ax
	pop	dx
	or	al,al
	jz	read_whole_advance_buffer
	mov	dl,ah
read_whole_advance_buffer:
	mov	cl,07h
	push	dx
	shl	dx,cl
	add	.transfer_buffer_offset,dx
	pop	dx
	or	al,al
	jz	read_whole_advance_record
	cmp	al,0ffh
	jz	read_whole_failed
	mov	dl,ah
	add	021h[si],dx
	adc	byte ptr 023h[si],00h
read_whole_failed:
	mov	al,01h
	ret
read_whole_advance_record:
	add	021h[si],dx
	adc	byte ptr 023h[si],00h
	cmp	byte ptr .dos_saved_ax,2
	jne	read_whole_continue
	mov	al,2
	ret
read_whole_continue:
	mov	ax,.transfer_whole_records
	or	ax,ax
	jz	read_whole_done
	jmp	read_whole_records
read_whole_done:
	db	033h,0c0h				; xor ax,ax (original encoding)
	ret

; Read final partial record through cache, detecting destination offset wrap.
read_last_partial_record:
	mov	si,.dos_fcb_slot
	call	read_record_cache
	or	al,al
	jz	read_last_copy_setup
	mov	al,01h
	ret
read_last_copy_setup:
	mov	cx,.transfer_last_byte
	inc	cx
	les	di,dword ptr .transfer_buffer_offset
	cld
	push	ds
	lds	si,dword ptr .record_cache_buffer
read_last_copy_byte:
	movsb
	or	di,di
	jnz	read_last_copy_next
	pop	ds
	mov	.transfer_buffer_offset,di
	mov	al,02h
	ret
read_last_copy_next:
	loop	read_last_copy_byte
	pop	ds
	mov	.transfer_buffer_offset,di
	db	033h,0c0h				; xor ax,ax (original encoding)
	ret

; Zero-length file-write path: derive byte size from random position, close,
; truncate with native BDOS 99, then reopen the private FCB.
truncate_at_random_position:
	mov	di,.dos_fcb_slot
	push	di
	cmp	di,.cached_fcb_slot
	jnz	truncate_update_size
	call	flush_record_cache
	or	al,al
	jz	truncate_update_size
	pop	di
	mov	byte ptr .dos_saved_ax,01h
	ret
truncate_update_size:
	pop	di
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	mov	bx,023h[si]
	db	026h					; ES override; original addressing
	mov	ax,021h[si]
	db	026h					; ES override; original addressing
	mov	cx,0eh[si]
	cmp	cx,040h
	jc	truncate_size_convert
	xor	bh,bh
truncate_size_convert:
	call	multiply_record_offset
	push	ax
	push	bx
; BDOS 99 keeps the selected record: translate byte length to its last index.
	mov	dx,bx
	or	bx,ax
	jz	truncate_close_empty
	sub	ax,1
	sbb	dx,0
	call	bytes_to_records
	mov	023h[di],dl
	mov	021h[di],ax
	mov	dx,di
	mov	cl,010h
	mov	al,[di]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	cmp	al,0ffh
	je	truncate_error
	mov	dx,di
	mov	cl,063h
	mov	al,[di]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	cmp	al,0ffh
	je	truncate_error
	mov	dx,di
	mov	cl,0fh
	mov	al,[di]
	dec	al
	mov	ah,04h
	call	file_bdos_checked
	cmp	al,0ffh
	je	truncate_error
	jmps	truncate_store_size
truncate_error:
	jmp	truncate_failed
; Native truncate always retains a record. Empty files need close/delete/create.
truncate_close_empty:
	mov	dx,di
	mov	cl,010h
	mov	al,[di]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	cmp	al,0ffh
	je	truncate_error
	mov	dx,di
	mov	cl,013h
	mov	al,[di]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	cmp	al,0ffh
	je	truncate_error
	cmp	di,.cached_fcb_slot
	jne	truncate_empty_clear
	mov	byte ptr .record_cache_valid,0
truncate_empty_clear:
	push	di
	push	es
	push	ds
	pop	es
	add	di,12
	xor	ax,ax
	mov	cx,12
	cld
	rep	stosw
	pop	es
	pop	di
	mov	dx,di
	mov	cl,016h
	mov	al,[di]
	dec	al
	mov	ah,05h
	call	file_bdos_checked
	cmp	al,0ffh
	jne	truncate_store_size
	call	release_fcb_slot
	jmps	truncate_failed
truncate_store_size:
	pop	bx
	pop	ax
	les	si,dword ptr .dos_fcb_offset
	mov	es:010h[si],ax
	mov	es:012h[si],bx
; Ensure close records the exact final-byte count, including partial records.
	or	byte ptr 0eh[di],040h
	cmp	di,.cached_fcb_slot
	jne	truncate_success
	mov	byte ptr .record_cache_valid,0
truncate_success:
	mov	byte ptr .dos_saved_ax,0
	ret
truncate_failed:
	pop	bx
	pop	ax
	mov	byte ptr .dos_saved_ax,1
	ret

; AH=28h: random block write. Set advancement mode and default record size.
; Devices route one record to console/printer; null device returns success.
dos_fn_block_write:
	mov	byte ptr .transfer_advance_random,0ffh
block_write_common:
	mov	.transfer_requested_records,cx
	push	cx
	call	select_dos_fcb
	pop	cx
	mov	byte ptr .dos_saved_ax,00h
	db	026h					; ES override; original addressing
	test	word ptr 0eh[si],0ffffh
	jnz	block_write_check_device
	db	026h					; ES override; original addressing
	mov	word ptr 0eh[si],080h
block_write_check_device:
	call	application_fcb_device
	jz	block_write_find_slot
	cmp	word ptr .transfer_requested_records,0
	je	block_write_return
	cmp	al,0fdh
	jz	block_write_return
	mov	byte ptr .dos_saved_ax,02h
	db	026h					; ES override; original addressing
	mov	cx,0eh[si]
	les	si,dword ptr .dos_dta_offset
	push	si
	add	si,cx
	pop	si
	jc	block_write_return
	cld
	cmp	al,0ffh
	jnz	write_printer_record
write_console_record:
	mov	dl,es:[si]
	inc	si
	push	cx
	push	si
	push	es
	call	dos_fn_console_output
	pop	es
	pop	si
	pop	cx
	loop	write_console_record
	jmps	write_device_success
write_printer_record:
	mov	dl,es:[si]
	inc	si
	push	cx
	push	si
	push	es
	call	dos_fn_printer_output
	pop	es
	pop	si
	pop	cx
	loop	write_printer_record
write_device_success:
	mov	byte ptr .dos_saved_ax,00h
block_write_return:
	ret

; Ordinary write: find/open slot, prepare byte boundaries, then write initial
; partial, whole and final partial records. Update application FCB file size.
block_write_find_slot:
	call	find_fcb_slot
	cmp	al,0ffh
	jnz	block_write_check_truncate
	call	open_fcb_on_demand
	or	al,al
	jnz	block_write_first_result
block_write_check_truncate:
	test	word ptr .transfer_requested_records,0ffffh
	jnz	block_write_prepare
	jmp	truncate_at_random_position
block_write_prepare:
	call	prepare_random_transfer
	push	es
	call	write_first_partial_record
	pop	es
	or	al,al
	jnz	block_write_transfer_error
block_write_first_result:
	or	al,al
	jz	block_write_middle
	mov	.dos_saved_ax,al
	ret
block_write_middle:
	mov	ax,.transfer_record_span
	dec	ax
	js	block_write_update_size
	jz	block_write_last
	mov	.transfer_whole_records,ax
	call	write_whole_records
	or	al,al
	jz	block_write_last
	jmps	block_write_transfer_error
block_write_last:
	call	write_last_partial_record
	or	al,al
	jz	block_write_update_size
block_write_transfer_error:
	push	ax
	call	block_write_update_size
	pop	ax
	mov	.dos_saved_ax,al
	ret
block_write_update_size:
	les	si,dword ptr .dos_fcb_offset
	mov	ax,.transfer_buffer_offset
	sub	ax,.dos_dta_offset
	mov	dx,00h
	add	ax,.transfer_start_offset
	adc	dx,.transfer_start_high
	db	026h					; ES override; original addressing
	cmp	dx,012h[si]
	ja	block_write_store_size
	jb	block_write_success
	db	026h					; ES override; original addressing
	cmp	ax,010h[si]
	jc	block_write_success
block_write_store_size:
	db	026h					; ES override; original addressing
	mov	010h[si],ax
	db	026h					; ES override; original addressing
	mov	012h[si],dx
block_write_success:
	mov	byte ptr .dos_saved_ax,00h
	test	byte ptr .transfer_advance_random,0ffh
	jnz	block_write_advance
	ret
block_write_advance:
	call	update_transfer_position
	ret

; Read/modify initial partial CP/M record in cache. Accept native read
; statuses 0/1/4, mark cache dirty, copy bytes and advance private record.
; Check source SI for segment wrap before copying another byte.
write_first_partial_record:
	les	ax,dword ptr .transfer_first_record
	mov	si,.dos_fcb_slot
	mov	021h[si],ax
	mov	ax,es
	mov	023h[si],al
	call	read_record_cache
	cmp	al,02h
	jc	write_first_extent
	cmp	al,04h
	jz	write_first_extent
	jmp	write_first_failed
write_first_extent:
	mov	di,.transfer_first_byte
	mov	cx,080h
	cmp	word ptr .transfer_record_span,00h
	jnz	write_first_count
	mov	cx,.transfer_last_byte
	inc	cx
write_first_count:
	db	02bh,0cfh				; sub cx,di (original encoding)
	ja	write_first_mark_dirty
	jmps	write_first_failed
write_first_mark_dirty:
	push	cx
	mov	dl,0ffh
	call	file_user_select
	pop	cx
	mov	.record_cache_user,al
	mov	byte ptr .record_cache_valid,0ffh
	mov	byte ptr .record_cache_dirty,0ffh
	push	ds
	pop	es
	push	ds
	add	di,exe_header
	lds	si,dword ptr .transfer_buffer_offset
	cld
write_first_copy_byte:
	movsb
	or	si,si
	jnz	write_first_copy_next
	pop	ds
	mov	.transfer_buffer_offset,si
	mov	al,02h
	ret
write_first_copy_next:
	loop	write_first_copy_byte
	pop	ds
	mov	.transfer_buffer_offset,si
	mov	si,.dos_fcb_slot
	add	word ptr 021h[si],01h
	adc	byte ptr 023h[si],00h
	db	033h,0c0h				; xor ax,ax (original encoding)
	ret
write_first_failed:
	mov	ax,01h
	ret

; Write whole records directly from DTA, up to 128 per native request.
; Restore multi-record count to one and advance by completed record count.
write_whole_records:
	les	dx,dword ptr .transfer_buffer_offset
	call	set_loader_dma
	mov	dx,080h
	cmp	word ptr .transfer_whole_records,080h
	jnc	write_whole_limit
	mov	dx,.transfer_whole_records
write_whole_limit:
	sub	.transfer_whole_records,dx
	mov	bx,.transfer_buffer_offset
	db	08bh,0c2h				; mov ax,dx (original encoding)
	mov	cl,07h
	shl	ax,cl
	db	003h,0d8h				; add bx,ax (original encoding)
	jnc	write_whole_request
	mov	byte ptr .dos_saved_ax,02h
	db	033h,0d2h				; xor dx,dx (original encoding)
	sub	dx,.transfer_buffer_offset
	shr	dx,cl
write_whole_request:
	or	dx,dx
	jnz	write_whole_nonzero
	mov	al,2
	ret
write_whole_nonzero:
	call	set_multi_record_count
	push	dx
	mov	dx,.dos_fcb_slot
	db	08bh,0f2h				; mov si,dx (original encoding)
	mov	cl,022h
	mov	al,[si]
	dec	al
	mov	ah,07h
	call	file_bdos_checked
	push	ax
	mov	dl,01h
	call	set_multi_record_count
	pop	ax
	pop	dx
	or	al,al
	jz	write_whole_advance_buffer
	mov	dl,ah
write_whole_advance_buffer:
	mov	cl,07h
	push	dx
	shl	dx,cl
	add	.transfer_buffer_offset,dx
	pop	dx
	or	al,al
	jz	write_whole_advance_record
	cmp	al,0ffh
	jz	write_whole_failed
	mov	dl,ah
	add	021h[si],dx
	adc	byte ptr 023h[si],00h
write_whole_failed:
	mov	al,01h
	ret
write_whole_advance_record:
	add	021h[si],dx
	adc	byte ptr 023h[si],00h
	cmp	byte ptr .dos_saved_ax,2
	jne	write_whole_continue
	mov	al,2
	ret
write_whole_continue:
	mov	ax,.transfer_whole_records
	or	ax,ax
	jz	write_whole_done
	jmp	write_whole_records
write_whole_done:
	ret

; Read/modify final partial record in cache; source offset wrap returns 2.
write_last_partial_record:
	mov	si,.dos_fcb_slot
	call	read_record_cache
	cmp	al,02h
	jc	write_last_mark_dirty
	cmp	al,04h
	jz	write_last_mark_dirty
	jmp	write_whole_failed
write_last_mark_dirty:
	mov	cx,.transfer_last_byte
	inc	cx
	push	cx
	mov	dl,0ffh
	call	file_user_select
	pop	cx
	mov	.record_cache_user,al
	mov	byte ptr .record_cache_dirty,0ffh
	mov	byte ptr .record_cache_valid,0ffh
	push	ds
	les	di,dword ptr .record_cache_buffer
	lds	si,dword ptr .transfer_buffer_offset
	cld
write_last_copy_byte:
	movsb
	or	si,si
	jnz	write_last_copy_next
	pop	ds
	mov	.transfer_buffer_offset,si
	mov	al,02h
	ret
write_last_copy_next:
	loop	write_last_copy_byte
	pop	ds
	mov	.transfer_buffer_offset,si
	db	033h,0c0h				; xor ax,ax (original encoding)
	ret

; Open missing private FCB slot through AH=0Fh logic while preserving caller
; DOS function/status and application record size. AL=0 success, 1 failure.
open_fcb_on_demand:
	les	si,dword ptr .dos_fcb_offset
	push	word ptr .bios_frame_ax
	push	word ptr .dos_saved_ax
	db	026h					; ES override; original addressing
	push	word ptr 0eh[si]
	mov	byte ptr .dos_saved_function,0fh
	db	08bh,0d6h				; mov dx,si (original encoding)
	call	dos_fn_open_fcb
	les	si,dword ptr .dos_fcb_offset
	db	026h					; ES override; original addressing
	pop	word ptr 0eh[si]
	mov	ax,.dos_saved_ax
	pop	word ptr .dos_saved_ax
	pop	word ptr .bios_frame_ax
	xor	ah,ah
	cmp	al,0ffh
	jnz	open_on_demand_result
	mov	ah,01h
open_on_demand_result:
	mov	al,ah
	ret


; AH=29h: parse application DS:SI into ES:DI FCB; return advanced SI and AL.
; The internal parser is also used while constructing the child PSP.
dos_fn_parse_filename:
	mov	si,.dos_saved_si
	mov	di,.dos_saved_di
	mov	es,word ptr .dos_saved_es
	mov	ds,word ptr .dos_caller_ds
	call	parse_dos_fcb
	call	select_console_data
	mov	.dos_saved_si,si
	mov	.dos_saved_ax,al
	ret

; Save caller registers and use per-console scratch for parsed fields.
; AL bit 0 skips delimiters; bits 1/2/3 preserve absent drive/name/type.
; Expand star to question marks and retain the first unconsumed delimiter.
parse_dos_fcb:
	push	ax
	push	cx
	push	di
	push	si
	push	es
	push	ds
	push	bp
	db	08bh,0ech				; mov bp,sp (original encoding)
	cld
	push	ds
	call	select_console_data
	mov	ax,ds
	pop	ds
	mov	es,ax
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	di,parse_status
	stosb
	stosw
	stosw
	mov	ax,02020h
	stosw
	stosw
	stosw
	stosw
	stosw
	stosb
	mov	di,parse_fcb_offset
	test	byte ptr 0ch[bp],01h
	jz	parse_drive_prefix
	call	parse_skip_delimiters
	or	al,al
	jnz	parse_copy_result
parse_drive_prefix:
	inc	di
	cmp	byte ptr 01h[si],03ah
	jnz	parse_name_begin
	dec	di
	mov	es:byte ptr .parse_drive_present,0ffh
	lodsw
	or	al,020h
	sub	al,060h
	ja	parse_drive_upper_bound
parse_invalid_drive:
	mov	es:byte ptr .parse_status,0ffh
	inc	di
	jmps	parse_name_begin

; A..P becomes 1..16; reject larger drive numbers.
parse_drive_upper_bound:
	cmp	al,010h
	ja	parse_invalid_drive
	stosb
parse_name_begin:
	mov	cx,08h
parse_name_character:
	lodsb
	cmp	al,02eh
	jz	parse_type_begin
	call	parse_classify_character
	jna	parse_leave_delimiter
	mov	es:byte ptr .parse_name_present,0ffh
	call	parse_expand_star
	jcxz	parse_type_begin
	stosb
	loop	parse_name_character
parse_type_begin:
	db	003h,0f9h				; add di,cx (original encoding)
	mov	cx,03h
	lodsb
	cmp	al,02eh
	jnz	parse_type_validate
parse_type_character:
	lodsb
parse_type_validate:
	call	parse_classify_character
	jna	parse_leave_delimiter
	mov	es:byte ptr .parse_type_present,0ffh
	call	parse_expand_star
	jcxz	parse_copy_result
	stosb
	loop	parse_type_character
	jmps	parse_copy_result
parse_leave_delimiter:
	dec	si
	inc	cl

; Copy only selected/present fields back to the caller FCB; save updated SI
; into the stack frame, then return the private status byte in AL.
parse_copy_result:
	push	es
	pop	ds
	mov	06h[bp],si
	mov	si,parse_fcb_offset
	mov	es,word ptr 04h[bp]
	mov	di,08h[bp]
	test	byte ptr 0ch[bp],02h
	jz	parse_copy_drive
	test	byte ptr .parse_drive_present,0ffh
	jz	parse_copy_name_check
parse_copy_drive:
	movsb
parse_copy_name_check:
	mov	di,08h[bp]
	inc	di
	mov	si,parse_fcb_offset_1
	test	byte ptr 0ch[bp],04h
	jz	parse_copy_name
	test	byte ptr .parse_name_present,0ffh
	jz	parse_copy_type_check
parse_copy_name:
	mov	cx,04h
	rep	movsw
parse_copy_type_check:
	mov	di,08h[bp]
	add	di,09h
	mov	si,parse_fcb_offset_9
	test	byte ptr 0ch[bp],08h
	jz	parse_copy_type
	test	byte ptr .parse_type_present,0ffh
	jz	parse_restore_caller
parse_copy_type:
	movsw
	movsb
parse_restore_caller:
	pop	bp
	pop	ds
	pop	es
	pop	si
	pop	di
	pop	cx
	pop	ax
	push	ds
	call	select_console_data
	mov	al,.parse_status
	pop	ds
	ret

; Expand star across remaining field width, recording wildcard status.
parse_expand_star:
	cmp	al,02ah
	jnz	parse_star_return
	or	es:byte ptr .parse_status,01h
	mov	al,03fh
	rep	stosb
	or	ah,01h
parse_star_return:
	ret

; Fold ASCII 60h..7Ah and compare against twelve delimiters in private DATA.
; Return ZF for delimiter, or comparison with space for other bytes.
parse_classify_character:
	cmp	al,060h
	jc	parse_check_delimiter
	cmp	al,07bh
	jnc	parse_check_delimiter
	and	al,05fh
parse_check_delimiter:
	push	cx
	mov	cx,0ch
	push	di
	mov	di,dos_delimiters_offset
	repne	scasb
	pop	di
	pop	cx
	jz	parse_character_result
	cmp	al,020h
parse_character_result:
	ret

; Skip delimiter bytes using caller CX; control characters stop with AL=FFh.
; Leave SI on the first non-skipped byte and AL=0 otherwise.
parse_skip_delimiters:
	lodsb
	call	parse_classify_character
	jc	parse_control_terminator
	loope	parse_skip_delimiters
	dec	si
	inc	cl
	mov	al,00h
	ret
parse_control_terminator:
	dec	si
	inc	cl
	mov	al,0ffh
	ret


; AH=2Ah: convert the shared clock day word to CX=year, DH=month, DL=day.
; AL is always zero in this original implementation (no weekday calculation).
dos_fn_get_date:
	les	si,dword ptr .native_clock_pointer
	db	026h					; ES override; original addressing
	mov	ax,[si]
	call	native_days_to_date
	mov	.bios_frame_cx,cx
	mov	.bios_frame_dx,dx
	mov	byte ptr .dos_saved_ax,00h
	ret

; Convert native day count using the original 1980 baseline and four-year
; leap cycle. Month boundaries come from the cumulative-day table.
native_days_to_date:
	sub	ax,02dah
	db	08bh,0c8h				; mov cx,ax (original encoding)
	db	033h,0d2h				; xor dx,dx (original encoding)
	db	08bh,0fah				; mov di,dx (original encoding)
	sub	ax,03ch
	jc	date_year_divide
	mov	bx,05b5h
	div	bx
	inc	ax
	db	02bh,0c8h				; sub cx,ax (original encoding)
	db	08bh,0f8h				; mov di,ax (original encoding)
date_year_divide:
	db	08bh,0c1h				; mov ax,cx (original encoding)
	db	033h,0d2h				; xor dx,dx (original encoding)
	mov	bx,016dh
	div	bx
	or	dx,dx
	jnz	date_year_ready
	dec	ax
	mov	dx,016dh
date_year_ready:
	db	08bh,0f0h				; mov si,ax (original encoding)
	add	ax,07bch
	push	ax
	db	033h,0dbh				; xor bx,bx (original encoding)
	mov	cx,0ch
date_find_month:
	cmp	dx,month_starts_offset[bx]
	jna	date_month_ready
	add	bx,02h
	loop	date_find_month
date_month_ready:
	shr	bx,1
	push	bx
	dec	bx
	shl	bx,1
	db	08bh,0c6h				; mov ax,si (original encoding)
	db	08bh,0cfh				; mov cx,di (original encoding)
	cmp	bx,02h
	jnz	date_day_ready
	test	ax,03h
	jnz	date_day_ready
	shr	ax,1
	shr	ax,1
	inc	ax
	cmp	ax,cx
	jnz	date_day_ready
	inc	dx
date_day_ready:
	sub	dx,month_starts_offset[bx]
	pop	ax
	mov	dh,al
	pop	cx
	ret

; AH=2Bh: validate year 1980..2099, month and day, then replace native day word.
; February length uses year modulo four; AL=0 success, FFh invalid.
dos_fn_set_date:
	mov	byte ptr .dos_saved_ax,0ffh
	db	08bh,0c1h				; mov ax,cx (original encoding)
	sub	ax,07bch
	cmp	ax,077h
	ja	set_date_return
	mov	byte ptr .month_days_offset_1,01ch
	test	ax,03h
	jnz	set_date_check_month
	mov	byte ptr .month_days_offset_1,01dh
set_date_check_month:
	xor	bh,bh
	mov	bl,dh
	dec	bl
	cmp	bl,0ch
	jnc	set_date_return
	cmp	dl,01h
	jc	set_date_return
	cmp	month_days_offset[bx],dl
	jc	set_date_return
	db	003h,0dbh				; add bx,bx (original encoding)
	mov	ax,month_starts_offset[bx]
	xor	dh,dh
	db	003h,0c2h				; add ax,dx (original encoding)
	push	ax
	db	08bh,0c1h				; mov ax,cx (original encoding)
	sub	ax,07bah
	mov	bx,016dh
	mul	bx
	pop	bx
	db	003h,0c3h				; add ax,bx (original encoding)
	db	08bh,0c8h				; mov cx,ax (original encoding)
	sub	ax,0316h
	jc	set_date_store
	mov	bx,05b5h
	db	02bh,0d2h				; sub dx,dx (original encoding)
	div	bx
	inc	ax
	db	003h,0c8h				; add cx,ax (original encoding)
set_date_store:
	les	bx,dword ptr .native_clock_pointer
	db	026h					; ES override; original addressing
	mov	[bx],cx
	mov	byte ptr .dos_saved_ax,00h
set_date_return:
	ret

; AH=2Dh: validate CH hours, CL minutes and DH seconds, then write BCD clock
; bytes. DL hundredths is ignored. AL=0 success, FFh invalid.
dos_fn_set_time:
	mov	byte ptr .dos_saved_ax,0ffh
	cmp	ch,017h
	ja	set_time_return
	cmp	cl,03bh
	ja	set_time_return
	cmp	dh,03bh
	ja	set_time_return
	les	si,dword ptr .native_clock_pointer
	mov	bl,0ah
	mov	al,ch
	call	binary_to_bcd
	db	026h					; ES override; original addressing
	mov	02h[si],al
	mov	al,cl
	call	binary_to_bcd
	db	026h					; ES override; original addressing
	mov	03h[si],al
	mov	al,dh
	call	binary_to_bcd
	db	026h					; ES override; original addressing
	mov	04h[si],al
	mov	byte ptr .dos_saved_ax,00h
set_time_return:
	ret

; Convert binary AL to packed BCD AL, with BL=10. Preserve CX, destroy AH.
binary_to_bcd:
	sub	ah,ah
	div	bl
	push	cx
	mov	cl,04h
	shl	al,cl
	or	al,ah
	pop	cx
	ret

; AH=2Ch: decode BCD hours/minutes/seconds from the native clock packet.
; CH=hours, CL=minutes, DH=seconds, DL=0; no hundredths are supplied.
dos_fn_get_time:
	les	si,dword ptr .native_clock_pointer
	db	026h					; ES override; retain original instruction addressing
	mov	al,2[si]
	call	bcd_to_binary
	mov	byte ptr .dos_frame_offset_13,al
	db	026h					; ES override; retain original instruction addressing
	mov	al,3[si]
	call	bcd_to_binary
	mov	byte ptr .bios_frame_cx,al
	db	026h					; ES override; retain original instruction addressing
	mov	al,4[si]
	call	bcd_to_binary
	mov	ah,al
	xor	al,al
	mov	word ptr .bios_frame_dx,ax
	mov	byte ptr .dos_saved_ax,al
	ret
; Convert packed BCD AL to binary AL; destroys BL/CL, preserves high AX byte.
bcd_to_binary:
	mov	bl,10
	push	ax
	mov	cl,4
	shr	al,cl
	mul	bl
	mov	cl,al
	pop	ax
	and	al,0fh
	add	al,cl
	ret
; AH=2Eh has no verify-on-write implementation.
dos_fn_verify:
	ret
; AH=2Fh returns the current DOS DTA as application ES:BX.
dos_fn_get_dta:
	mov	bx,word ptr .dos_dta_offset
	mov	ax,word ptr .dos_dta_segment
	mov	word ptr .bios_frame_bx,bx
	mov	word ptr .dos_saved_es,ax
	ret

; INT 21h/AH=30h routes to the project version-query implementation.
dos_fn_get_version:
	jmp	dos_version_query
	nop
	nop
	nop


; Report the private file-error message, then enter the DOS critical-error path.
dos_file_error:
	mov	cx,invalid_dos_message_offset
	call	dos_print_string
	mov	ax,0800ch
	jmp	dos_critical_error

; Resolve application DS:DX FCB (saved adjacent frame words).
; FFh prefix denotes an extended FCB: capture attribute at +6 and skip 7 bytes.
; Save the resulting far pointer; return ES:SI, DI=DX=SI.
select_dos_fcb:
	mov	byte ptr .dos_fcb_attribute,00h
	mov	byte ptr .dos_extended_fcb,00h
	les	si,dword ptr .bios_frame_dx
	mov	word ptr .dos_fcb_segment,es
	db	026h					; ES override; original addressing
	cmp	byte ptr [si],0ffh
	jnz	dos_fcb_selected
	mov	byte ptr .dos_extended_fcb,0ffh
	add	si,06h
	db	026h					; ES override for LODSB
	lodsb
	mov	.dos_fcb_attribute,al
dos_fcb_selected:
	mov	.dos_fcb_offset,si
	db	08bh,0feh				; mov di,si (original encoding)
	db	08bh,0d6h				; mov dx,si (original encoding)
	ret

; Test the internal device marker: FCB bytes +10h/+11h equal and bit 7 set.
; AL=FFh and ZF clear for a device; otherwise AL=0 and ZF set.
check_device_fcb:
	db	033h,0c0h				; xor ax,ax (original encoding)
	mov	cx,010h[bx]
	cmp	ch,cl
	jnz	device_fcb_result
	and	cl,080h
	jz	device_fcb_result
	mov	al,0ffh
device_fcb_result:
	or	al,al
	ret

; Copy twelve FCB drive/name/type bytes DS:SI to ES:DI.
; Strip attribute bits, uppercase ASCII a..z, append four zero bytes; DF=0.
copy_normalized_fcb:
	cld
	mov	cx,0ch
normalize_fcb_character:
	lodsb
	and	al,07fh
	cmp	al,061h
	jc	store_fcb_character
	cmp	al,07ah
	ja	store_fcb_character
	and	al,05fh
store_fcb_character:
	stosb
	loop	normalize_fcb_character
	db	033h,0c0h				; xor ax,ax (original encoding)
	stosw
	stosw
	ret

; Find a free entry among 24 private FCB slots, stride 40 bytes.
; FFh in the first byte marks free. Save slot pointer and copy normalized name.
; Return AL=0 on success, FFh if full; restore DS and application ES:DI.
allocate_fcb_slot:
	mov	si,dos_file_slots
	mov	cx,fcb_slot_count
scan_free_fcb_slot:
	cmp	byte ptr [si],0ffh
	jz	initialize_fcb_slot
	add	si,fcb_slot_bytes
	loop	scan_free_fcb_slot
	mov	al,0ffh
	or	al,al
	ret
initialize_fcb_slot:
	mov	.dos_fcb_slot,si
	mov	ax,ds
	mov	es,ax
	db	08bh,0feh				; mov di,si (original encoding)
	push	ds
	lds	si,dword ptr .dos_fcb_offset
	push	si
	cld
	call	copy_normalized_fcb
	pop	di
	mov	ax,ds
	mov	es,ax
	pop	ds
	xor	al,al
	ret

; Match application FCB against the 24 private slots, ignoring attribute bits
; and letter case. Return AL=0 and saved slot pointer, or AL=FFh if absent.
find_fcb_slot:
	cld
	mov	si,dos_file_slots
	mov	cx,fcb_slot_count
	les	di,dword ptr .dos_fcb_offset
compare_fcb_slot:
	push	di
	mov	bl,0ch
	push	si
compare_fcb_character:
	lodsb
	and	al,07fh
	db	026h					; ES override; original addressing
	mov	dl,[di]
	and	dl,07fh
	cmp	dl,061h
	jc	compare_fcb_uppercase
	cmp	dl,07ah
	ja	compare_fcb_uppercase
	and	dl,05fh
compare_fcb_uppercase:
	inc	di
	cmp	al,dl
	jnz	next_fcb_slot
	dec	bl
	jnz	compare_fcb_character
	pop	si
	jmps	found_fcb_slot
next_fcb_slot:
	pop	si
	add	si,fcb_slot_bytes
	pop	di
	loop	compare_fcb_slot
	mov	al,0ffh
	or	al,al
	ret
found_fcb_slot:
	pop	di
	mov	.dos_fcb_slot,si
	xor	al,al
	ret

; Mark the selected private slot free when its pointer is within table bounds.
; Reject pointers outside the table or between slots; clear matching cache state.
release_fcb_slot:
	mov	di,.dos_fcb_slot
	cmp	di,dos_file_slots
	jc	release_fcb_done
	cmp	di,fcb_slots_end
	jae	release_fcb_done
	push	ax
	push	dx
	push	bx
	mov	ax,di
	sub	ax,dos_file_slots
	xor	dx,dx
	mov	bx,fcb_slot_bytes
	div	bx
	or	dx,dx
	pop	bx
	pop	dx
	pop	ax
	jnz	release_fcb_done
	mov	byte ptr [di],0ffh
	mov	ax,.cached_fcb_slot
	cmp	ax,.dos_fcb_slot
	jnz	release_fcb_done
	mov	byte ptr .record_cache_dirty,00h
	mov	byte ptr .record_cache_valid,00h
release_fcb_done:
	ret

; Multiply unsigned BX:AX by CX, returning low 32 bits in BX:AX.
; Upper product overflow is discarded; DX is scratch.
multiply_record_offset:
	mul	cx
	push	dx
	xchg	ax,bx
	mul	cx
	pop	dx
	db	003h,0c2h				; add ax,dx (original encoding)
	xchg	ax,bx
	ret

; Convert DX:AX record index to byte offset by shifting left seven bits.
; Return DX:AX; overflow is discarded, CL is scratch.
records_to_bytes:
	mov	cl,07h
	shl	dx,cl
	rol	ax,cl
	mov	cl,al
	and	cl,07fh
	or	dl,cl
	and	al,080h
	ret

; Convert DX:AX byte offset to 128-byte record index in DX:AX.
; Return low-seven-bit byte remainder in CH; CL is scratch.
bytes_to_records:
	mov	cl,07h
	ror	dx,cl
	mov	ch,al
	and	ch,07fh
	shr	ax,cl
	mov	cl,dh
	and	cl,0feh
	or	ah,cl
	and	dh,01h
	ret

; Divide unsigned BX:AX by CX. Return quotient DX:AX and remainder CX.
; Divisor zero returns AX=BX=DX=FFFFh; modifies DI in the general case.
divide_record_offset:
	jcxz	divide_record_zero
	cmp	cx,01h
	jnz	divide_record_general
	db	08bh,0d3h				; mov dx,bx (original encoding)
	db	033h,0c9h				; xor cx,cx (original encoding)
	ret
divide_record_general:
	db	033h,0d2h				; xor dx,dx (original encoding)
	xchg	ax,bx
	push	ax
	div	cx
	db	08bh,0f8h				; mov di,ax (original encoding)
	mul	cx
	pop	dx
	db	02bh,0d0h				; sub dx,ax (original encoding)
	db	08bh,0c3h				; mov ax,bx (original encoding)
	div	cx
	db	08bh,0cah				; mov cx,dx (original encoding)
	db	08bh,0d7h				; mov dx,di (original encoding)
	ret
divide_record_zero:
	mov	ax,0ffffh
	db	08bh,0d8h				; mov bx,ax (original encoding)
	db	08bh,0d0h				; mov dx,ax (original encoding)
	ret

; Prepare random block transfer from DOS FCB record size and random record.
; Save DTA, byte count (FFFFh on 16-bit overflow), first/last byte offsets,
; first/last CP/M records and partial-record boundaries. Record sizes >=64
; use only 24 random-record bits; smaller sizes use the full 32-bit field.
prepare_random_transfer:
	les	ax,dword ptr .dos_dta_offset
	mov	.transfer_buffer_offset,ax
	mov	word ptr .transfer_dma_offset_2,es
	mov	ax,.transfer_requested_records
	push	ds
	lds	si,dword ptr .dos_fcb_offset
	mov	cx,0eh[si]
	mul	cx
	or	dl,dh
	pop	ds
	mov	.transfer_overflow_offset,dl
	jz	transfer_size_ready
	mov	ax,0ffffh
transfer_size_ready:
	mov	.transfer_size_offset,ax
	push	ds
	lds	si,dword ptr .dos_fcb_offset
	mov	bx,023h[si]
	mov	ax,021h[si]
	cmp	word ptr 0eh[si],040h
	jc	random_record_ready
	xor	bh,bh
random_record_ready:
	pop	ds
	call	multiply_record_offset
	mov	.transfer_start_offset,ax
	mov	.transfer_start_high,bx
	push	ax
	db	08bh,0d3h				; mov dx,bx (original encoding)
	add	ax,.transfer_size_offset
	adc	bx,00h
	sub	ax,01h
	sbb	bx,00h
	mov	.transfer_size_offset_6,ax
	mov	.transfer_size_offset_8,bx
	pop	ax
	call	bytes_to_records
	mov	.transfer_first_record,ax
	mov	.transfer_boundaries_offset_6,dl
	mov	.transfer_first_byte,ch
	neg	ch
	add	ch,080h
	mov	.transfer_boundaries_offset_2,ch
	mov	dx,.transfer_size_offset_8
	mov	ax,.transfer_size_offset_6
	call	bytes_to_records
	mov	.transfer_boundaries_offset_10,ax
	mov	.transfer_boundaries_offset_12,dl
	mov	.transfer_last_byte,ch
	mov	ax,.transfer_boundaries_offset_10
	sub	ax,.transfer_first_record
	mov	.transfer_record_span,ax
	ret

; Restore native DMA from the saved DOS DTA far pointer.
restore_dos_dma:
	les	dx,dword ptr .dos_dta_offset
	jmp	set_loader_dma

; Native BDOS gateway: call the saved INT E0h vector with an interrupt frame.
; The callee's IRET consumes PUSHF; AX/BX are results, other listed registers
; are restored here. The caller's DS already selects its expected DATA.
loader_bdos_call:
	push	es
	push	cx
	push	dx
	push	si
	push	di
	push	bp
	pushf
	cli
	callf	cs:dword ptr shared_bdos_vector
	pop	bp
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	es
	ret
; Variant discarding native AX/BX results as well.
bdos_preserve_results:
	push	ax
	push	bx
	call	loader_bdos_call
	pop	bx
	pop	ax
	ret
; Original 64-byte NOP reserve preceding the DOS dispatch table (not handlers).
original_bdos_reserve:
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop


; AH indexes this near-offset table; index 31h is the catch-all fallback.
dos_fn_terminate_unused		equ	dos_no_service
dos_fn_find_next		equ	dos_fn_find_first
dos_fn_create_fcb		equ	dos_fn_open_fcb
dos_fn_inuse_stub		equ	dos_no_service
dos_fn_alloc_selected_stub	equ	dos_no_service
dos_fn_readonly_stub		equ	dos_no_service
dos_fn_attributes_stub		equ	dos_no_service
dos_fn_dpb_stub			equ	dos_no_service
dos_fn_usercode_stub		equ	dos_no_service
dos_fn_unsupported		equ	dos_no_service
dos_function_table:
	dw	dos_fn_terminate_unused			; AH=00h
	dw	dos_fn_console_input			; AH=01h
	dw	dos_fn_console_output			; AH=02h
	dw	dos_fn_aux_input			; AH=03h
	dw	dos_fn_aux_output			; AH=04h
	dw	dos_fn_printer_output			; AH=05h
	dw	dos_fn_direct_console			; AH=06h
	dw	dos_fn_raw_input			; AH=07h
	dw	dos_fn_checked_input			; AH=08h
	dw	dos_fn_print_string			; AH=09h
	dw	dos_fn_buffered_input			; AH=0Ah
	dw	dos_fn_console_status			; AH=0Bh
	dw	dos_fn_flush_input			; AH=0Ch
	dw	dos_fn_disk_reset			; AH=0Dh
	dw	dos_fn_select_drive			; AH=0Eh
	dw	dos_fn_open_fcb				; AH=0Fh
	dw	dos_fn_close_fcb			; AH=10h
	dw	dos_fn_find_first			; AH=11h
	dw	dos_fn_find_next			; AH=12h
	dw	dos_fn_delete_fcb			; AH=13h
	dw	dos_fn_sequential_read			; AH=14h
	dw	dos_fn_sequential_write			; AH=15h
	dw	dos_fn_create_fcb			; AH=16h
	dw	dos_fn_rename_fcb			; AH=17h
	dw	dos_fn_inuse_stub			; AH=18h
	dw	dos_fn_current_drive			; AH=19h
	dw	dos_fn_set_dta				; AH=1Ah
	dw	dos_fn_allocation_info			; AH=1Bh
	dw	dos_fn_alloc_selected_stub		; AH=1Ch
	dw	dos_fn_readonly_stub			; AH=1Dh
	dw	dos_fn_attributes_stub			; AH=1Eh
	dw	dos_fn_dpb_stub				; AH=1Fh
	dw	dos_fn_usercode_stub			; AH=20h
	dw	dos_fn_random_read			; AH=21h
	dw	dos_fn_random_write			; AH=22h
	dw	dos_fn_file_size			; AH=23h
	dw	dos_fn_set_random			; AH=24h
	dw	dos_fn_set_vector			; AH=25h
	dw	dos_fn_new_psp				; AH=26h
	dw	dos_fn_block_read			; AH=27h
	dw	dos_fn_block_write			; AH=28h
	dw	dos_fn_parse_filename			; AH=29h
	dw	dos_fn_get_date				; AH=2Ah
	dw	dos_fn_set_date				; AH=2Bh
	dw	dos_fn_get_time				; AH=2Ch
	dw	dos_fn_set_time				; AH=2Dh
	dw	dos_fn_verify				; AH=2Eh
	dw	dos_fn_get_dta				; AH=2Fh
	dw	dos_fn_get_version			; AH=30h
dos_function_fallback:
	dw	dos_fn_unsupported			; AH=31h


; Interrupt installation aliases for the decoded gateway entry points.
dos_terminate_handler		equ	dos_terminate_entry
dos_dispatch_handler		equ	dos_dispatch_entry

;------------------------------------------------------------------------------
; interrupt_vectors (3713h)
; Fourteen packed records: interrupt number (byte), handler offset (word).
; The installation loop at 14FEh supplies CS for each vector's segment word.
; PD user-dispatch callbacks manage ownership as the scheduler switches tasks.
;------------------------------------------------------------------------------
interrupt_vectors:
	db	10h
	dw	bios_video_handler			; routes to legacy XIOS functions 30/31
	db	11h
	dw	bios_equipment_handler			; routes to legacy XIOS function 34
	db	12h
	dw	bios_memory_handler
	db	13h
	dw	bios_disk_handler			; internal BDOS function 2Fh
	db	16h
	dw	bios_keyboard_handler
	db	17h
	dw	bios_printer_handler
	db	20h
	dw	dos_terminate_handler
	db	21h
	dw	dos_dispatch_handler			; function table at 36AFh
	db	22h
	dw	dos_return_handler
	db	23h
	dw	dos_ctrl_c_handler
	db	24h
	dw	dos_error_handler
	db	25h
	dw	dos_disk_read_handler
	db	26h
	dw	dos_disk_write_handler
	db	27h
	dw	dos_resident_handler
interrupt_vectors_end:

; Original region 373Dh..37DFh: final tables and paragraph padding.

; DOS device-name records: eight padded name bytes plus internal device ID.
; CON=FFh, AUX/COM1=FEh, NUL=FDh, LPT1/PRN=FCh.
dos_device_names:
	db	'CON     ',0ffh
	db	'AUX     ',0feh
	db	'COM1    ',0feh
	db	'NUL     ',0fdh
	db	'LPT1    ',0fch
	db	'PRN     ',0fch
dos_device_names_end:
; Private service 7 returns this table's offset. Eleven eight-byte slots,
; of which six contain names; the remaining five slots are blank.
dos_command_names:
	db	'DIR     '
	db	'COPY    '
	db	'TIME    '
	db	'DATE    '
	db	'REN     '
	db	'ERASE   '
	db	'        '
	db	'        '
	db	'        '
	db	'        '
	db	'        '
dos_command_names_end:
; Launch banner suffix; callers choose all 19 bytes or skip the first nine.
dos_launch_suffix:
	db	' (User 0) PC-MODE',13,10
	db	0,0					; original paragraph padding


	include	pcguard.lib

; Only the checked/echoing DOS input path comes here. Ctrl-C must unwind the
; dispatcher frame before invoking INT 23h; jumping to the existing helper
; discards this call's return address along with the other internal frames.
; Do not directly invoke INT 23h on this temporary dispatcher stack.
dos_read_checked:
	call	raw_console_input
	cmp	al,3
	je	dos_input_break
	ret
dos_input_break:
	jmp	unwind_dos_break			; restore user SS:SP and dispatch INT 23h
	org	(offset $+15) and 0fff0h

; The recovered packet path discards XIOS AX when it pops the INT 10h frame.
; Only AH=0Dh defines a pixel-color return here. Copy its successful AL into
; that frame; preserve original AH and all other packet-operation registers.
; FFFFh is the bridge's unsupported/rejected result: retain the caller's AL.
; This helper adds no state and runs on the existing per-console private stack.
bios_video_packet_result:
	call	xios_gateway
	cmp	si,0d1fh
	jne	bios_video_packet_done
	cmp	ax,0ffffh
	je	bios_video_packet_done
	mov	byte ptr .bios_frame_ax,al
bios_video_packet_done:
	ret
	org	(offset $+15) and 0fff0h

	include	pcshell.lib
	include	pcerror.lib

	include	pchelp.lib

	include	pcsearch.lib

; Project version-query extension: AL=1, AH=25 decimal (AX=1901h).
; Update only saved AX; this DOS 1.x personality defines no OEM/serial outputs.
dos_version_query:
	mov	word ptr .dos_saved_ax,01901h
	ret

	end
