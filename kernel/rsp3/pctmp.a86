        db 025h,07fh,07fh,02eh,039h,005h,075h,004h,047h,047h,0e2h,0f3h,05eh,05fh,00bh,0c9h
        db 08bh,0c3h,074h,012h,083h,0c7h,008h,081h,0ffh,0cbh,037h,075h,0ddh,03bh,006h,0a8h
