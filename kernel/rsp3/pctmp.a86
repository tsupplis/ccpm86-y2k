;------------------------------------------------------------------------------
; submit_native_command (07B4h), shared by the CLI launch setup paths.
; DS:DX already addresses their CLI control block. Mark a command sent so
; the next prompt adds a newline, then use supervisor CLI function 150.
; A zero BX result branches to the original success path at 07D5h;
; errors continue at 07C3h. Native lookup therefore reaches our supervisor's
; SETDEF policy after PCTMP has already found a candidate file. Its earlier
; fixed CMD/COM/EXE/BAT pre-search can prevent reaching CLI at all, as the
; bare SUB regression demonstrates. DOS lookup also needs separate review.
;------------------------------------------------------------------------------
submit_native_command:
        mov byte ptr .command_sent,0ffh
        mov cl,150
        call ccpm_call
        cmp bx,0
        je native_cli_success
