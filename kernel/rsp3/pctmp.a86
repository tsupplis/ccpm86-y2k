        db 0b2h,0ffh,0e8h,07fh,027h,059h,0c3h,026h,0ach,050h,0b1h,004h,0d2h,0e8h,004h,030h
        db 08ah,0d0h,0e8h,0e3h,0ffh,058h,024h,00fh,004h,030h,08ah,0d0h,0e8h,0d9h,0ffh,0c3h
        db 08ch,0d8h,08eh,0c0h,042h,089h,016h,0abh,005h,0b1h,019h,0e8h,056h,027h,0a2h,0a8h
        db 003h,0a2h,0a9h,003h,0e8h,031h,0ffh,0beh,020h,002h,0c6h,006h,053h,004h,000h,0f6h
