; Remaining handler offsets are retained until their bodies are reconstructed. Roles
; are established from this installation table and the corresponding gateways.
bios_memory_handler      equ 17cfh
bios_disk_handler        equ 17e2h
bios_printer_handler     equ 18e8h
dos_terminate_handler    equ 19b2h
dos_dispatch_handler equ code_origin+1a11h
dos_return_handler equ code_origin+1532h
dos_ctrl_c_handler       equ 1a9bh
dos_error_handler        equ 1bd1h
dos_disk_read_handler    equ 1d11h
dos_disk_write_handler   equ 1d5ch
dos_resident_handler     equ 1d6bh

;------------------------------------------------------------------------------
; interrupt_vectors (3713h)
; Fourteen packed records: interrupt number (byte), handler offset (word).
; The installation loop at 14FEh supplies CS for each vector's segment word.
; PD user-dispatch callbacks manage ownership as the scheduler switches tasks.
;------------------------------------------------------------------------------
interrupt_vectors:
        db 10h
        dw bios_video_handler        ; routes to legacy XIOS functions 30/31
        db 11h
        dw bios_equipment_handler    ; routes to legacy XIOS function 34
        db 12h
        dw bios_memory_handler
        db 13h
        dw bios_disk_handler         ; internal BDOS function 2Fh
        db 16h
        dw bios_keyboard_handler
        db 17h
        dw bios_printer_handler
        db 20h
        dw dos_terminate_handler
        db 21h
        dw dos_dispatch_handler      ; function table at 36AFh
        db 22h
        dw dos_return_handler
        db 23h
        dw dos_ctrl_c_handler
        db 24h
        dw dos_error_handler
        db 25h
        dw dos_disk_read_handler
        db 26h
        dw dos_disk_write_handler
        db 27h
        dw dos_resident_handler

; UNDECODED 373Dh..37DFh: final tables and paragraph padding.
; Preserved original CODE bytes 373Dh..37DFh (undecoded/data).
        db 043h,04fh,04eh,020h,020h,020h,020h,020h,0ffh,041h,055h,058h,020h,020h,020h,020h
        db 020h,0feh,043h,04fh,04dh,031h,020h,020h,020h,020h,0feh,04eh,055h,04ch,020h,020h
        db 020h,020h,020h,0fdh,04ch,050h,054h,031h,020h,020h,020h,020h,0fch,050h,052h,04eh
        db 020h,020h,020h,020h,020h,0fch,044h,049h,052h,020h,020h,020h,020h,020h,043h,04fh
        db 050h,059h,020h,020h,020h,020h,054h,049h,04dh,045h,020h,020h,020h,020h,044h,041h
        db 054h,045h,020h,020h,020h,020h,052h,045h,04eh,020h,020h,020h,020h,020h,045h,052h
        db 041h,053h,045h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h
        db 020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h
        db 020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,020h,028h
        db 055h,073h,065h,072h,020h,030h,029h,020h,050h,043h,02dh,04dh,04fh,044h,045h,00dh
        db 00ah,000h,000h

if PCMODE_SAFE_LOADER
include pcguard.lib
endif

if PCMODE_CHECKED_INPUT
; Only the checked/echoing DOS input path comes here. Ctrl-C must unwind the
; dispatcher frame before invoking INT 23h; jumping to the existing helper
; discards this call's return address along with the other internal frames.
; Do not directly invoke INT 23h on this temporary dispatcher stack.
dos_read_checked:
        call raw_console_input
        cmp al,3
        je dos_input_break
        ret
dos_input_break:
        jmp unwind_dos_break               ; restore user SS:SP and dispatch INT 23h
        org (offset $+15) and 0fff0h
endif

if PCMODE_PIXEL_READ
; The recovered packet path discards XIOS AX when it pops the INT 10h frame.
; Only AH=0Dh defines a pixel-color return here. Copy its successful AL into
; that frame; preserve original AH and all other packet-operation registers.
; FFFFh is the bridge's unsupported/rejected result: retain the caller's AL.
; This helper adds no state and runs on the existing per-console private stack.
bios_video_packet_result:
        call xios_gateway
        cmp si,0d1fh
        jne bios_video_packet_done
        cmp ax,0ffffh
        je bios_video_packet_done
        mov byte ptr .bios_frame_ax,al
bios_video_packet_done:
        ret
        org (offset $+15) and 0fff0h
endif

if PCMODE_SHELL
include pcshell.lib
include pcerror.lib
endif

if PCMODE_HELP
include pchelp.lib
endif

if PCMODE_SEARCH
include pcsearch.lib
endif

dseg
org 0
include pcdata.lib
end
