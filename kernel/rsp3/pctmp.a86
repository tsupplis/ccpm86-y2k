; build_child_launch_frame (147Ch)
; The EXE guard validates these five WORD destinations before this code runs.
; COM adds a zero return address first, for RET-to-PSP termination. SI arithmetic
; deliberately wraps at 16 bits: SP=0 builds the frame at the segment's top.
; Final frame: PCTMP launch IP:CS, FLAGS, child IP:CS. The launch continuation
; eventually consumes it and leaves the application's specified initial SP.
;------------------------------------------------------------------------------
build_child_launch_frame:
        push es
        mov es,word ptr .child_stack_segment
        mov si,word ptr .child_stack_offset
        cmp byte ptr .child_is_com,0ffh
        jne child_frame_exe
        dec si
        dec si
        mov es:word ptr [si],0
child_frame_exe:
        dec si
        dec si
        mov ax,word ptr .child_entry_segment
        mov es:word ptr [si],ax
        dec si
        dec si
        mov ax,word ptr .child_entry_offset
        mov es:word ptr [si],ax
        dec si
        dec si
        mov es:word ptr [si],200h        ; enable interrupts on child entry
        dec si
        dec si
        mov ax,cs
        mov es:word ptr [si],ax
        dec si
        dec si
        mov ax,offset child_launch_entry    ; recovered PCTMP launch continuation
        mov es:word ptr [si],ax
        pop es
        ret

; UNDECODED 14BBh..15A6h: child entry, interrupt installation and dispatch.
child_launch_entry:
; Preserved original CODE bytes 14BBh..15A6h (undecoded/data).
        db 08ch,0c3h,08eh,0c0h,026h,08bh,036h,068h,000h,09ch,0fah,026h,08ch,04ch,02ah,026h
        db 0c7h,044h,028h,060h,015h,026h,08eh,044h,010h,026h,0c6h,006h,010h,000h,0ffh,09dh
        db 08eh,0c1h,026h,08bh,00eh,080h,003h,02eh,089h,00eh,009h,01ah,026h,08bh,00eh,082h
        db 003h,02eh,089h,00eh,00bh,01ah,0b9h,08dh,015h,026h,089h,00eh,080h,003h,026h,08ch
        db 00eh,082h,003h,0beh,013h,037h,0b9h,00eh,000h,02eh,0ach,032h,0e4h,0d1h,0e0h,0d1h
        db 0e0h,097h,02eh,0a5h,026h,08ch,00dh,0e2h,0f0h,08eh,0c3h,033h,0c0h,08bh,0d8h,08bh
        db 0c8h,08bh,0f0h,08bh,0f8h,0cbh,08ch,0cah,0bbh,0f0h,019h,0b1h,004h,0d3h,0ebh,0d3h
        db 0e8h,003h,0dah,02bh,0d8h,093h,0c3h,0e8h,072h,000h,0c7h,006h,0a6h,006h,000h,000h
        db 0e8h,08fh,0f8h,0b1h,08fh,0b2h,0ffh,0e9h,00eh,021h,0e8h,05fh,000h,0ebh,0f1h,0b1h
        db 02ch,0e9h,004h,021h,0a1h,0ceh,003h,03dh,000h,010h,072h,004h,0b8h,0f0h,0ffh,0c3h
        db 0b1h,004h,0d3h,0e0h,0c3h,01eh,0e8h,043h,000h,006h,051h,0b9h,02fh,000h,00bh,0c0h
        db 075h,010h,0beh,040h,000h,0bfh,0ddh,005h,08ch,0d8h,08eh,0c0h,033h,0c0h,08eh,0d8h
        db 0ebh,00ah,0beh,0ddh,005h,0bfh,040h,000h,033h,0c0h,08eh,0c0h,0f3h,0a5h,059h,007h
        db 01fh,0cbh,080h,0f9h,000h,074h,005h,02eh,0ffh,02eh,009h,01ah,01eh,0e8h,00ch,000h
        db 0c7h,006h,0a6h,006h,000h,000h,01fh,02eh,0ffh,02eh,009h,01ah

;------------------------------------------------------------------------------
; select_console_data (15A7h)
; Used on intercepted interrupts, where the caller's DS belongs to a DOS app.
; Result: DS=this console's PCTMP DATA; AX, DX and BX preserved; DF cleared.
; Flags are not preserved. The running PD comes from SYSDAT:0068h.
;
; The DATA stride is an embedded ABI constraint, not a guessed buffer size.
; Four shifts convert 0AF0h bytes to paragraphs; console zero's DATA segment
; is then added. Shared CODE state is addressed explicitly with CS overrides.
;------------------------------------------------------------------------------
select_console_data:
        cld
        push ax
        push dx
        push bx
        mov ds,cs:word ptr .shared_sysdat_segment
        mov bx,word ptr .sd_running_process
        mov bl,byte ptr pd_console_number[bx]
        db 032h,0ffh              ; xor bh,bh: original register/register encoding
        mov ax,console_data_bytes
        shr ax,1
        shr ax,1
        shr ax,1
        shr ax,1
        mul bx
        add ax,cs:word ptr .shared_first_data_segment
        mov ds,ax
        pop bx
        pop dx
        pop ax
        ret


;------------------------------------------------------------------------------
; xios_gateway (15D1h): AL=function, BL=BIOS operation when AL=31.
; Select kernel DS and the running process UDA in ES. For packet operations
; preserve CX:DX; simple calls get DL=current PD console. AX/BX/CX are results.
; XIOS itself exchanges AX/BX on entry; its return also copies AX into BX.
;------------------------------------------------------------------------------
xios_gateway:
        push dx
        push si
        push es
        push ds
        mov ds,cs:word ptr .shared_sysdat_segment
        mov si,word ptr .sd_running_process
        mov es,word ptr pd_uda_segment[si]
        cmp al,01fh
        jnz xios_supply_console
        cmp bl,06h
        jz xios_call_entry
        cmp bl,07h
        jz xios_call_entry
        cmp bl,09h
        jz xios_call_entry
        cmp bl,0ah
        jz xios_call_entry
        cmp bl,0bh
        jz xios_call_entry
        cmp bl,0ch
        jz xios_call_entry
        cmp bl,0dh
        jz xios_call_entry
xios_supply_console:
        mov dl,byte ptr pd_console_number[si]
xios_call_entry:
        callf cs:dword ptr .shared_xios_entry
        pop ds
        pop es
        pop si
        pop dx
        ret

; UNDECODED 1615h..1637h: XIOS console-output wrapper.
; Preserved original CODE bytes 1615h..1637h (undecoded/data).
        db 050h,052h,056h,006h,01eh,0b8h,004h,000h,08ah,016h,0f8h,004h,02eh,08eh,01eh,00fh
        db 01ah,08bh,036h,068h,000h,08eh,044h,010h,02eh,0ffh,01eh,00dh,01ah,01fh,007h,05eh
        db 05ah,058h,0c3h

;------------------------------------------------------------------------------
; INT 10h: save application DS/SI, select this console DATA, switch to private
; SS:SP, then save AX/BX/CX/DS/DX/BP/ES/DI at DATA:0439h down to 042Bh.
; Changing a result requires writing that saved frame before the shared exit.
; This is the original reconstruction. No new BIOS functionality is enabled.
;------------------------------------------------------------------------------
bios_video_handler:
        sti
        push ds
        push si
        call select_console_data
        cli
        mov word ptr .child_stack_segment,ss
        mov word ptr .child_stack_offset,sp
        mov si,ds
        mov ss,si
        mov sp,bios_frame_ax+2
        sti
        push ax
        push bx
        push cx
        push ds
        push dx
        push bp
        push es
        push di
        db 00ah,0e4h  ; or ah,ah: original encoding
        jnz bios_video_try_cursor_shape
        cmp al,07h
        jz bios_mode_text_number
        cmp al,04h
        jnc bios_mode_graphics_number

;------------------------------------------------------------------------------
; Native text modes are BIOS mode +2; native graphics modes use a high nibble.
;------------------------------------------------------------------------------
bios_mode_text_number:
        inc al
        inc al
        db 08ah,0c8h  ; mov cl,al: original encoding
        jmps bios_mode_set
bios_mode_graphics_number:
        dec al
        dec al
        shl al,1
        shl al,1
        shl al,1
        shl al,1
        db 08ah,0c8h  ; mov cl,al: original encoding
bios_mode_set:
        mov ax,01eh
        db 032h,0edh  ; xor ch,ch: original encoding
        call xios_gateway
        jmp bios_video_restore_frame
bios_video_try_cursor_shape:
        cmp ah,01h
        jnz bios_video_try_cursor_set
        mov al,01fh
        mov bl,01h
        call xios_gateway
        jmp bios_video_restore_frame
bios_video_try_cursor_set:
        cmp ah,02h
        jnz bios_video_try_cursor_get
        db 08bh,0cah  ; mov cx,dx: original encoding
        mov al,01fh
        mov bl,02h
        call xios_gateway
        jmp bios_video_restore_frame

;------------------------------------------------------------------------------
; Cursor query copies XIOS AX into the saved DOS DX, and returns CX=0.
; The recovered handler does not supply the cursor shape in CX.
;------------------------------------------------------------------------------
bios_video_try_cursor_get:
        cmp ah,03h
        jnz bios_video_try_page
        mov al,01fh
        mov bl,03h
        call xios_gateway
        mov word ptr .bios_frame_dx,ax
        db 033h,0c9h  ; xor cx,cx: original encoding
        mov word ptr .bios_frame_cx,cx
        jmp bios_video_restore_frame

;------------------------------------------------------------------------------
; AH=04/05 have no implemented branch. Preserve the original caller registers.
;------------------------------------------------------------------------------
bios_video_try_page:
        cmp ah,05h
        jnc bios_video_try_scroll_up
        jmp bios_video_restore_frame
bios_video_try_scroll_up:
        cmp ah,06h
        jnz bios_video_try_scroll_down
        mov si,061fh
        mov bl,00h
        jmps bios_video_packet
bios_video_try_scroll_down:
        cmp ah,07h
        jnz bios_video_try_read_cell
        mov si,071fh
        mov bl,00h

;------------------------------------------------------------------------------
; Build the nine-byte XIOS packet in console-private DATA. AH is cleared:
; AX carries color/count, BX page/attribute/palette, CX/DX coordinates.
; SI holds packed BIOS operation:XIOS function. Gateway returns AX, but this
; shared path does not copy it into bios_frame_ax before restoring the caller.
; In particular the AH=0Dh pixel-read result is discarded in the recovered code.
;------------------------------------------------------------------------------
bios_video_packet:
        db 032h,0e4h  ; xor ah,ah: original encoding
        mov word ptr .bios_packet_ax,ax
        mov word ptr .bios_packet_bx,bx
        mov word ptr .bios_packet_cx,cx
        mov word ptr .bios_packet_dx,dx
        push ds
        mov ds,cs:word ptr .shared_sysdat_segment
        mov bx,word ptr .sd_running_process
        mov al,byte ptr pd_console_number[bx]
        pop ds
        mov byte ptr .bios_packet_console,al
        db 08bh,0c6h  ; mov ax,si: original encoding
        db 08ah,0dch  ; mov bl,ah: original encoding
        mov cx,ds
        mov dx,bios_packet_ax
if PCMODE_PIXEL_READ
        call bios_video_packet_result
endif
if not PCMODE_PIXEL_READ
        call xios_gateway
endif
        jmp bios_video_restore_frame

;------------------------------------------------------------------------------
; Character readback explicitly updates saved AX; unlike generic packet return.
;------------------------------------------------------------------------------
bios_video_try_read_cell:
        cmp ah,08h
        jnz bios_video_try_write_cell
        mov al,01fh
        mov bl,08h
        call xios_gateway
        mov word ptr .bios_frame_ax,ax
        jmp bios_video_restore_frame
bios_video_try_write_cell:
        cmp ah,09h
        jnz bios_video_try_write_character
        mov si,091fh
        mov bh,00h
        jmps bios_video_packet
bios_video_try_write_character:
        cmp ah,0ah
        jnz bios_video_try_palette
        mov si,0a1fh
        mov bh,00h
        jmps bios_video_packet
bios_video_try_palette:
        cmp ah,0bh
        jnz bios_video_try_pixel_write
        mov si,0b1fh
        jmps bios_video_packet
bios_video_try_pixel_write:
        cmp ah,0ch
        jnz bios_video_try_pixel_read
        mov si,0c1fh
        jmps bios_video_packet

;------------------------------------------------------------------------------
; Original AH=0Dh routes to XIOS 31/13, whose CGA helper returns a pixel color.
; The shared packet path restores original AX, so this branch cannot return
; that color through AL. Fixing/adding readback requires both sides reviewed.
;------------------------------------------------------------------------------
bios_video_try_pixel_read:
        cmp ah,0dh
        jnz bios_video_try_teletype
        mov si,0d1fh
        jmps bios_video_packet
bios_video_try_teletype:
        cmp ah,0eh
        jnz bios_video_try_mode_query
        db 08ah,0c8h  ; mov cl,al: original encoding
        mov al,01fh
        mov bl,0eh
        call xios_gateway
        jmp bios_video_restore_frame

;------------------------------------------------------------------------------
; Mode query uses native XIOS 30, translates its numbering and writes saved AX.
; Saved BH=0: the supported view exposes one BIOS video page.
;------------------------------------------------------------------------------
bios_video_try_mode_query:
        cmp ah,0fh
        jnz bios_video_restore_frame
        mov al,01eh
        mov ch,01h
        call xios_gateway
        db 032h,0ffh  ; xor bh,bh: original encoding
        cmp al,010h
        jc bios_mode_query_text_number
        shr al,1
        shr al,1
        shr al,1
        shr al,1
        add al,04h
bios_mode_query_text_number:
        dec al
        dec al
        mov word ptr .bios_frame_ax,ax
        mov byte ptr .bios_frame_bh,00h

;------------------------------------------------------------------------------
; Restore the complete private frame, then switch back to the application
; stack with interrupts disabled. The original INT frame is consumed by IRET.
;------------------------------------------------------------------------------
bios_video_restore_frame:
        pop di
        pop es
        pop bp
        pop dx
        pop ds
        pop cx
        pop bx
        pop ax
        cli
        mov ss,word ptr .child_stack_segment
        mov sp,word ptr .child_stack_offset
        pop si
        pop ds
        iret

;------------------------------------------------------------------------------
; INT 11h equipment: no AX slot is pushed, so returned XIOS AX survives.
; Other listed registers and DS/application stack are restored before IRET.
; This contrasts with the INT 10h packet result path above.
;------------------------------------------------------------------------------
bios_equipment_handler:
        sti
        push ds
        call select_console_data
        cli
        mov word ptr .child_stack_segment,ss
        mov word ptr .child_stack_offset,sp
        mov ax,ds
        mov ss,ax
        mov sp,bios_frame_ax+2
        sti
        push bx
        push cx
        push dx
        push di
        mov ax,022h
        call xios_gateway
        pop di
        pop dx
        pop cx
        pop bx
        cli
        mov ss,word ptr .child_stack_segment
        mov sp,word ptr .child_stack_offset
        pop ds
        iret

; UNDECODED 17CFh..1862h: memory and disk BIOS handlers.
; Preserved original CODE bytes 17CFh..1862h (undecoded/data).
        db 01eh,051h,0e8h,0d3h,0fdh,0a1h,0ceh,003h,003h,006h,0cch,003h,0b1h,006h,0d3h,0e8h
        db 059h,01fh,0cfh,0fbh,053h,051h,01eh,056h,057h,055h,052h,006h,0e8h,0b9h,0fdh,080h
        db 0fch,002h,075h,004h,0b4h,000h,0ebh,018h,080h,0fch,003h,075h,004h,0b4h,001h,0ebh
        db 00fh,080h,0fch,004h,075h,004h,0b4h,002h,0ebh,006h,0b8h,000h,000h,0f8h,0ebh,049h
        db 088h,026h,0b7h,005h,088h,016h,0b8h,005h,0a2h,0b9h,005h,088h,036h,0bah,005h,0feh
        db 0c9h,088h,00eh,0bbh,005h,088h,02eh,0bch,005h,089h,01eh,0bdh,005h,08ch,006h,0bfh
        db 005h,0bah,0b7h,005h,01eh,08eh,006h,000h,000h,026h,08bh,036h,068h,000h,026h,08bh
        db 044h,010h,08eh,0c0h,026h,08ch,01eh,02eh,000h,08eh,01eh,000h,000h,0b1h,02fh,0ffh
        db 01eh,020h,000h,01fh,00ah,0c0h,074h,001h,0f9h,007h,05ah,05dh,05fh,05eh,01fh,059h
        db 05bh,0cah,002h,000h

;------------------------------------------------------------------------------
; INT 16h (1863h..18E7h), byte-exact recovered legacy keyboard handler.
; Select the running console DATA, then use its private service stack. Return
; AX through the saved frame. RETF 2 discards the caller FLAGS: current ZF from
; the input word test is the AH=01h result. This is not an enhanced BIOS API:
; every selector other than 00h/01h falls through to XIOS 33 shift status.
; Native BDOS 6 returns an input word, not necessarily IBM AH=scan/AL=ASCII.
; The per-console one-word lookahead is consumed exactly once by AH=00h.
;------------------------------------------------------------------------------
bios_keyboard_handler:
        push ds
        push bx
        call select_console_data
        mov word ptr .child_stack_segment,ss
        mov word ptr .child_stack_offset,sp
        mov bx,ds
        mov ss,bx
        mov sp,043bh
        sti
        push ax
        push cx
        push dx
        push si
        push es
        push di
        db 00ah,0e4h                ; or ah,ah, recovered encoding
        jz bios_keyboard_read
        dec ah
        jz bios_keyboard_poll
        mov ax,33
        pushf
        call xios_gateway
        popf
        mov word ptr .bios_frame_ax,ax
        jmps bios_keyboard_return
bios_keyboard_poll:
        mov ax,word ptr .bios_keyboard_pending
        db 00bh,0c0h                ; or ax,ax, recovered encoding
        jnz bios_keyboard_result
        mov word ptr .bios_frame_ax,0
        mov cl,6
        mov dl,0ffh                 ; nonblocking BDOS 6 consumes queue word
        pushf
        call loader_bdos_call
        popf
        db 00bh,0c0h                ; zero means no queued input
        jz bios_keyboard_return
        mov word ptr .bios_keyboard_pending,ax
        jmps bios_keyboard_result
bios_keyboard_read:
        mov ax,word ptr .bios_keyboard_pending
        mov word ptr .bios_keyboard_pending,0
        db 00bh,0c0h
        jnz bios_keyboard_result
        pushf
        call bios_keyboard_wait
        popf
bios_keyboard_result:
        db 00bh,0c0h                ; supply AH=01h ZF without changing AX
        mov word ptr .bios_frame_ax,ax
bios_keyboard_return:
        pop di
        pop es
        pop si
        pop dx
        pop cx
        pop ax
        cli
        mov ss,word ptr .child_stack_segment
        mov sp,word ptr .child_stack_offset
        pop bx
        pop ds
        sti
        retf 2
bios_keyboard_wait:
        push cx
        mov cl,6
        mov dl,0fdh                 ; blocking raw BDOS console input
        call loader_bdos_call
        pop cx
        ret

