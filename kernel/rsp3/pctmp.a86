        add ax,word ptr .child_memory_size
        sub ax,word ptr .exe_image_paragraphs
        mov word ptr .exe_load_segment,ax
        sub ax,word ptr .exe_header+0ch
        jc prepare_exe_entry
        sub ax,10h
        jc prepare_exe_entry
        mov word ptr .exe_load_segment,ax

;------------------------------------------------------------------------------
; prepare_exe_entry (105Fh)
; Memory allocation and load placement have selected exe_load_segment.
; Rebase MZ CS/SS, retain header IP/SP, and build the child's PSP. The common
; launch path consumes these four child_* fields after image relocation.
;------------------------------------------------------------------------------
prepare_exe_entry:
if PCMODE_SAFE_LOADER
        call validate_exe_stack
        nop
        nop
        nop
        nop
endif
if not PCMODE_SAFE_LOADER
        mov ax,word ptr .exe_load_segment
        add ax,word ptr .exe_initial_ss
endif
        mov word ptr .child_stack_segment,ax
        mov ax,word ptr .exe_initial_sp
        mov word ptr .child_stack_offset,ax
        mov ax,word ptr .exe_initial_cs
        add ax,word ptr .exe_load_segment
        mov word ptr .child_entry_segment,ax
        mov ax,word ptr .exe_initial_ip
        mov word ptr .child_entry_offset,ax
        mov byte ptr .child_is_com,0
        call construct_psp
        db 033h,0d2h                 ; xor dx,dx: DMA begins at offset zero
        mov cl,26
        call loader_bdos_call
        mov ax,word ptr .exe_load_segment
        mov word ptr .exe_dma_segment,ax
        mov ax,word ptr .exe_image_paragraphs
        add ax,7         ; retain original accumulator encoding
        mov cl,3
        shr ax,cl                    ; round paragraphs to 128-byte records
        mov word ptr .exe_records_left,ax

; The original calculation discards a partial 512-byte header page. The
; experimental path selects bulk record reads or a header-tail copy reader.
if PCMODE_SAFE_LOADER
        jmp load_exe_header_tail  ; choose record-aligned or byte-shifting path
endif
if not PCMODE_SAFE_LOADER
        mov ax,word ptr .exe_header_paragraphs
endif
if PCMODE_SAFE_LOADER
        mov cl,3
        shr ax,cl                    ; header paragraphs / 8 = CP/M records
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
endif
if not PCMODE_SAFE_LOADER
        mov dx,16
        mul dx
        mov cx,512
        div cx
        mov cx,4
        mul cx                       ; file's first image record (128-byte units)
endif
        mov word ptr .exe_next_record,ax
        mov byte ptr .exe_next_record+2,0
        mov dx,128
        call set_multi_record_count
read_exe_image_chunk:
        mov cl,51                    ; DMA segment; offset remains zero
        mov dx,word ptr .exe_dma_segment
        call loader_bdos_call
        mov ax,400h                  ; 16 KiB in paragraphs
        mov di,128                   ; 16 KiB in CP/M records
        cmp word ptr .exe_records_left,di
        jae read_exe_image_records
        mov di,word ptr .exe_records_left
        db 08bh,0d7h                 ; mov dx,di: final shorter multi-read
        call set_multi_record_count
        db 08bh,0c7h                 ; mov ax,di
        shl ax,1
        shl ax,1
        shl ax,1                     ; records to paragraphs
read_exe_image_records:
        mov dx,program_fcb
        db 08bh,0f2h                 ; mov si,dx
        add word ptr .exe_dma_segment,ax
        mov ax,word ptr .exe_next_record
        mov word ptr fcb_random_record[si],ax
        mov al,byte ptr .exe_next_record+2
        mov byte ptr fcb_random_record+2[si],al
        add word ptr .exe_next_record,di
        adc byte ptr .exe_next_record+2,0
        mov cl,33                    ; random read with current multi-count
        call loader_bdos_call
        db 00ah,0c0h                 ; or al,al
        jz exe_image_chunk_done
        cmp al,1                     ; EOF is accepted by the original loader
        jz exe_image_chunk_done
        mov cx,1dh
        jmp loader_failure
exe_image_chunk_done:
        sub word ptr .exe_records_left,di
        jnz read_exe_image_chunk


;------------------------------------------------------------------------------
; relocate_exe (111Eh)
; Image loading is complete. DS selects PCTMP DATA; exe_load_segment is the
; actual load base in paragraphs. exe_header still holds file record zero.
; Each MZ relocation is an offset:segment pair relative to the image base.
; Resolve that pair and add the load base to the target WORD, not its address.
; The default is byte-exact recovery; the experimental helper validates both
; target bytes before rebasing. See pcguard.lib for its error-stack contract.
; The original reader assumes the initial table offset is in record zero and
; entries fit the record layout. The checked pass handles arbitrary byte starts
; and split entries while preserving these original offsets for reconstruction.
;------------------------------------------------------------------------------
relocate_exe:
if PCMODE_SAFE_LOADER
        jmp relocate_exe_checked
        nop
        nop
        nop
endif
if not PCMODE_SAFE_LOADER
        mov dx,1
        call set_multi_record_count
endif
        mov word ptr .exe_next_record,1
        mov byte ptr .exe_next_record+2,0
        mov ax,word ptr .exe_relocation_offset
        mov word ptr .exe_relocation_cursor,ax
        mov cx,word ptr .exe_relocation_count
        jcxz exe_relocations_done
exe_relocation_loop:
        push cx
        call read_exe_relocation
        pop cx
if PCMODE_SAFE_LOADER
        call validate_exe_relocation
        nop
        nop
        nop
endif
if not PCMODE_SAFE_LOADER
        mov ax,es                    ; entry's relative segment
        add ax,word ptr .exe_load_segment
endif
        mov es,ax                    ; ES:SI now addresses the loaded target
        mov ax,word ptr .exe_load_segment
        add es:word ptr [si],ax
        loop exe_relocation_loop
exe_relocations_done:
        jmp prepare_dos_execution

;------------------------------------------------------------------------------
; read_exe_relocation (1153h)
; Return ES:SI = relative segment:offset from the next relocation entry.
; Advance the cursor by four bytes; at the record boundary refill the header
; scratch buffer through CP/M random read. Preserve the just-fetched pair
; across refill. The enclosing loop saves CX because BDOS uses CL.
; Refill happens immediately, even when the fetched entry was the last one.
; A failed refill jumps to the common loader error path; it does not return.
;------------------------------------------------------------------------------
read_exe_relocation:
        mov bx,word ptr .exe_relocation_cursor
        les si,dword ptr exe_header[bx]
        add bx,4
        cmp bx,128
        jae refill_exe_relocations
        mov word ptr .exe_relocation_cursor,bx
        ret
refill_exe_relocations:
        push es
        push si
        mov word ptr .exe_relocation_cursor,0
        push ds
        pop es
        mov dx,exe_header
        call set_loader_dma
        mov dx,program_fcb
        db 08bh,0f2h                 ; mov si,dx: original encoding
        mov ax,word ptr .exe_next_record
        mov word ptr fcb_random_record[si],ax
        mov al,byte ptr .exe_next_record+2
        mov byte ptr fcb_random_record+2[si],al
        add word ptr .exe_next_record,1
        adc byte ptr .exe_next_record+2,0
        mov cl,33                    ; CP/M random record read
        call loader_bdos_call
        pop si
        pop es
        db 00ah,0c0h                 ; or al,al: original encoding
        jz exe_relocation_ready
        jmp loader_read_error
exe_relocation_ready:
        ret

