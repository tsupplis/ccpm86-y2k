; Native ASM86 PCTMP; pcdefs.lib selects the supported extensions.
include pcdefs.lib
PCMODE_SAFE_LOADER equ PCMODE_BUILD
PCMODE_CHECKED_INPUT equ PCMODE_BUILD
PCMODE_PIXEL_READ equ PCMODE_BUILD
PCMODE_SHELL equ PCMODE_BUILD
PCMODE_HELP equ PCMODE_BUILD
PCMODE_SEARCH equ PCMODE_BUILD
cseg
org 0
code_origin:
;******************************************************************************
; PCTMP - PC-MODE terminal message processor, Concurrent CP/M-86 3.1
;
; Provenance: inputs/pctmp.bin, recovered from a.sys.
; This is a PARTIAL reconstruction of the shared CODE group. All undecoded
; ranges are explicitly retained as DB data; they are not decoded instructions.
; pcdata.lib declares the original normalized DATA bytes; the reference remains
; in inputs/pctmp.rsp. GENCMD generates both group headers and record padding.
;
; Build through the native ASM86 -> H86 -> GENCMD rules in this directory.
; PCMODE_BUILD=0 in pcdefs.lib reconstructs the original RSP byte for byte.
; Normal builds use the standard local RSP rules. Sandbox tools copy sources
; to their chosen build directory before invoking Make.
;
; Original mode is byte-exact. PCMODE_SAFE_LOADER adds the documented header
; guard; PCMODE_CHECKED_INPUT fixes DOS function 01h Ctrl-C dispatch.
; PCMODE_PIXEL_READ returns a successful XIOS pixel color through saved AL.
; PCMODE_SHELL adds native TMP CLS/SYSDISK and drive-command parity.
; PCMODE_HELP adds native TMP quick-help/topic expansion before FCB parsing.
; Original input files remain untouched.
; Original instruction encodings are kept,
; including explicit alternate encodings in decoded historical routines.
;
; Residency model:
;   GENCCPM allocates one 0AF0h-byte DATA group per virtual console, followed
;   by one shared CODE group. INIT writes the SYSDAT segment into the RSP link
;   word at DATA:0000. DATA:0004 identifies the console instance.
;   Interrupt handlers use the running PD's console to locate that DATA group.
;   Consequently, resizing DATA requires changing the selection code as well.
;******************************************************************************

; Per-instance DATA fields used by decoded routines.
rsp_sysdat_segment       equ 0000h  ; startup link replaced by kernel INIT
rsp_console_instance     equ 0004h  ; zero-based instance set by GENCCPM
service_entry_segment    equ 017ah  ; segment half of private service far pointer
console_data_bytes       equ 0af0h

; EXE loader state, in this instance's DATA group. The first 128-byte
; header record is read into exe_header and subsequently reused for fixups.
program_fcb             equ 0220h
fcb_random_record       equ 0021h  ; 24-bit CP/M random record number
loader_memory_base      equ 03cch  ; BDOS 55 allocation descriptor, segment
loader_memory_size      equ 03ceh  ; allocated paragraphs returned by BDOS 55
child_psp_segment       equ 03d3h  ; allocation base + 1Bh private paragraphs
child_memory_size       equ 03d5h  ; allocation size minus those private paragraphs
exe_header              equ 0455h
exe_relocation_count    equ exe_header+6
exe_header_paragraphs   equ exe_header+8
exe_initial_ss          equ exe_header+0eh
exe_initial_sp          equ exe_header+10h
exe_initial_ip          equ exe_header+14h
exe_initial_cs          equ exe_header+16h
dos_saved_ax            equ 043bh  ; return AX in private INT 21h frame
child_stack_offset      equ 0448h
child_stack_segment     equ 044ah
child_entry_segment     equ 044ch
child_entry_offset      equ 044eh
child_is_com            equ 02f8h
exe_records_left        equ 04d8h
exe_dma_segment         equ 04dah
exe_image_paragraphs    equ 04dch
construct_psp equ code_origin+137fh

exe_relocation_offset   equ exe_header+18h
exe_load_segment        equ 04deh
exe_next_record         equ 04e0h  ; low word followed by high byte
exe_relocation_cursor   equ 04ebh  ; byte offset into current header record

loader_read_error equ code_origin+0f87h  ; CX=1Dh then common load failure
loader_failure equ code_origin+136eh  ; AX=BX=FFFFh; restore user and return
prepare_dos_execution equ code_origin+126fh  ; common COM/EXE continuation
set_multi_record_count equ code_origin+154ah  ; DX=count, BDOS 44
set_loader_dma equ code_origin+28dah  ; ES:DX=buffer, BDOS 26 and 51
loader_bdos_call equ code_origin+3653h  ; internal BDOS gateway
exe_aligned_record_index equ code_origin+10a4h  ; aligned image-start calculation
exe_size_arithmetic equ code_origin+0f91h  ; resume after guarded header access
raw_console_input equ code_origin+1dceh
classify_echo_byte equ code_origin+1e14h
control_echo_return equ code_origin+1e26h
console_echo_byte equ code_origin+1eb4h
unwind_dos_break equ code_origin+207dh  ; restore user frame then INT 23h



command_buffer           equ 0181h
command_length           equ 0182h
command_text             equ 0183h
command_buffer_end       equ 0207h
bios_keyboard_pending    equ 02f0h
command_sent             equ 0208h
native_cli_success equ code_origin+07d5h

; Stable SYSDAT/PD fields. DS must select SYSDAT before using sd_* fields.
sd_supervisor_segment    equ 0040h
sd_system_disk           equ 004bh
sd_running_process       equ 0068h
sd_banner_offset         equ 0078h
pd_console_number        equ 0020h

; Shared CODE variables initialized by PC-MODE startup.
shared_first_data_segment equ 01a03h
shared_sysdat_segment     equ 01a0fh


; Saved INT 10h register-frame slots and packet ABI, selected per console.
shared_xios_entry             equ 01a0dh
pd_uda_segment                equ 010h
bios_frame_ax                 equ 0439h
bios_frame_bx                 equ 0437h
bios_frame_bh                 equ 0438h
bios_frame_cx                 equ 0435h
bios_frame_dx                 equ 0431h
bios_packet_ax                equ 05aeh
bios_packet_bx                equ 05b0h
bios_packet_cx                equ 05b2h
bios_packet_dx                equ 05b4h
bios_packet_console           equ 05b6h

; Named entry points inside regions still awaiting full reconstruction.
console_set equ code_origin+08e3h  ; DL=console, BDOS 148
current_disk_set equ code_origin+08e7h  ; DL=drive, BDOS 14
current_user_set equ code_origin+08d2h  ; DL=user, BDOS 32
console_attach equ code_origin+08f7h  ; BDOS 146
print_data_string equ code_origin+0754h  ; DS:DX points to '$'-terminated text
initialize_pc_mode equ code_origin+0c5bh  ; shared state and per-console initialization

; Two public entry jumps precede the vendor/version identification bytes.
        jmp process_start
        jmp pcmode_service
; Preserved original CODE bytes 0006h..0043h (undecoded/data).
        db 043h,04fh,050h,059h,052h,049h,047h,048h,054h,028h,043h,029h,031h,039h,038h,033h
        db 02ch,038h,034h,02ch,044h,049h,047h,049h,054h,041h,04ch,020h,052h,045h,053h,045h
        db 041h,052h,043h,048h,028h,030h,035h,02fh,031h,037h,02fh,038h,034h,029h,032h,030h
        db 030h,034h,02dh,030h,030h,030h,030h,02dh,036h,035h,034h,033h,032h,031h

;------------------------------------------------------------------------------
; process_start (0044h)
; Entry: CS=shared CODE, DS=this console's DATA, stack supplied by GENCCPM.
; Select this instance's console, the configured system disk and user zero.
; Attach the console before printing the supervisor's generated OS label.
; DS is restored after each access to another segment.
;------------------------------------------------------------------------------
process_start:
        mov word ptr .service_entry_segment,cs
        mov dl,byte ptr .rsp_console_instance
        call console_set
        push ds
        mov ds,word ptr .rsp_sysdat_segment
        mov dl,byte ptr .sd_system_disk
        pop ds
        call current_disk_set
        db 032h,0d2h              ; xor dl,dl: original register/register encoding
        call current_user_set
        call console_attach
        push ds
        mov ds,word ptr .rsp_sysdat_segment
        mov dx,word ptr .sd_banner_offset
        mov ds,word ptr .sd_supervisor_segment
        call print_data_string
        pop ds
        call initialize_pc_mode

; UNDECODED 0078h..0690h: startup file processing, prompt/command parser,
; built-in commands and external command pre-search.
; These bytes must stay at their original offsets until their internal
; absolute references and data/code boundaries have been fully identified.
; Preserved original CODE bytes 0078h..0170h (undecoded/data).
        db 0e8h,080h,008h,01eh,007h,0beh,01dh,000h,0bfh,029h,002h,0b9h,003h,000h,0f3h,0a4h
        db 0bah,020h,002h,0b1h,00fh,0e8h,071h,008h,03ch,0ffh,074h,04ch,0bah,083h,001h,0b1h
        db 01ah,0e8h,065h,008h,0bah,020h,002h,0b1h,014h,0e8h,05dh,008h,050h,0bah,020h,002h
        db 0b1h,010h,0e8h,054h,008h,058h,084h,0c0h,075h,02eh,08ch,0d8h,08eh,0c0h,0b0h,00dh
        db 0b9h,080h,000h,0bfh,083h,001h,0f2h,0aeh,075h,01eh,047h,0c6h,005h,024h,081h,0efh
        db 083h,001h,08bh,0c7h,02dh,002h,000h,0a2h,082h,001h,0bah,00ch,00ch,0e8h,026h,006h
        db 0bah,083h,001h,0e8h,076h,006h,0ebh,056h,0bah,0ffh,0ffh,0e8h,019h,008h,0e8h,00eh
        db 008h,0b1h,000h,0ffh,01eh,078h,001h,080h,03eh,0eeh,002h,0ffh,075h,005h,0c6h,006h
        db 0eeh,002h,000h,080h,03eh,008h,002h,000h,074h,008h,0c6h,006h,008h,002h,000h,0e8h
        db 0cdh,007h,0b2h,00dh,0e8h,0f9h,005h,0e8h,0beh,007h,088h,01eh,023h,000h,084h,0dbh
        db 074h,005h,08ah,0d3h,0e8h,09ch,007h,0e8h,0c9h,007h,088h,01eh,022h,000h,0b2h,041h
        db 002h,0d3h,0e8h,0dbh,005h,0bah,060h,009h,0e8h,0cbh,005h,0e8h,05bh,005h,0b2h,00ah
        db 0e8h,0cdh,005h,08dh,01eh,083h,001h,080h,03eh,082h,001h,000h,074h,05fh,08bh,0fbh
        db 04fh,0e8h,0d6h,006h,08bh,0dfh,080h,03fh,000h,074h,052h,08dh,006h,083h,001h,03bh
        db 0c3h,074h,011h,01eh,007h,032h,0edh,08ah,00eh,082h,001h,08bh,0f8h,08bh,0f3h,0fch
        db 0f3h,0a4h,08bh,0d8h,080h,03fh,03bh,074h,034h
; Intercept compact/spaced drive commands before the recovered direct select.
if PCMODE_SHELL
        jmp shell_drive_command
        db 090h,090h,090h,090h
endif
if not PCMODE_SHELL
        db 080h,03eh,085h,001h,000h,075h,030h
endif
; Preserved original CODE bytes 0178h..01A7h (undecoded/data).
        db 080h,07fh,001h,03ah,075h,02ah,08ah,017h,080h,0e2h,05fh,080h,0eah,041h,080h,0fah
        db 000h,072h,00bh,080h,0fah,00fh,077h,006h,0e8h,054h,007h,0e9h,00fh,000h,0bah,065h
        db 009h,0e8h,062h,005h,0bah,0ddh,009h,0e8h,05ch,005h,0e8h,032h,007h,0e9h,038h,0ffh
; Help must intercept '?' before BDOS 152 interprets it as a wildcard.
if PCMODE_HELP
        jmp shell_help_command
endif
if not PCMODE_HELP
        mov bx,command_text
endif
; Preserved original CODE bytes 01ABh..0207h (undecoded/data).
        db 0a0h,082h,001h,0b4h,000h,003h,0d8h,0c6h,007h,000h,0b9h,040h,000h,0beh,083h,001h
        db 0bfh,045h,002h,01eh,007h,0f3h,0a5h,0beh,020h,002h,0bfh,045h,002h,0e8h,07eh,006h
        db 0e3h,010h,02bh,0dbh,08ah,01eh,082h,001h,081h,0c3h,045h,002h,0c6h,007h,024h,0e9h
        db 000h,006h,089h,01eh,009h,002h,083h,0fbh,000h,075h,008h,08ah,01eh,082h,001h,081h
        db 0c3h,045h,002h,0c6h,007h,024h,043h,080h,03eh,020h,002h,000h,074h,00fh,0e9h,0c5h
        db 002h,0beh,020h,002h,046h,00eh,007h,0b9h,009h,000h,0f3h,0a6h,0c3h
; The original unqualified-built-in dispatch starts with MOV DI,0BA0h.
; Qualified commands already bypass this point. Retain every original offset.
if PCMODE_SHELL
        jmp shell_extensions
endif
if not PCMODE_SHELL
        mov di,0ba0h
endif
; Preserved original CODE bytes 020Bh..04C0h (undecoded/data).
        db 0e8h,0eeh,0ffh,075h,04dh,0beh,020h,002h,08bh,03eh,009h,002h,083h,0ffh,000h,074h
        db 027h,047h,0e8h,029h,006h,083h,0f9h,000h,075h,01eh,0beh,020h,002h,046h,08bh,014h
        db 0b5h,030h,0e8h,029h,006h,080h,0fbh,00fh,077h,008h,08ah,0d3h,0e8h,098h,006h,0e9h
        db 006h,000h,0bah,02dh,00ah,0e8h,0bbh,004h,0bah,04eh,00ah,0e8h,0b5h,004h,0e8h,084h
        db 006h,08ah,0d3h,0e8h,06ah,006h,0e8h,083h,006h,0bah,05fh,00ah,0e8h,0a4h,004h,0e9h
