; SYSDISK resident command for Concurrent CP/M-86 3.1.
; Uses the standard CLI command queue and the caller's console.
;
;	DEFINITIONS
;

ccpmint		equ	224	;ccpm entry interrupt
c_writebuf	equ	9	;print string
c_detach	equ	147	;detach console
c_setnum	equ	148	;set default console
q_make		equ	134	;create queue
q_open		equ	135	;open queue
q_read		equ	137	;read queue
q_write		equ	139	;write queue
p_priority	equ	145	;set priority

pdlen		equ	48	;length of Process
				;  Descriptor

p_cns		equ	byte ptr 020h	;default cns
p_disk		equ	byte ptr 012h	;default disk
p_user		equ	byte ptr 013h	;default user
p_list		equ	byte ptr 024h	;default list
ps_run		equ	0	;PD run status
pf_keep		equ	2	;PD nokill flag

rsp_top		equ	0	;rsp offset
rsp_pd		equ	010h	;PD offset
rsp_uda		equ	040h	;UDA offset
rsp_bottom	equ	140h	;end rsp header

qf_rsp		equ	08h	;queue RSP flag

;
;	CODE SEGMENT
;
	CSEG
	org 0

ccpm:	int ccpmint
	ret

main:
    mov cl,q_make ! mov dx,offset qd ! call ccpm
    mov cl,q_open ! mov dx,offset qpb ! call ccpm
    mov cl,p_priority ! mov dx,200 ! call ccpm
next_command:
    mov cl,q_read ! mov dx,offset qpb ! call ccpm
    mov es,sdatseg
    mov bx,pdadr
    mov dl,es:p_cns[bx]
    mov console,dl
    mov cl,c_setnum ! call ccpm
    ; Queue text is zero terminated (unlike the CMD base-page tail).
    cld
    mov si,offset cmdtail
skip_space:
    lodsb
    cmp al,' ' ! je skip_space
    or al,al ! je display_disk
    cmp al,13 ! je display_disk
    and al,0dfh
    sub al,'A'
    cmp al,15 ! ja bad_syntax
    mov new_disk,al
    lodsb ! cmp al,':' ! jne bad_syntax
trailing_space:
    lodsb
    cmp al,' ' ! je trailing_space
    or al,al ! je valid_drive
    cmp al,13 ! jne bad_syntax
valid_drive:
    mov es,sdatseg
    mov bx,0088h ! mov ax,es:[bx]
    or ax,ax ! jne busy_files
    mov cl,45 ! mov dl,0ffh ! call ccpm
    mov cl,14 ! mov dl,new_disk ! call ccpm
    or al,al ! jne no_device
    mov es,sdatseg
    mov al,new_disk ! mov bx,004bh ! mov es:[bx],al
display_disk:
    mov es,sdatseg
    mov bx,004bh ! mov al,es:[bx]
    add al,'A' ! mov display_drive,al
    mov dx,offset disk_message ! jmp print_result
bad_syntax:
    mov dx,offset invalid_drive ! jmp print_result
busy_files:
    mov dx,offset files_open ! jmp print_result
no_device:
    mov dx,offset nonexistent_drive ! jmp print_result
print_result:
    mov cl,c_writebuf ! call ccpm
release_console:
    mov cl,c_detach ! mov dl,console ! call ccpm
    jmp next_command

;
;	DATA SEGMENT
;

	DSEG
	org	rsp_top

sdatseg		dw	0,0,0
		dw	0,0,0
		dw	0,0

	org	rsp_pd

pd		dw	0,0		; link,thread
		db	ps_run		; status
		db	190		; priority
		dw	pf_keep		; flags
		db	'SYSDISK '	; name
		dw	offset uda/10h	; uda seg
		db	0,0		; disk,user
		db	0,0		; load dsk,usr
		dw	0		; mem
		dw	0,0		; dvract,wait
		db	0,0
		dw	0
		db	0		; console
		db	0,0,0
		db	0		; list
		db	0,0,0
		dw	0,0,0,0

	org	rsp_uda

uda		dw	0,offset dma,0,0	;0
		dw	0,0,0,0
		dw	0,0,0,0			;10h
		dw	0,0,0,0
		dw	0,0,0,0			;20h
		dw	0,0,0,0
		dw	0,0,offset stack_tos,0	;30h
		dw	0,0,0,0
		dw	0,0,0,0			;40h
		dw	0,0,0,0
		dw	0,0,0,0			;50h
		dw	0,0,0,0
		dw	0,0,0,0			;60h

	org	rsp_bottom

qbuf		rb	131		;Queue buffer

qd		dw	0		;link
		db	0,0		;net,org
		dw	qf_rsp		;flags
		db	'SYSDISK '	;name
		dw	131		;msglen
		dw	1		;nmsgs
		dw	0,0		;dq,nq
		dw	0,0		;msgcnt,msgout
		dw	offset qbuf	;buffer addr.

dma		rb	128	

stack		dw	0cccch,0cccch,0cccch
		dw	0cccch,0cccch,0cccch
		dw	0cccch,0cccch,0cccch
		dw	0cccch,0cccch,0cccch
		dw	0cccch,0cccch,0cccch
stack_tos	dw	offset main	; start offset
		dw	0		; start seg
		dw	0		; init flags

pdadr		rw	1		; QPB Buffer
cmdtail		rb	129		; starts here
		db	13,10,'$'

qpb		db	0,0		;must be zero
		dw	0		;queue ID
		dw	1		;nmsgs
		dw	offset pdadr	;buffer addr.
		db	'SYSDISK '	;name to open

console		db	0
;disk		db	0
;user		db	0
;list		db	0

new_disk db 0
invalid_drive db 'Invalid drive code, use SYSDISK A:',13,10,'$'
files_open db 'Unable to set new system disk because of open files',13,10,'$'
nonexistent_drive db 'Specified device does not exist',13,10,'$'
disk_message db 'System disk is '
display_drive db 'A:',13,10,'$'

	end
