
CODE	CSEG
CGROUP	GROUP	CODE

	PUBLIC  RAWIO
	PUBLIC	MOVEDATA
;
;	EQUATES
;
bdos		equ	0E0H		; bdos interrupt
s_sysdat	equ	9AH		; to get system data seg
p_pdadr		equ	9CH		; to get proc desc addr
uda		equ	10H		; offset into proc desc
;
;
;	int RAWIO()
;			C_RAWIO, 2nd arg = 0FDH
RAWIO:
						; c entry protocol
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	ds				; save ds
	push	es				; save es

	mov	cl,6
	mov	dl,0fdh
	int	bdos

	pop	es				; restore es
	pop	ds				; restore ds
						; c exit protocol
	lea	si,-4[bp]
	pop	di
	pop	si
	pop	bp
	ret


; MOVEDATA(sseg, soff, dseg, doff, nbytes);
;
MOVEDATA:
						;  [bp] = return addr
						; 2[bp] = old bp
						; 4[bp] = sseg
						; 6[bp] = soff
						; 8[bp] = dseg
						; 10[bp] = doff
						; 12[bp] = nbytes
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	es
	push	ds
;
	mov	es,8[bp]
	mov	ds,4[bp]
	mov	si,6[bp]
	mov	di,10[bp]
	mov	cx,12[bp]

	rep	movsb
	
;
	pop	ds
	pop	es				; c exit protocol
	lea	sp,-4[bp]
	pop	di
	pop	si
	pop	bp
	ret

        END


