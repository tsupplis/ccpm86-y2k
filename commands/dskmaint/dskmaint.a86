;*****************************************************************************
;
;	DSKMAINT - Concurrent CP/M-86 3.1 disk maintenance, version 1.5
;	Digital Research, 26 January 1984. Byte-exact reconstruction.
;
;	CODE/DATA, loader-allocated EXTRA and a 256-byte STACK are separate.
;	XIOS disk I/O is protected by MXdisk, P_KEEP and console state checks.
;	Build and check: make check
;
;*****************************************************************************
	cseg
	org	0
entry:
	jmps	main
	db	'Copyright (C) 1983, Digital Research, Inc.Serial No. 2004-0000-654321'

;-----------------------------------------------------------------------------
; Use loader DATA, EXTRA and STACK groups; acquire process/console/disk locks.
;-----------------------------------------------------------------------------
main:
	cli
	mov	ss,word ptr .015h
	mov	sp,0100h
	sti
	mov	ax,ds
	mov	es,ax
	mov	word ptr output_segment,ax
	call	check_version
	call	get_os_data
	call	set_priority
	call	keep_process
	call	lock_console
	jz	console_error
	call	lock_disk
	jz	open_file_error
	call	check_console
	call	draw_frame
main_menu:
	mov	si,offset main_menu_record
	call	show_menu
	shl	bx,1
	call	word ptr menu_handlers[bx]
	call	clear_window
	jmps	main_menu

;-----------------------------------------------------------------------------
; Restore display, release disk/console locks, clear P_KEEP and terminate.
;-----------------------------------------------------------------------------
exit_program:
