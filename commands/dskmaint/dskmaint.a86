keep_process:
	mov	bx,word ptr process_offset
	push	ds
	mov	ds,word ptr system_segment
	or	word ptr 06h[bx],02h
	pop	ds
	ret
release_process:
	mov	bx,word ptr process_offset
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr 06h[bx],0fffdh
	pop	ds
	ret

;-----------------------------------------------------------------------------
; Require a foreground, unbuffered console; atomically set NOSWITCH.
;-----------------------------------------------------------------------------
lock_console:
	mov	bx,word ptr console_offset
	push	ds
	mov	ds,word ptr system_segment
	cli
	cmp	word ptr 0eh[bx],00h
	jz	branch_07cc
	xor	ax,ax
	jmps	branch_07d1
branch_07cc:
	or	word ptr 0eh[bx],08h
branch_07d1:
	sti
	pop	ds
	ret
unlock_console:
	mov	bx,word ptr console_offset
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr 0eh[bx],0fff7h
	pop	ds
	ret

;-----------------------------------------------------------------------------
; Reject open files; open MXdisk and read its token to exclude filesystem I/O.
;-----------------------------------------------------------------------------
lock_disk:
	push	ds
	mov	ds,word ptr system_segment
	mov	ax,word ptr .088h
	or	ax,ax
	pop	ds
	jnz	branch_0806
	mov	cl,087h
	mov	dx,offset disk_queue
	call	bdos
	mov	cl,089h
	mov	dx,offset disk_queue
	call	bdos
	xor	al,al
	inc	al
	ret
branch_0806:
	xor	ax,ax
	ret

;-----------------------------------------------------------------------------
; Return the MXdisk token before releasing console and process restrictions.
;-----------------------------------------------------------------------------
unlock_disk:
	mov	cl,08bh
	mov	dx,offset disk_queue
	call	bdos
	ret

;-----------------------------------------------------------------------------
; Fetch SYSDAT, process descriptor, UDA and this console control block.
;-----------------------------------------------------------------------------
get_os_data:
	push	es
	mov	cl,09ah
	call	bdos
	mov	word ptr system_segment,es
	mov	cl,09ch
	call	bdos
	mov	word ptr process_offset,bx
	mov	ax,es:010h[bx]
	mov	word ptr uda_segment,ax
	mov	cl,099h
	call	bdos
	xor	ah,ah
	mov	byte ptr console_number,al
	mov	bx,02ch
	mul	bx
	add	ax,es:word ptr .054h
	mov	word ptr console_offset,ax
	pop	es
	ret
position_cursor:
	mov	si,offset record_0e85
	add	ax,01f1fh
	mov	[si],ax
	mov	si,offset record_0e81
	jmp	write_buffer
hide_cursor:
	mov	si,offset record_0eaa
	jmp	write_buffer
show_cursor:
	mov	si,offset record_0eae
	jmp	write_buffer
set_video:
	mov	si,offset record_0e9f
	xor	ah,ah
	add	si,ax
	mov	al,[si]
	mov	byte ptr data_0ea9,al
	mov	si,offset record_0ea6
	jmp	write_buffer
restore_screen:
	mov	si,offset record_0e91
	jmp	write_buffer
check_console:
	mov	cl,099h
	call	bdos
	cmp	ax,04h
	jc	branch_088e
	mov	si,offset msg_terminal
	call	write_buffer
	xor	cx,cx
	xor	dx,dx
	jmp	branch_0087
branch_088e:
	mov	cl,06dh
	mov	dx,08eh
	call	bdos
	mov	si,offset record_0e87
	call	write_buffer
	call	enumerate_drives
	ret

