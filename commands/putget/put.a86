title 'PUT - Concurrent CP/M-86 Console Output Redirection'
;
; Syntax: PUT [outfile{,flags}] command_line
; Flags:
;   A  = Append to existing file instead of overwriting
;   E  = Echo output to screen while writing to file
;   EO = Echo output to screen only
;

    include putget.def

cseg
org 0

start:
    cli
    mov     ax, ds
    mov     ss, ax
    mov     sp, offset stack_top
    sti
    mov     cs:my_dseg, ds

    call    init_environment
    jnc     env_ok
    mov     dx, offset msg_require_ccpm
    jmp     fatal_error

env_ok:
    call    parse_put_cmdline
    jnc     setup_stream
    mov     dx, offset msg_syntax
    jmp     fatal_error

setup_stream:
    call    setup_output_file
    jnc     run_child
    mov     dx, offset msg_create_err
    jmp     fatal_error

run_child:
    call    execute_child_and_wait
    jnc     run_done
    mov     dx, offset msg_cli_err
    call    print_error_str

run_done:
if debug
    call    dbg_dump
endif
    call    flush_and_close_output
    mov     cl, f_exit
    int     bdos

fatal_error:
    call    print_error_str
    mov     cl, f_exit
    int     bdos

print_error_str:
    mov     cl, f_prtstr
    int     bdos
    ret

; =============================================================================
; PUT Parser
; =============================================================================
parse_put_cmdline:
    call    extract_bracket_and_cmd     ; SI -> bracket_buf
    jc      p_err

    ; Skip leading spaces
p_skip_sp:
    lodsb
    cmp     al, ' '
    je      p_skip_sp
    cmp     al, 9
    je      p_skip_sp
    or      al, al
    jz      p_err
    dec     si

    ; Parse outfile into target_fcb via BDOS 152
    mov     di, offset target_fcb
    call    parse_filename
    jc      p_err

p_flags_loop:
    lodsb
    or      al, al
    jz      p_ok
    cmp     al, ','
    je      p_flags_loop
    cmp     al, ' '
    je      p_flags_loop
    cmp     al, 9
    je      p_flags_loop

    cmp     al, 'a'
    je      set_flg_a
    cmp     al, 'A'
    je      set_flg_a

    cmp     al, 'e'
    je      chk_flg_e
    cmp     al, 'E'
    je      chk_flg_e
    jmp     p_flags_loop

set_flg_a:
    mov     cs:flag_append, 1
    jmp     p_flags_loop

chk_flg_e:
    mov     cs:flag_echo_out, 1
    cmp     byte ptr [si], 'o'
    je      skip_flg_o
    cmp     byte ptr [si], 'O'
    je      skip_flg_o
    jmp     p_flags_loop
skip_flg_o:
    inc     si
    jmp     p_flags_loop

p_ok:
    clc
    ret
p_err:
    stc
    ret

; =============================================================================
; Shared Engine (CSEG & DSEG)
; =============================================================================
    include putget.lib

; =============================================================================
; Tool-Specific Messages
; =============================================================================
dseg
org 100h

msg_require_ccpm    db 'PUT requires Concurrent CP/M-86 3.1',13,10,'$'
msg_syntax          db 13,10,'CCP/M-86 PUT VER 1.0',13,10,13,10
                    db 'USAGE: PUT [outfile{,A}{,E|EO}] command',13,10
                    db '  outfile  file receiving the console output of command',13,10
                    db '  A        append to outfile instead of replacing it',13,10
                    db '  E, EO    also show the output on the screen',13,10
                    db '  command  program (.CMD) to run, with its own tail',13,10,'$'
msg_create_err      db 'PUT: Unable to create or open output file',13,10,'$'
msg_cli_err         db 'PUT: CLI command execution failed',13,10,'$'

    include putget.dat

end
